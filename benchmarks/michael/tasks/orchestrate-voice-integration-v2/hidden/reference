Event } from \"./protocol.ts\";\n\nexport interface ServerOptions {\n  tokens: ReadonlySet<string>;\n  budgetSeconds: number;\n  telemetry: (event: TelemetryEvent) => void;\n  respond: (transcript: string) => string;\n}\n\ninterface Session {\n  id: string;\n  usedMs: number;\n  transcript: string;\n  pending: string | null;\n  ended: boolean;\n}\n\nexport class RealtimeServer {\n  private readonly options: ServerOptions;\n  private readonly sessions = new Map<string, Session>();\n  private count = 0;\n\n  constructor(options: ServerOptions) {\n    this.options = options;\n  }\n\n  /** Handle one raw client frame for `connection`; replies go to `reply`. */\n  handle(connection: string, raw: string, reply: (raw: string) => void): void {\n    const send = (message: ServerMessage) => reply(encode(message));\n    const message = decodeClient(raw);\n    if (message === null) {\n      send({ type: \"rejected\", reason: \"malformed\" });\n      return;\n    }\n    if (message.type === \"join\") {\n      this.join(connection, message, send);\n      return;\n    }\n    const session = this.sessions.get(connection);\n    if (!session || session.ended) {\n      send({ type: \"rejected\", reason: \"malformed\" });\n      return;\n    }\n    if (message.type === \"audio\") {\n      session.usedMs += message.ms;\n      session.transcript = message.transcript;\n      this.options.telemetry({ name: \"audio\", sessionId: session.id, correlationId: message.correlationId,\n        ms: message.ms });\n      if (session.usedMs > this.options.budgetSeconds * 1000) {\n        session.ended = true;\n        this.sessions.delete(connection);\n        this.options.telemetry({ name: \"budget_exhausted\", sessionId: session.id, ms: session.usedMs });\n        send({ type: \"ended\", reason: \"budget\" });\n      }\n    } else if (message.type === \"ptt\") {\n      if (!message.pressed) {\n        session.pending = message.correlationId;\n        const text = this.options.respond(session.transcript);\n        this.options.telemetry({ name: \"response\", sessionId: session.id, correlationId: message.correlationId });\n        send({ type: \"response\", correlationId: message.correlationId, text });\n      }\n    } else if (message.type === \"cancel\") {\n      this.options.telemetry({ name: \"cancelled\", sessionId: session.id, correlationId: message.correlationId });\n      if (session.pending === message.correlationId) session.pending = null;\n    }\n  }\n\n  private join(connection: string, message: Extract<ClientMessage, { type: \"join\" }>,\n               send: (message: ServerMessage) => void): void {\n    if (message.version !== PROTOCOL_VERSION) {\n      send({ type: \"rejected\", reason: \"version\" });\n      return;\n    }\n    if (typeof message.roomId !== \"string\" || !message.roomId || !this.options.tokens.has(message.token)) {\n      send({ type: \"rejected\", reason: \"auth\" });\n      return;\n    }\n    this.count += 1;\n    const id = `s${this.count}`;\n    this.sessions.set(connection, { id, usedMs: 0, transcript: \"\", pending: null, ended: false });\n    this.options.telemetry({ name: \"joined\", sessionId: id });\n    send({ type: \"joined\", sessionId: id });\n  }\n}\n","src/session.ts":"// Layer 2 (orchestration): push-to-talk client session state machine.\nimport { correlation } from \"./protocol.ts\";\nimport type { ServerMessage } from \"./protocol.ts\";\nimport { joinMessage } from \"./transport.ts\";\nimport type { LoopbackTransport } from \"./transport.ts\";\n\nexport type SessionState = \"idle\" | \"joining\" | \"ready\" | \"listening\" | \"thinking\" | \"speaking\" | \"ended\";\n\nexport class VoiceSession {\n  state: SessionState = \"idle\";\n  sessionId: string | null = null;\n  lastResponse: string | null = null;\n  endReason: string | null = null;\n  private turn = 0;\n  private current: string | null = null;\n  private readonly transport: LoopbackTransport;\n\n  constructor(transport: LoopbackTransport) {\n    this.transport = transport;\n    transport.onMessage((message) => this.onServer(message));\n  }\n\n  start(roomId: string, token: string): void {\n    this.state = \"joining\";\n    this.transport.send(joinMessage(roomId, token));\n  }\n\n  /** Push-to-talk pressed. While the assistant is speaking this is a barge-in. */\n  pressTalk(): void {\n    if (this.state === \"speaking\" && this.current !== null) {\n      this.transport.send({ type: \"cancel\", correlationId: this.current });\n      this.lastResponse = null;\n    } else if (this.state !== \"ready\") {\n      return;\n    }\n    this.turn += 1;\n    this.current = correlation(this.sessionId ?? \"pending\", this.turn);\n    this.state = \"listening\";\n    this.transport.send({ type: \"ptt\", correlationId: this.current, pressed: true });\n  }\n\n  /** Microphone chunk; `seconds` is the chunk duration reported by the capture layer. */\n  audio(seconds: number, transcript: string): void {\n    if (this.state !== \"listening\" || this.current === null) return;\n    this.transport.send({ type: \"audio\", correlationId: this.current, ms: Math.round(seconds * 1000), transcript });\n  }\n\n  releaseTalk(): void {\n    if (this.state !== \"listening\" || this.current === null) return;\n    this.state = \"thinking\";\n    this.transport.send({ type: \"ptt\", correlationId: this.current, pressed: false });\n  }\n\n  finishSpeaking(): void {\n    if (this.state === \"speaking\") this.state = \"ready\";\n  }\n\n  private onServer(message: ServerMessage): void {\n    if (message.type === \"joined\") {\n      this.sessionId = message.sessionId;\n      this.state = \"ready\";\n    } else if (message.type === \"rejected\") {\n      this.state = \"ended\";\n      this.endReason = message.reason;\n    } else if (message.type === \"ended\") {\n      this.state = \"ended\";\n      this.endReason = message.reason;\n    } else if (message.type === \"response\" && message.correlationId === this.current && this.state === \"thinking\") {\n      this.lastResponse = message.text;\n      this.state = \"speaking\";\n    }\n  }\n}\n","src/transport.ts":"// Layer 3 (media transport): in-process loopback link between a client session and the server.\nimport { decodeServer, encode, PROTOCOL_VERSION } from \"./protocol.ts\";\nimport type { ClientMessage, ServerMessage } from \"./protocol.ts\";\nimport type { RealtimeServer } from \"./server.ts\";\n\nexport function joinMessage(roomId: string, token: string): ClientMessage {\n  return { type: \"join\", roomId, token, version: PROTOCOL_VERSION };\n}\n\nexport class LoopbackTransport {\n  private readonly server: RealtimeServer;\n  private readonly connection: string;\n  private listener: (message: ServerMessage) => void = () => {};\n\n  constructor(server: RealtimeServer, connection: string) {\n    this.server = server;\n    this.connection = connection;\n  }\n\n  onMessage(listener: (message: ServerMessage) => void): void {\n    this.listener = listener;\n  }\n\n  send(message: ClientMessage): void {\n    this.server.handle(this.connection, encode(message), (raw) => {\n      const decoded = decodeServer(raw);\n      if (decoded !== null) this.listener(decoded);\n    });\n  }\n}\n"}
