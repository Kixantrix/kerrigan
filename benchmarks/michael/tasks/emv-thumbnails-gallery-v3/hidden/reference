{"api/media-list.mjs":"// GET /api/media?event=&album= : list an album's media for the gallery.\nimport { thumbnailName } from \"./thumbnails.mjs\";\n\nconst IMAGE = /\\.(jpe?g|png|webp|heic)$/i;\nconst VIDEO = /\\.(mp4|mov|webm)$/i;\n\nexport async function getMediaList(store, eventId, albumId) {\n  const prefix = `events/${eventId}/${albumId}/`;\n  const blobs = await store.list(prefix);\n  const items = [];\n  for (const { name, metadata } of blobs) {\n    if (!IMAGE.test(name) && !VIDEO.test(name)) continue;\n    const item = { name: name.slice(prefix.length), url: store.url(name), type: IMAGE.test(name) ? \"image\" : \"video\" };\n    if (item.type === \"image\" && (await store.exists(thumbnailName(name)))) {\n      item.thumbnailUrl = store.url(thumbnailName(name));\n      const width = Number(metadata.width);\n      const height = Number(metadata.height);\n      if (width > 0 && height > 0) Object.assign(item, { width, height });\n    }\n    items.push(item);\n  }\n  return items;\n}\n","api/thumbnails.mjs":"// Thumbnail generation for album images (POST /api/generateThumbnails).\nconst IMAGE = /\\.(jpe?g|png|webp|heic)$/i;\nexport const THUMB_PREFIX = \"thumbnails/\";\nexport const THUMB_WIDTH = 600;\n\n/** Target thumbnail size: oriented dimensions scaled to at most maxWidth, never upscaled. */\nexport function planThumbnail({ width, height, orientation = 1 }, maxWidth = THUMB_WIDTH) {\n  const rotated = orientation >= 5 && orientation <= 8;\n  const w = rotated ? height : width;\n  const h = rotated ? width : height;\n  if (w <= maxWidth) return { width: w, height: h };\n  return { width: maxWidth, height: Math.max(1, Math.round((h * maxWidth) / w)) };\n}\n\nexport function thumbnailName(name) {\n  return `${THUMB_PREFIX}${name.replace(/\\.[^./]+$/, \"\")}.jpg`;\n}\n\n/**\n * For every image in the album, write a JPEG thumbnail and record the original's oriented\n * dimensions in its metadata. `probe(bytes)` -> { width, height, orientation }; `resize(bytes,\n * width, height)` -> JPEG bytes. One failure never stops the album.\n */\nexport async function generateThumbnails(store, { eventId, albumId, force = false }, { probe, resize }) {\n  const prefix = `events/${eventId}/${albumId}/`;\n  const summary = { created: 0, skipped: 0, failed: 0, errors: [] };\n  for (const { name, metadata } of await store.list(prefix)) {\n    if (!IMAGE.test(name)) continue;\n    const target = thumbnailName(name);\n    if (!force && (await store.exists(target))) {\n      summary.skipped += 1;\n      continue;\n    }\n    try {\n      const bytes = await store.get(name);\n      const original = probe(bytes);\n      const size = planThumbnail(original);\n      const rotated = original.orientation >= 5 && original.orientation <= 8;\n      await store.put(target, resize(bytes, size.width, size.height), { width: String(size.width), height: String(size.height) });\n      await store.setMetadata(name, { ...metadata,\n        width: String(rotated ? original.height : original.width),\n        height: String(rotated ? original.width : original.height) });\n      summary.created += 1;\n    } catch (error) {\n      summary.failed += 1;\n      summary.errors.push(`${name.slice(prefix.length)}: ${error instanceof Error ? error.message : String(error)}`);\n    }\n  }\n  return summary;\n}\n","web/gallery-layout.mjs":"// Carousel layout for the gallery page (framework-free; the page renders these descriptors).\nexport function layoutCarousel(items, rowHeight) {\n  return items.map((item) => {\n    const sized = item.width > 0 && item.height > 0;\n    return {\n      name: item.name,\n      type: item.type,\n      src: item.thumbnailUrl ?? item.url,\n      height: rowHeight,\n      width: sized ? Math.round((rowHeight * item.width) / item.height) : rowHeight,\n      presized: sized,\n    };\n  });\n}\n\n/** Full-size source, loaded only when the viewer opens; the page shows a spinner meanwhile. */\nexport function fullscreenSrc(item) {\n  return item.url;\n}\n"}
