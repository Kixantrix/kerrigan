{"evals/relevance/audit.ts":"// Corpus audit: is there subject matter for any ranker to match on?\nimport type { Item } from \"./blind.ts\";\n\nexport interface SourceAudit {\n  items: number;\n  withSummary: number;\n  avgSummaryChars: number;\n  topicsFromTitle: number;\n}\n\nexport interface CorpusAudit {\n  sources: Record<string, SourceAudit>;\n  starvedSources: string[];\n  finding: \"subject-matter-absent\" | \"ranker-ordering\";\n}\n\nconst tokens = (title: string) => new Set(title.toLowerCase().split(/[^a-z]+/).filter(Boolean));\n\nexport function auditCorpus(items: readonly Item[], governmentSources: readonly string[]): CorpusAudit {\n  const grouped = new Map<string, Item[]>();\n  for (const item of items) grouped.set(item.source, [...(grouped.get(item.source) ?? []), item]);\n  const sources: Record<string, SourceAudit> = {};\n  for (const [source, group] of grouped) {\n    const summaries = group.map((item) => (item.summary ?? \"\").trim()).filter((text) => text.length > 0);\n    sources[source] = {\n      items: group.length,\n      withSummary: summaries.length,\n      avgSummaryChars: summaries.length\n        ? Math.round(summaries.reduce((sum, text) => sum + text.length, 0) / summaries.length) : 0,\n      topicsFromTitle: group.filter((item) => {\n        const words = tokens(item.title);\n        return item.topics.length > 0 && item.topics.every((topic) => words.has(topic.toLowerCase()));\n      }).length,\n    };\n  }\n  const starved = governmentSources.filter((source) => {\n    const group = grouped.get(source) ?? [];\n    const substantive = group.filter((item) => (item.summary ?? \"\").trim().length >= 80).length;\n    return substantive * 2 < group.length;\n  }).sort();\n  return {\n    sources,\n    starvedSources: starved,\n    finding: governmentSources.length > 0 && starved.length === governmentSources.length\n      ? \"subject-matter-absent\" : \"ranker-ordering\",\n  };\n}\n","evals/relevance/blind.ts":"// Blind projection for rating: no evaluative field may reach the reader.\nexport const EVALUATIVE_KEYS = [\"score\", \"matched\", \"reasons\", \"rank\", \"matchedNorthStars\", \"arm\"] as const;\n\nexport interface Item {\n  id: string;\n  source: string;\n  title: string;\n  summary?: string;\n  topics: string[];\n  [key: string]: unknown;\n}\n\nexport interface BlindItem {\n  id: string;\n  source: string;\n  title: string;\n  summary: string;\n}\n\nexport function assertNothingEvaluative(value: unknown, path = \"$\"): void {\n  if (Array.isArray(value)) {\n    value.forEach((child, index) => assertNothingEvaluative(child, `${path}[${index}]`));\n    return;\n  }\n  if (value !== null && typeof value === \"object\") {\n    for (const [key, child] of Object.entries(value)) {\n      if ((EVALUATIVE_KEYS as readonly string[]).includes(key)) {\n        throw new Error(`evaluative field ${key} at ${path}`);\n      }\n      assertNothingEvaluative(child, `${path}.${key}`);\n    }\n  }\n}\n\nexport function mulberry32(seed: number): () => number {\n  let a = seed >>> 0;\n  return () => {\n    a = (a + 0x6d2b79f5) >>> 0;\n    let t = a;\n    t = Math.imul(t ^ (t >>> 15), t | 1);\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\nexport function seededShuffle<T>(values: readonly T[], seed: number): T[] {\n  const out = [...values];\n  const next = mulberry32(seed);\n  for (let i = out.length - 1; i > 0; i -= 1) {\n    const j = Math.floor(next() * (i + 1));\n    [out[i], out[j]] = [out[j], out[i]];\n  }\n  return out;\n}\n\nexport function blindItems(items: readonly Item[], seed: number): BlindItem[] {\n  const projected = items.map((item) => ({ id: item.id, source: item.source, title: item.title,\n    summary: item.summary ?? \"\" }));\n  const result = seededShuffle(projected, seed);\n  assertNothingEvaluative(result);\n  return result;\n}\n","evals/relevance/score.ts":"// Scores one ranking arm against blind ratings; can report misses and wrong reasons.\nexport interface Rating {\n  relevance: 0 | 1 | 2;\n  reasonAccepted?: boolean;\n}\n\nexport interface Arm {\n  name: string;\n  ranking: string[];\n}\n\nexport interface ArmScore {\n  precisionAtK: number;\n  ndcgAtK: number;\n  misses: string[];\n  wrongReasons: string[];\n  firedCount: number;\n}\n\nconst round4 = (value: number) => Math.round(value * 10000) / 10000;\n\nfunction dcg(gains: number[]): number {\n  return gains.reduce((sum, gain, index) => sum + gain / Math.log2(index + 2), 0);\n}\n\nexport function scoreArm(arm: Arm, ratings: Record<string, Rating>, k: number): ArmScore {\n  const shown = arm.ranking.slice(0, k);\n  const shownSet = new Set(shown);\n  const relevance = (id: string) => ratings[id]?.relevance ?? 0;\n  const ideal = Object.values(ratings).map((r) => r.relevance).sort((a, b) => b - a).slice(0, k);\n  const idcg = dcg(ideal);\n  return {\n    precisionAtK: round4(shown.filter((id) => relevance(id) >= 1).length / k),\n    ndcgAtK: idcg === 0 ? 0 : round4(dcg(shown.map(relevance)) / idcg),\n    misses: Object.keys(ratings).filter((id) => ratings[id].relevance === 2 && !shownSet.has(id)).sort(),\n    wrongReasons: shown.filter((id) => relevance(id) >= 1 && ratings[id]?.reasonAccepted === false).sort(),\n    firedCount: shown.length,\n  };\n}\n"}
