[
 {
  "original_id": "service healthy after deploy and after recreation",
  "group": "service",
  "probe": {
   "op": "scenario"
  },
  "clauses": [
   [
    "path_equal",
    [
     "health",
     "after_deploy"
    ],
    200
   ],
   [
    "path_equal",
    [
     "health",
     "after_recreate"
    ],
    200
   ]
  ]
 },
 {
