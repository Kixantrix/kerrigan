 {
  "original_id": "image, entrypoint, ports and environment unchanged",
  "group": "preservation",
  "probe": {
   "op": "scenario"
  },
  "clauses": [
   [
    "path_equal",
    [
     "service",
     "image"
    ],
    "local/call-api:1"
   ],
   [
    "path_equal",
    [
     "service",
     "entrypoint"
    ],
    "/app/server.py"
   ],
   [
    "path_equal",
    [
     "service",
     "ports"
    ],
    [
     "3001:3001"
    ]
   ],
   [
    "path_equal",
    [
     "service",
     "environment"
    ],
    {
     "DATA_DIR": "/data",
     "PORT": "3001",
     "ROOM_TTL_HOURS": "72"
    }
   ]
  ]
 },
 {
  "original_id": "API code still mounted from ./api at /app",
