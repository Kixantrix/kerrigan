{"foal-rescue-meadow.html":"<title>Foal Rescue Meadow</title>\n<style>\n  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }\n  body {\n    position: fixed; inset: 0; width: 100%;\n    background: #aee4f7;\n    font-family: ui-rounded, -apple-system, \"SF Pro Rounded\", \"Segoe UI\", system-ui, sans-serif;\n    -webkit-tap-highlight-color: transparent;\n    user-select: none; -webkit-user-select: none;\n    touch-action: none;\n    overscroll-behavior: none;\n  }\n  #game { position: fixed; inset: 0; display: block; }\n\n  #hud {\n    position: fixed; top: env(safe-area-inset-top, 0px); left: 0; right: 0;\n    display: flex; align-items: center; gap: 8px;\n    padding: 10px 12px; z-index: 5; pointer-events: none;\n  }\n  .pill {\n    background: rgba(255, 248, 238, 0.92);\n    border-radius: 999px; padding: 8px 14px;\n    font-weight: 800; color: #5a4632; font-size: 16px;\n    box-shadow: 0 2px 10px rgba(90, 70, 50, 0.18);\n    display: flex; align-items: center; gap: 6px;\n    font-variant-numeric: tabular-nums;\n  }\n  .spacer { flex: 1; }\n  .hbtn {\n    pointer-events: auto;\n    background: rgba(255, 248, 238, 0.94);\n    border: none; border-radius: 999px;\n    min-width: 46px; height: 46px; font-size: 21px;\n    box-shadow: 0 2px 10px rgba(90, 70, 50, 0.2);\n    color: #5a4632;\n  }\n  .hbtn:active { transform: scale(0.94); }\n  #shopBtn { padding: 0 18px; font-weight: 800; font-size: 16px; font-family: inherit; }\n\n  #toast {\n    position: fixed; left: 50%; top: calc(env(safe-area-inset-top, 0px) + 68px);\n    transform: translateX(-50%) translateY(-10px);\n    background: rgba(255, 248, 238, 0.96); color: #5a4632;\n    font-weight: 700; font-size: 15px;\n    padding: 10px 18px; border-radius: 999px;\n    box-shadow: 0 4px 16px rgba(90, 70, 50, 0.22);\n    opacity: 0; transition: opacity 0.25s, transform 0.25s;\n    z-index: 8; max-width: 86%; text-align: center; pointer-events: none;\n  }\n  #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n\n  #backdrop {\n    position: fixed; inset: 0; background: rgba(60, 45, 30, 0.25);\n    opacity: 0; pointer-events: none; transition: opacity 0.25s; z-index: 9;\n  }\n  #backdrop.open { opacity: 1; pointer-events: auto; }\n\n  #sheet {\n    position: fixed; left: 0; right: 0; bottom: 0;\n    background: #fff8ee;\n    border-radius: 24px 24px 0 0;\n    box-shadow: 0 -8px 32px rgba(60, 45, 30, 0.3);\n    transform: translateY(105%); transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);\n    z-index: 10; max-height: 72%;\n    display: flex; flex-direction: column;\n    padding-bottom: env(safe-area-inset-bottom, 8px);\n  }\n  #sheet.open { transform: translateY(0); }\n  .sheetHead {\n    display: flex; justify-content: space-between; align-items: center;\n    padding: 16px 18px 10px; font-size: 19px; font-weight: 800; color: #5a4632;\n  }\n  #closeShop {\n    border: none; background: #f0e6d8; color: #8a7a66;\n    border-radius: 999px; width: 38px; height: 38px; font-size: 16px; font-weight: 700;\n  }\n  #items { overflow-y: auto; padding: 0 12px 10px; touch-action: pan-y; -webkit-overflow-scrolling: touch; }\n  .item {\n    display: flex; align-items: center; gap: 12px;\n    background: #ffffff; border-radius: 18px;\n    padding: 12px 14px; margin-bottom: 9px;\n    box-shadow: 0 1px 5px rgba(90, 70, 50, 0.1);\n  }\n  .item .ic { font-size: 27px; width: 34px; text-align: center; }\n  .item .tx { flex: 1; min-width: 0; }\n  .item .tx b { display: block; color: #5a4632; font-size: 15.5px; }\n  .item .tx span { font-size: 12.5px; color: #9a8a74; }\n  .buy {\n    border: none; border-radius: 999px;\n    background: #ffd45e; color: #6b4e12;\n    font-weight: 800; font-family: inherit;\n    padding: 12px 15px; font-size: 14px; min-width: 82px;\n    font-variant-numeric: tabular-nums;\n  }\n  .buy:active { transform: scale(0.95); }\n  .buy:disabled { background: #ece4d6; color: #b0a591; transform: none; }\n  .buy.owned { background: #c5e8ad; color: #3e6a28; }\n  #stats { padding: 6px 18px 14px; font-size: 13px; color: #9a8a74; text-align: center; font-weight: 600; }\n</style>\n\n<canvas id=\"game\"></canvas>\n\n<div id=\"hud\">\n  <div class=\"pill\">\ud83e\ude99 <span id=\"coinsEl\">0</span></div>\n  <div class=\"pill\">\ud83d\udc34 <span id=\"herdEl\">0/4</span></div>\n  <div class=\"spacer\"></div>\n  <button class=\"hbtn\" id=\"sndBtn\">\ud83d\udd0a</button>\n  <button class=\"hbtn\" id=\"shopBtn\">\ud83c\udf80 Shop</button>\n</div>\n\n<div id=\"toast\"></div>\n<div id=\"backdrop\"></div>\n<div id=\"sheet\">\n  <div class=\"sheetHead\"><span>\ud83c\udf80 Ranch Shop</span><button id=\"closeShop\">\u2715</button></div>\n  <div id=\"items\"></div>\n  <div id=\"stats\"></div>\n</div>\n\n<script>\n'use strict';\n// ============================================================ helpers\nconst $ = id => document.getElementById(id);\nconst rand = (a, b) => a + Math.random() * (b - a);\nconst clamp = (v, a, b) => Math.max(a, Math.min(b, v));\nconst TAU = Math.PI * 2;\n\nfunction shade(hex, amt) { // lighten (+) / darken (-) a #rrggbb color\n  const n = parseInt(hex.slice(1), 16);\n  const r = clamp((n >> 16) + amt, 0, 255), g = clamp(((n >> 8) & 255) + amt, 0, 255), b = clamp((n & 255) + amt, 0, 255);\n  return `rgb(${r},${g},${b})`;\n}\n\n// ============================================================ constants\nconst GROW_MS = 3 * 60 * 1000;          // foal -> horse\nconst SAVE_KEY = 'foal-rescue-meadow-v1';\n\nconst COATS = [\n  { body: '#b5773f', mane: '#6d4423' }, // chestnut\n  { body: '#8a5a33', mane: '#3f2a17' }, // bay\n  { body: '#e2b25f', mane: '#f6e7c1' }, // palomino\n  { body: '#b9bcc9', mane: '#8a8da0' }, // grey\n  { body: '#565661', mane: '#33333c' }, // black\n  { body: '#e8d3ab', mane: '#c9a86b' }, // cream\n  { body: '#c98f80', mane: '#8f5a4e' }, // strawberry roan\n  { body: '#f3efe7', mane: '#d8cfc0' }, // snow white\n];\n\nconst NAMES = ['Buttercup','Clover','Daisy','Willow','Maple','Star','Biscuit','Pepper','Honey','Blossom',\n  'Juniper','Rosie','Cocoa','Misty','Sunny','Poppy','Hazel','Ginger','Luna','Marigold',\n  'Pippin','Toffee','Nutmeg','Snowdrop','Bramble','Fern','Dandelion','Sprout','Pebble','Cricket',\n  'Tulip','Sky','Acorn','Berry','Doodle','Waffles','Mochi','Peanut','Cupcake','Petal'];\n\nconst SHOP = [\n  { id: 'cap',     ic: '\ud83c\udf3f', name: 'Bigger Meadow', desc: 'Room for 2 more horses',  max: 8, cost: l => Math.round(25 * Math.pow(2.1, l)) },\n  { id: 'breeze',  ic: '\ud83c\udf43', name: 'Gentle Breeze', desc: 'Bubbles float in faster', max: 6, cost: l => Math.round(40 * Math.pow(2.2, l)) },\n  { id: 'lucky',   ic: '\ud83c\udf40', name: 'Lucky Skies',   desc: 'Rarer, richer bubbles',   max: 5, cost: l => Math.round(60 * Math.pow(2.3, l)) },\n  { id: 'flowers', ic: '\ud83c\udf3c', name: 'Wildflowers',   desc: 'Blooms across the meadow', decor: true, cost: () => 50 },\n  { id: 'pond',    ic: '\ud83e\udeb7', name: 'Lily Pond',     desc: 'A cool drink for the herd', decor: true, cost: () => 150 },\n  { id: 'barn',    ic: '\ud83c\udfe1', name: 'Cozy Barn',     desc: 'Shelter for stormy nights', decor: true, cost: () => 350 },\n  { id: 'rainbow', ic: '\ud83c\udf08', name: 'Rainbow',       desc: 'Every meadow needs one',    decor: true, cost: () => 700 },\n];\n\nfunction titleFor(n) {\n  if (n >= 150) return 'Meadow Legend';\n  if (n >= 100) return 'Stable Star';\n  if (n >= 60)  return 'Herd Hero';\n  if (n >= 30)  return 'Pony Pal';\n  if (n >= 10)  return 'Foal Friend';\n  return 'New Rancher';\n}\n\n// ============================================================ state\nlet S = null;\nlet herdId = 1;\n\nfunction freshState() {\n  return {\n    coins: 0, rescued: 0, born: 0, muted: false, seenHint: false,\n    up: { cap: 0, breeze: 0, lucky: 0 },\n    decor: { flowers: false, pond: false, barn: false, rainbow: false },\n    herd: [], lastSeen: Date.now(),\n  };\n}\nconst capOf = () => 4 + S.up.cap * 2;\nconst adults = () => S.herd.filter(h => h.stage === 'adult');\n\nfunction pickName() {\n  const used = new Set(S.herd.map(h => h.name));\n  const free = NAMES.filter(n => !used.has(n));\n  return free.length ? free[Math.floor(Math.random() * free.length)]\n                     : NAMES[Math.floor(Math.random() * NAMES.length)] + ' Jr';\n}\n\nfunction makeHorse(stage, xf, yf) {\n  return {\n    id: herdId++, name: pickName(), coat: Math.floor(Math.random() * COATS.length),\n    stage, bornAt: Date.now(),\n    xf: xf !== undefined ? xf : rand(0.1, 0.9),\n    yf: yf !== undefined ? yf : rand(0.1, 0.9),\n    dir: Math.random() < 0.5 ? 1 : -1,\n    mode: 'idle', modeT: rand(0.5, 2), targetXf: 0, targetYf: 0,\n    phase: rand(0, TAU), petUntil: 0, petCd: 0,\n    nextCoinAt: Date.now() + rand(25000, 45000),\n  };\n}\n\nfunction save() {\n  S.lastSeen = Date.now();\n  try { localStorage.setItem(SAVE_KEY, JSON.stringify(S)); } catch (e) {}\n}\n\nfunction load() {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (raw) {\n      const d = JSON.parse(raw);\n      S = Object.assign(freshState(), d);\n      S.up = Object.assign({ cap: 0, breeze: 0, lucky: 0 }, d.up);\n      S.decor = Object.assign({ flowers: false, pond: false, barn: false, rainbow: false }, d.decor);\n      S.herd.forEach(h => {\n        herdId = Math.max(herdId, h.id + 1);\n        h.mode = 'idle'; h.modeT = rand(0.5, 2); h.phase = rand(0, TAU);\n        h.petUntil = 0; h.petCd = 0;\n        if (!h.nextCoinAt) h.nextCoinAt = Date.now() + rand(25000, 45000);\n      });\n      return true;\n    }\n  } catch (e) {}\n  S = freshState();\n  const mama = makeHorse('adult', 0.5, 0.55);\n  S.herd.push(mama);\n  return false;\n}\n\n// ============================================================ sound\nlet AC = null;\nfunction unlockAudio() {\n  if (!AC) { try { AC = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {} }\n  if (AC && AC.state === 'suspended') AC.resume();\n}\nfunction tone(f0, f1, dur, type, vol, delay) {\n  if (!AC || S.muted) return;\n  const t = AC.currentTime + (delay || 0);\n  const o = AC.createOscillator(), g = AC.createGain();\n  o.type = type;\n  o.frequency.setValueAtTime(f0, t);\n  o.frequency.exponentialRampToValueAtTime(Math.max(40, f1), t + dur);\n  g.gain.setValueAtTime(vol, t);\n  g.gain.exponentialRampToValueAtTime(0.001, t + dur);\n  o.connect(g).connect(AC.destination);\n  o.start(t); o.stop(t + dur + 0.02);\n}\nconst sPop    = () => tone(520 + Math.random() * 160, 980, 0.09, 'triangle', 0.12);\nconst sCoin   = () => { tone(880, 880, 0.06, 'sine', 0.08); tone(1318, 1318, 0.1, 'sine', 0.08, 0.06); };\nconst sRescue = () => [523, 659, 784].forEach((f, i) => tone(f, f, 0.14, 'sine', 0.09, i * 0.09));\nconst sGrow   = () => [392, 494, 587].forEach((f, i) => tone(f, f, 0.16, 'sine', 0.09, i * 0.1));\nconst sBirth  = () => [523, 659, 784, 1047].forEach((f, i) => tone(f, f, 0.15, 'sine', 0.09, i * 0.09));\nconst sBuy    = () => tone(600, 950, 0.13, 'sine', 0.1);\nconst sPet    = () => tone(700 + Math.random() * 200, 1100, 0.08, 'sine', 0.07);\n\n// ============================================================ canvas setup\nconst cv = $('game'), ctx = cv.getContext('2d');\nlet W = 0, H = 0, MT = 0; // MT = meadow top\n\nfunction resize() {\n  W = window.innerWidth; H = window.innerHeight;\n  const dpr = Math.min(window.devicePixelRatio || 1, 2);\n  cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);\n  cv.style.width = W + 'px'; cv.style.height = H + 'px';\n  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  MT = Math.round(H * 0.55);\n}\nwindow.addEventListener('resize', resize);\nresize();\n\nconst horseXY = h => [h.xf * W, MT + 34 + h.yf * (H - MT - 78)];\nconst horseScale = h => (0.72 + 0.4 * h.yf) * (h.stage === 'foal' ? 0.62 : 1);\n\n// ============================================================ entities\nlet bubbles = [], fallers = [], parts = [], floaters = [];\nlet spawnT = 1.2, growCheckT = 0, nextBirthAt = Date.now() + 60000, comboN = 0, lastPop = 0;\n\nconst spawnInterval = () => Math.max(0.72, 1.5 * Math.pow(0.88, S.up.breeze));\n\nfunction pickKind() {\n  const L = S.up.lucky;\n  const w = [\n    ['foal',   S.herd.length + fallers.length < capOf() ? 3 : 0],\n    ['coin',   5],\n    ['clover', 1.2 + 0.5 * L],\n    ['star',   0.35 + 0.18 * L],\n  ];\n  let tot = w.reduce((s, x) => s + x[1], 0), r = Math.random() * tot;\n  for (const [k, v] of w) { if ((r -= v) <= 0) return k; }\n  return 'coin';\n}\n\nfunction spawnBubble() {\n  const kind = pickKind();\n  bubbles.push({\n    x: rand(30, W - 30), y: MT + rand(0, 30),\n    r: kind === 'foal' ? rand(30, 36) : rand(22, 28),\n    vy: rand(26, 42), wob: rand(14, 26), ph: rand(0, TAU),\n    kind, coat: Math.floor(Math.random() * COATS.length),\n  });\n}\n\nfunction burst(x, y, r, col) {\n  parts.push({ t: 'ring', x, y, r, age: 0, life: 0.35 });\n  for (let i = 0; i < 7; i++) {\n    const a = rand(0, TAU);\n    parts.push({ t: 'drop', x, y, vx: Math.cos(a) * rand(60, 160), vy: Math.sin(a) * rand(60, 160) - 40,\n                 age: 0, life: rand(0.35, 0.6), col: col || 'rgba(190,230,250,0.9)' });\n  }\n}\nfunction hearts(x, y, n) {\n  for (let i = 0; i < n; i++)\n    parts.push({ t: 'heart', x: x + rand(-14, 14), y: y + rand(-8, 4), vx: rand(-15, 15), vy: rand(-70, -40),\n                 age: 0, life: rand(0.8, 1.3), s: rand(8, 13) });\n}\nfunction sparkle(x, y, n) {\n  for (let i = 0; i < n; i++)\n    parts.push({ t: 'spark', x: x + rand(-16, 16), y: y + rand(-16, 16), vx: rand(-25, 25), vy: rand(-60, -15),\n                 age: 0, life: rand(0.4, 0.8), s: rand(3, 6) });\n}\nfunction floater(x, y, text, col) {\n  floaters.push({ x, y, text, col: col || '#5a4632', age: 0, life: 1.1 });\n}\n\nfunction gainCoins(n, x, y) {\n  S.coins += n;\n  if (x !== undefined) floater(x, y, '+' + n + ' \ud83e\ude99', '#8a6a12');\n  hud();\n}\n\n// ============================================================ toasts\nconst toastEl = $('toast');\nlet toastQ = [], toastBusy = false;\nfunction toast(msg) {\n  toastQ.push(msg);\n  if (!toastBusy) nextToast();\n}\nfunction nextToast() {\n  if (!toastQ.length) { toastBusy = false; return; }\n  toastBusy = true;\n  toastEl.textContent = toastQ.shift();\n  toastEl.classList.add('show');\n  setTimeout(() => {\n    toastEl.classList.remove('show');\n    setTimeout(nextToast, 350);\n  }, 2400);\n}\n\n// ============================================================ game events\nfunction rescueFoal(b) {\n  const h = makeHorse('foal', clamp(b.x / W, 0.08, 0.92), rand(0.15, 0.85));\n  h.coat = b.coat;\n  const [, ty] = horseXY(h);\n  fallers.push({ x: b.x, y: b.y, vy: 30, targetY: ty, horse: h });\n  S.rescued++;\n  gainCoins(3, b.x, b.y - 10);\n  sRescue();\n}\n\nfunction landFaller(f) {\n  const h = f.horse;\n  h.xf = clamp(f.x / W, 0.06, 0.94);\n  S.herd.push(h);\n  sparkle(f.x, f.targetY - 20, 8);\n  toast('\ud83d\udc96 ' + h.name + ' rescued!');\n  if (S.rescued === 1) toast('Foals grow up in a few minutes \ud83c\udf31');\n  hud();\n}\n\nfunction popBubble(b) {\n  b.dead = true;\n  burst(b.x, b.y, b.r);\n  sPop();\n  const t = Date.now();\n  comboN = (t - lastPop < 1300) ? comboN + 1 : 1;\n  lastPop = t;\n  if (b.kind === 'coin')   { gainCoins(2 + (S.up.lucky > 2 ? 1 : 0), b.x, b.y); sCoin(); }\n  if (b.kind === 'clover') { gainCoins(6, b.x, b.y); sCoin(); }\n  if (b.kind === 'star')   { gainCoins(25, b.x, b.y); sparkle(b.x, b.y, 12); sCoin(); }\n  if (b.kind === 'foal')   rescueFoal(b);\n  if (comboN >= 3) {\n    gainCoins(comboN);\n    floater(b.x, b.y - 34, 'Combo x' + comboN + '! +' + comboN, '#c05a8a');\n    sparkle(b.x, b.y, 5);\n  }\n}\n\nfunction doBirth() {\n  const ad = adults();\n  const a = ad[Math.floor(Math.random() * ad.length)];\n  const h = makeHorse('foal', clamp(a.xf + rand(-0.08, 0.08), 0.08, 0.92), clamp(a.yf + rand(-0.1, 0.1), 0.05, 0.95));\n  S.herd.push(h);\n  S.born++;\n  const [px, py] = horseXY(h);\n  hearts(px, py - 40, 8);\n  sparkle(px, py - 20, 8);\n  toast('\ud83c\udf89 A foal was born \u2014 welcome, ' + h.name + '!');\n  sBirth();\n  hud();\n}\n\nfunction petHorse(h, px, py) {\n  const t = Date.now();\n  h.petUntil = t + 2000;\n  hearts(px, py - 40 * horseScale(h), 4);\n  sPet();\n  if (t > h.petCd) { h.petCd = t + 3000; gainCoins(1, px, py - 60 * horseScale(h)); }\n}\n\n// ============================================================ offline progress\nfunction processOffline() {\n  const t = Date.now(), gone = t - (S.lastSeen || t);\n  if (gone < 60000) return;\n  let grew = 0, births = 0, coins = 0;\n  S.herd.forEach(h => {\n    if (h.stage === 'foal' && t >= h.bornAt + GROW_MS) { h.stage = 'adult'; grew++; }\n  });\n  const tries = Math.min(Math.floor(gone / 120000), 3);\n  for (let i = 0; i < tries; i++) {\n    if (adults().length >= 2 && S.herd.length < capOf() && Math.random() < 0.75) {\n      const a = adults()[0];\n      const h = makeHorse('foal', clamp(a.xf + rand(-0.1, 0.1), 0.08, 0.92), rand(0.1, 0.9));\n      h.bornAt = t - rand(0, Math.min(gone * 0.5, GROW_MS * 0.8)); // still a foal when you return\n      S.herd.push(h); S.born++; births++;\n    }\n  }\n  coins = Math.min(adults().length * Math.floor(gone / 35000), 120);\n  S.coins += coins;\n  const bits = [];\n  if (grew)   bits.push(grew + (grew > 1 ? ' foals grew up' : ' foal grew up'));\n  if (births) bits.push(births + (births > 1 ? ' foals were born' : ' foal was born'));\n  if (coins)  bits.push('the herd earned ' + coins + ' \ud83e\ude99');\n  if (bits.length) toast('While you were away, ' + bits.join(', ') + '!');\n  nextBirthAt = t + rand(60000, 120000);\n  hud();\n}\n\n// ============================================================ update\nfunction update(dt) {\n  const t = Date.now();\n\n  // bubbles\n  spawnT -= dt;\n  if (spawnT <= 0 && bubbles.length < 14) { spawnBubble(); spawnT = spawnInterval() * rand(0.7, 1.3); }\n  bubbles.forEach(b => { b.y -= b.vy * dt; b.ph += dt * 1.6; });\n  bubbles = bubbles.filter(b => !b.dead && b.y > -b.r - 10);\n\n  // falling rescued foals\n  fallers.forEach(f => {\n    f.vy = Math.min(f.vy + 60 * dt, 90);\n    f.y += f.vy * dt;\n    if (f.y >= f.targetY) { f.done = true; landFaller(f); }\n  });\n  fallers = fallers.filter(f => !f.done);\n\n  // horses wander\n  S.herd.forEach(h => {\n    h.modeT -= dt;\n    if (h.mode === 'walk') {\n      const sp = (h.stage === 'foal' ? 0.045 : 0.032);\n      const dx = h.targetXf - h.xf, dy = h.targetYf - h.yf;\n      const d = Math.hypot(dx, dy);\n      if (d < 0.015) { h.mode = Math.random() < 0.5 ? 'graze' : 'idle'; h.modeT = rand(1.5, 4.5); }\n      else {\n        h.xf += (dx / d) * sp * dt; h.yf += (dy / d) * sp * dt;\n        h.dir = dx >= 0 ? 1 : -1;\n        h.phase += dt * 7;\n      }\n    } else if (h.modeT <= 0) {\n      if (Math.random() < 0.7) {\n        h.mode = 'walk';\n        h.targetXf = clamp(h.xf + rand(-0.3, 0.3), 0.06, 0.94);\n        h.targetYf = clamp(h.yf + rand(-0.35, 0.35), 0.05, 0.95);\n      } else { h.mode = Math.random() < 0.5 ? 'graze' : 'idle'; h.modeT = rand(1.5, 4); }\n    }\n    if (h.mode === 'graze') h.phase += dt * 2;\n\n    // idle income from grown horses\n    if (h.stage === 'adult' && t >= h.nextCoinAt) {\n      h.nextCoinAt = t + rand(25000, 45000);\n      const [px, py] = horseXY(h);\n      gainCoins(1, px, py - 62 * horseScale(h));\n      sparkle(px, py - 40 * horseScale(h), 3);\n    }\n  });\n\n  // growth\n  growCheckT -= dt;\n  if (growCheckT <= 0) {\n    growCheckT = 1;\n    S.herd.forEach(h => {\n      if (h.stage === 'foal' && t >= h.bornAt + GROW_MS) {\n        h.stage = 'adult';\n        const [px, py] = horseXY(h);\n        sparkle(px, py - 30, 10);\n        toast('\ud83c\udf31 ' + h.name + ' grew into a horse!');\n        sGrow();\n        if (adults().length === 2 && S.born === 0) toast('Two grown horses may have a baby \ud83d\udc95');\n      }\n    });\n  }\n\n  // births\n  if (t >= nextBirthAt) {\n    if (adults().length >= 2 && S.herd.length < capOf()) doBirth();\n    nextBirthAt = t + rand(90000, 150000);\n  }\n\n  // particles & floaters\n  parts.forEach(p => {\n    p.age += dt;\n    if (p.t === 'drop' || p.t === 'heart' || p.t === 'spark') {\n      p.x += p.vx * dt; p.y += p.vy * dt;\n      if (p.t === 'drop') p.vy += 300 * dt;\n    }\n  });\n  parts = parts.filter(p => p.age < p.life);\n  floaters.forEach(f => { f.age += dt; f.y -= 34 * dt; });\n  floaters = floaters.filter(f => f.age < f.life);\n}\n\n// ============================================================ drawing: horse\nfunction drawHorse(c, x, y, k, ci, dir, phase, amp, graze, isFoal) {\n  const co = COATS[ci];\n  const dark = shade(co.body, -22), near = shade(co.body, -6);\n  c.save();\n  c.translate(x, y);\n  c.scale(dir * k, k);\n\n  // shadow\n  c.fillStyle = 'rgba(50,90,35,0.22)';\n  c.beginPath(); c.ellipse(0, 1.5, isFoal ? 20 : 24, 4.5, 0, 0, TAU); c.fill();\n\n  const bob = Math.sin(phase * 2) * 0.8 * (amp > 0 ? 1 : 0.3);\n  const bodyY = -27 + bob;\n  const legW = isFoal ? 3.6 : 4.8;\n  const rx = isFoal ? 16.5 : 21, ry = isFoal ? 10.5 : 13.5;\n\n  // legs (far pair darker, near pair)\n  const legs = [\n    { x: -14, ph: 0,           col: dark },\n    { x: 12,  ph: Math.PI,     col: dark },\n    { x: -10, ph: Math.PI,     col: near },\n    { x: 15,  ph: 0,           col: near },\n  ];\n  c.lineCap = 'round';\n  legs.forEach(L => {\n    const swing = Math.sin(phase + L.ph) * amp;\n    c.strokeStyle = L.col; c.lineWidth = legW;\n    c.beginPath(); c.moveTo(L.x, bodyY + 5); c.lineTo(L.x + swing, -2); c.stroke();\n    c.fillStyle = shade(co.mane, -12);\n    c.beginPath(); c.arc(L.x + swing, -1.5, legW * 0.62, 0, TAU); c.fill();\n  });\n\n  // tail\n  c.strokeStyle = co.mane; c.lineWidth = 6;\n  c.beginPath(); c.moveTo(-rx + 1, bodyY - 5);\n  c.quadraticCurveTo(-rx - 9, bodyY + 5, -rx - 6, -9); c.stroke();\n  c.lineWidth = 3.5;\n  c.beginPath(); c.moveTo(-rx + 1, bodyY - 4);\n  c.quadraticCurveTo(-rx - 12, bodyY + 8, -rx - 10, -11); c.stroke();\n\n  // body\n  c.fillStyle = co.body;\n  c.beginPath(); c.ellipse(0, bodyY, rx, ry, 0, 0, TAU); c.fill();\n\n  // neck + head (graze lowers the head)\n  const headX = 22 + graze * 4 - (isFoal ? 2 : 0);\n  const headY = bodyY - 19 + graze * (0 - bodyY - 15) + Math.sin(phase) * graze * 1.5;\n  const nsx = 11, nsy = bodyY - 6;\n  c.strokeStyle = co.body; c.lineWidth = isFoal ? 8.5 : 11;\n  c.beginPath(); c.moveTo(nsx, nsy); c.lineTo(headX - 2, headY + 2); c.stroke();\n\n  // mane along neck\n  c.fillStyle = co.mane;\n  for (const tt of [0.3, 0.58, 0.86]) {\n    const mx = nsx + (headX - 2 - nsx) * tt - 2.5;\n    const my = nsy + (headY + 2 - nsy) * tt - 4;\n    c.beginPath(); c.arc(mx, my, 4.4 - tt, 0, TAU); c.fill();\n  }\n\n  // head\n  const hr = isFoal ? 8.8 : 8.4;\n  c.fillStyle = co.body;\n  c.beginPath(); c.ellipse(headX + 2, headY, hr, hr * 0.85, 0, 0, TAU); c.fill();\n  // muzzle\n  c.fillStyle = shade(co.body, 34);\n  c.beginPath(); c.arc(headX + 8.6, headY + 2.6, 4.5, 0, TAU); c.fill();\n  c.fillStyle = shade(co.body, -40);\n  c.beginPath(); c.arc(headX + 10.2, headY + 2.2, 0.8, 0, TAU); c.fill();\n  // ear\n  c.fillStyle = co.body;\n  c.beginPath();\n  c.moveTo(headX - 2.5, headY - 5.5); c.lineTo(headX + 0.5, headY - 13.5); c.lineTo(headX + 4, headY - 5);\n  c.closePath(); c.fill();\n  // forelock\n  c.fillStyle = co.mane;\n  c.beginPath(); c.arc(headX - 1.5, headY - 6.5, 3.4, 0, TAU); c.fill();\n  // eye\n  const er = isFoal ? 2.1 : 1.7;\n  c.fillStyle = '#2a2118';\n  c.beginPath(); c.arc(headX + 3.6, headY - 1.4, er, 0, TAU); c.fill();\n  c.fillStyle = '#fff';\n  c.beginPath(); c.arc(headX + 3, headY - 2, er * 0.38, 0, TAU); c.fill();\n  // foal blush\n  if (isFoal) {\n    c.fillStyle = 'rgba(240,140,160,0.45)';\n    c.beginPath(); c.arc(headX + 0.5, headY + 3.2, 2.1, 0, TAU); c.fill();\n  }\n  c.restore();\n}\n\n// ============================================================ drawing: world\nconst clouds = [];\nfor (let i = 0; i < 4; i++) clouds.push({ xf: Math.random(), yf: 0.08 + Math.random() * 0.3, s: rand(0.7, 1.3), v: rand(3, 7) });\n\nconst flowerSpots = [];\nfor (let i = 0; i < 16; i++) {\n  // deterministic pseudo-random spots\n  const a = Math.sin(i * 127.1) * 43758.5453, b = Math.sin(i * 311.7) * 12543.85;\n  flowerSpots.push({ xf: a - Math.floor(a), yf: b - Math.floor(b), hue: i % 3 });\n}\n\nfunction drawWorld(t) {\n  // sky\n  let g = ctx.createLinearGradient(0, 0, 0, MT);\n  g.addColorStop(0, '#9fdcf5'); g.addColorStop(1, '#eaf8fe');\n  ctx.fillStyle = g; ctx.fillRect(0, 0, W, MT + 2);\n\n  // sun\n  ctx.fillStyle = 'rgba(255,236,160,0.9)';\n  ctx.beginPath(); ctx.arc(W - 58, 84, 26, 0, TAU); ctx.fill();\n  ctx.fillStyle = 'rgba(255,236,160,0.3)';\n  ctx.beginPath(); ctx.arc(W - 58, 84, 40, 0, TAU); ctx.fill();\n\n  // rainbow decor\n  if (S.decor.rainbow) {\n    const cx = W * 0.72, cy = MT + 20;\n    const cols = ['rgba(240,110,110,.5)','rgba(245,180,90,.5)','rgba(245,230,120,.5)','rgba(140,210,130,.5)','rgba(120,170,235,.5)','rgba(180,140,225,.5)'];\n    cols.forEach((col, i) => {\n      ctx.strokeStyle = col; ctx.lineWidth = 7;\n      ctx.beginPath(); ctx.arc(cx, cy, W * 0.34 - i * 7, Math.PI, TAU); ctx.stroke();\n    });\n  }\n\n  // clouds\n  ctx.fillStyle = 'rgba(255,255,255,0.85)';\n  clouds.forEach(cl => {\n    cl.xf += (cl.v / W) * 0.016;\n    if (cl.xf > 1.15) cl.xf = -0.15;\n    const cx = cl.xf * W, cy = cl.yf * MT, s = cl.s;\n    ctx.beginPath();\n    ctx.arc(cx, cy, 16 * s, 0, TAU);\n    ctx.arc(cx + 18 * s, cy + 4 * s, 13 * s, 0, TAU);\n    ctx.arc(cx - 18 * s, cy + 5 * s, 12 * s, 0, TAU);\n    ctx.arc(cx + 2 * s, cy + 8 * s, 14 * s, 0, TAU);\n    ctx.fill();\n  });\n\n  // hills at horizon\n  ctx.fillStyle = '#a8d888';\n  ctx.beginPath(); ctx.ellipse(W * 0.22, MT + 14, W * 0.42, 42, 0, Math.PI, TAU); ctx.fill();\n  ctx.fillStyle = '#98cf76';\n  ctx.beginPath(); ctx.ellipse(W * 0.78, MT + 16, W * 0.46, 34, 0, Math.PI, TAU); ctx.fill();\n\n  // meadow\n  g = ctx.createLinearGradient(0, MT, 0, H);\n  g.addColorStop(0, '#8fce6a'); g.addColorStop(1, '#5fae44');\n  ctx.fillStyle = g; ctx.fillRect(0, MT, W, H - MT);\n\n  // barn decor (background)\n  if (S.decor.barn) {\n    const bx = W - 74, by = MT + 26, s = 1;\n    ctx.fillStyle = '#c05a4a';\n    ctx.fillRect(bx - 30 * s, by - 26 * s, 60 * s, 34 * s);\n    ctx.fillStyle = '#8a4234';\n    ctx.beginPath(); ctx.moveTo(bx - 36 * s, by - 26 * s); ctx.lineTo(bx, by - 48 * s); ctx.lineTo(bx + 36 * s, by - 26 * s); ctx.closePath(); ctx.fill();\n    ctx.fillStyle = '#6d4423';\n    ctx.fillRect(bx - 9 * s, by - 12 * s, 18 * s, 20 * s);\n    ctx.strokeStyle = '#f3e6cf'; ctx.lineWidth = 2;\n    ctx.strokeRect(bx - 9 * s, by - 12 * s, 18 * s, 20 * s);\n  }\n\n  // pond decor (background)\n  if (S.decor.pond) {\n    const px = W * 0.2, py = MT + 46;\n    ctx.fillStyle = '#7ec4d8';\n    ctx.beginPath(); ctx.ellipse(px, py, 62, 19, 0, 0, TAU); ctx.fill();\n    ctx.fillStyle = 'rgba(255,255,255,0.35)';\n    ctx.beginPath(); ctx.ellipse(px - 14, py - 4, 26, 6, 0, 0, TAU); ctx.fill();\n    ctx.fillStyle = '#4e9a5f';\n    ctx.beginPath(); ctx.ellipse(px + 26, py + 2, 9, 5, 0.3, 0, TAU); ctx.fill();\n    ctx.fillStyle = '#f0a8c8';\n    ctx.beginPath(); ctx.arc(px + 26, py, 3, 0, TAU); ctx.fill();\n  }\n\n  // grass tufts\n  ctx.strokeStyle = 'rgba(60,130,45,0.5)'; ctx.lineWidth = 1.6; ctx.lineCap = 'round';\n  for (let i = 0; i < 22; i++) {\n    const a = Math.sin(i * 91.3) * 4721.7, b = Math.sin(i * 53.7) * 8231.3;\n    const gx = (a - Math.floor(a)) * W, gy = MT + 20 + (b - Math.floor(b)) * (H - MT - 40);\n    ctx.beginPath(); ctx.moveTo(gx, gy); ctx.lineTo(gx - 2.5, gy - 6); ctx.stroke();\n    ctx.beginPath(); ctx.moveTo(gx, gy); ctx.lineTo(gx + 2.5, gy - 6.5); ctx.stroke();\n  }\n\n  // wildflowers decor\n  if (S.decor.flowers) {\n    const cols = ['#f5d76e', '#f0a8c8', '#e8ecf5'];\n    flowerSpots.forEach(f => {\n      const fx = 14 + f.xf * (W - 28), fy = MT + 24 + f.yf * (H - MT - 52);\n      ctx.fillStyle = cols[f.hue];\n      for (let p = 0; p < 5; p++) {\n        const a = (p / 5) * TAU + f.xf * 6;\n        ctx.beginPath(); ctx.arc(fx + Math.cos(a) * 3.2, fy + Math.sin(a) * 3.2, 2.4, 0, TAU); ctx.fill();\n      }\n      ctx.fillStyle = '#e8952e';\n      ctx.beginPath(); ctx.arc(fx, fy, 2, 0, TAU); ctx.fill();\n    });\n  }\n}\n\nfunction drawBubble(b) {\n  const { x, y, r } = b;\n  const wx = x + Math.sin(b.ph) * b.wob * 0.25;\n  ctx.save();\n  ctx.translate(wx, y);\n  // bubble sphere\n  const g = ctx.createRadialGradient(-r * 0.3, -r * 0.35, r * 0.15, 0, 0, r);\n  g.addColorStop(0, 'rgba(255,255,255,0.55)');\n  g.addColorStop(0.7, 'rgba(200,235,250,0.28)');\n  g.addColorStop(1, 'rgba(160,215,245,0.5)');\n  ctx.fillStyle = g;\n  ctx.beginPath(); ctx.arc(0, 0, r, 0, TAU); ctx.fill();\n  ctx.strokeStyle = 'rgba(255,255,255,0.75)'; ctx.lineWidth = 1.6;\n  ctx.beginPath(); ctx.arc(0, 0, r - 0.8, 0, TAU); ctx.stroke();\n  // highlight\n  ctx.strokeStyle = 'rgba(255,255,255,0.9)'; ctx.lineWidth = 2.4; ctx.lineCap = 'round';\n  ctx.beginPath(); ctx.arc(0, 0, r * 0.68, -2.4, -1.5); ctx.stroke();\n  // contents\n  if (b.kind === 'foal') {\n    drawHorse(ctx, 0, r * 0.5, r / 58, b.coat, 1, b.ph * 2, 1.5, 0, true);\n  } else {\n    const icon = b.kind === 'coin' ? '\ud83e\ude99' : b.kind === 'clover' ? '\ud83c\udf40' : '\u2b50';\n    ctx.font = Math.round(r * 0.95) + 'px sans-serif';\n    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';\n    ctx.fillText(icon, 0, 2);\n  }\n  ctx.restore();\n  b.drawX = wx; // remember for hit test\n}\n\nfunction drawParticles() {\n  parts.forEach(p => {\n    const f = 1 - p.age / p.life;\n    if (p.t === 'ring') {\n      ctx.strokeStyle = 'rgba(255,255,255,' + (0.8 * f) + ')';\n      ctx.lineWidth = 2.5;\n      ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (1 + (1 - f) * 1.1), 0, TAU); ctx.stroke();\n    } else if (p.t === 'drop') {\n      ctx.fillStyle = p.col;\n      ctx.globalAlpha = f;\n      ctx.beginPath(); ctx.arc(p.x, p.y, 2.6, 0, TAU); ctx.fill();\n      ctx.globalAlpha = 1;\n    } else if (p.t === 'heart') {\n      ctx.globalAlpha = f;\n      ctx.font = p.s + 'px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';\n      ctx.fillText('\ud83d\udc97', p.x, p.y);\n      ctx.globalAlpha = 1;\n    } else if (p.t === 'spark') {\n      ctx.fillStyle = 'rgba(255,235,140,' + f + ')';\n      ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.age * 5);\n      ctx.fillRect(-p.s / 2, -1, p.s, 2); ctx.fillRect(-1, -p.s / 2, 2, p.s);\n      ctx.restore();\n    }\n  });\n}\n\nfunction draw(t) {\n  drawWorld(t);\n  bubbles.forEach(drawBubble);\n\n  // rescued foals gently floating down\n  fallers.forEach(f => {\n    ctx.save(); ctx.globalAlpha = 0.95;\n    drawHorse(ctx, f.x, f.y, 0.5, f.horse.coat, 1, t * 6, 1.5, 0, true);\n    ctx.restore();\n  });\n\n  // herd, sorted by depth\n  const sorted = [...S.herd].sort((a, b) => a.yf - b.yf);\n  const tn = Date.now();\n  sorted.forEach(h => {\n    const [px, py] = horseXY(h);\n    const k = horseScale(h);\n    const amp = h.mode === 'walk' ? 3.5 : 0;\n    const graze = h.mode === 'graze' ? 0.85 + Math.sin(h.phase) * 0.1 : 0;\n    drawHorse(ctx, px, py, k, h.coat, h.dir, h.phase, amp, graze, h.stage === 'foal');\n    if (tn < h.petUntil) {\n      ctx.font = '700 13px ui-rounded, -apple-system, sans-serif';\n      ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';\n      const label = h.name + (h.stage === 'foal' ? ' \ud83c\udf7c' : '');\n      const tw = ctx.measureText(label).width;\n      ctx.fillStyle = 'rgba(255,248,238,0.92)';\n      const ly = py - 68 * k;\n      ctx.beginPath();\n      ctx.roundRect(px - tw / 2 - 8, ly - 18, tw + 16, 22, 11);\n      ctx.fill();\n      ctx.fillStyle = '#5a4632';\n      ctx.fillText(label, px, ly + 1);\n    }\n  });\n\n  drawParticles();\n\n  // floating texts\n  floaters.forEach(f => {\n    const a = 1 - f.age / f.life;\n    ctx.globalAlpha = a;\n    ctx.font = '800 16px ui-rounded, -apple-system, sans-serif';\n    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';\n    ctx.strokeStyle = 'rgba(255,255,255,0.85)'; ctx.lineWidth = 4;\n    ctx.strokeText(f.text, f.x, f.y);\n    ctx.fillStyle = f.col;\n    ctx.fillText(f.text, f.x, f.y);\n    ctx.globalAlpha = 1;\n  });\n}\n\n// roundRect polyfill for older Safari\nif (!CanvasRenderingContext2D.prototype.roundRect) {\n  CanvasRenderingContext2D.prototype.roundRect = function (x, y, w, h, r) {\n    this.moveTo(x + r, y);\n    this.arcTo(x + w, y, x + w, y + h, r);\n    this.arcTo(x + w, y + h, x, y + h, r);\n    this.arcTo(x, y + h, x, y, r);\n    this.arcTo(x, y, x + w, y, r);\n    this.closePath();\n    return this;\n  };\n}\n\n// ============================================================ input\ncv.addEventListener('pointerdown', e => {\n  e.preventDefault();\n  unlockAudio();\n  const x = e.clientX, y = e.clientY;\n\n  // bubbles first (topmost)\n  for (let i = bubbles.length - 1; i >= 0; i--) {\n    const b = bubbles[i];\n    const bx = b.drawX !== undefined ? b.drawX : b.x;\n    if (Math.hypot(x - bx, y - b.y) < b.r + 16) { popBubble(b); return; }\n  }\n  // then horses\n  let best = null, bestD = 1e9;\n  S.herd.forEach(h => {\n    const [px, py] = horseXY(h);\n    const d = Math.hypot(x - px, y - (py - 26 * horseScale(h)));\n    if (d < 46 * horseScale(h) + 8 && d < bestD) { best = h; bestD = d; }\n  });\n  if (best) { const [px, py] = horseXY(best); petHorse(best, px, py); return; }\n  // gentle feedback anywhere\n  sparkle(x, y, 2);\n});\n\ndocument.addEventListener('gesturestart', e => e.preventDefault());\ndocument.addEventListener('dblclick', e => e.preventDefault());\n\n// ============================================================ HUD & shop\nfunction hud() {\n  $('coinsEl').textContent = S.coins;\n  $('herdEl').textContent = S.herd.length + '/' + capOf();\n}\n\nconst sheet = $('sheet'), backdrop = $('backdrop');\nfunction openShop() { renderShop(); sheet.classList.add('open'); backdrop.classList.add('open'); }\nfunction closeShop() { sheet.classList.remove('open'); backdrop.classList.remove('open'); }\n$('shopBtn').addEventListener('click', () => { unlockAudio(); openShop(); });\n$('closeShop').addEventListener('click', closeShop);\nbackdrop.addEventListener('click', closeShop);\n\n$('sndBtn').addEventListener('click', () => {\n  unlockAudio();\n  S.muted = !S.muted;\n  $('sndBtn').textContent = S.muted ? '\ud83d\udd07' : '\ud83d\udd0a';\n  save();\n});\n\nfunction renderShop() {\n  const box = $('items');\n  box.innerHTML = '';\n  SHOP.forEach(it => {\n    const lvl = it.decor ? (S.decor[it.id] ? 1 : 0) : S.up[it.id];\n    const maxed = it.decor ? S.decor[it.id] : lvl >= it.max;\n    const cost = it.cost(lvl);\n    const row = document.createElement('div');\n    row.className = 'item';\n    const lvlTxt = it.decor ? '' : ' <span style=\"color:#c0a878\">Lv ' + lvl + '/' + it.max + '</span>';\n    row.innerHTML =\n      '<div class=\"ic\">' + it.ic + '</div>' +\n      '<div class=\"tx\"><b>' + it.name + lvlTxt + '</b><span>' + it.desc + '</span></div>';\n    const btn = document.createElement('button');\n    btn.className = 'buy';\n    if (maxed) { btn.classList.add('owned'); btn.textContent = it.decor ? 'Yours \u2713' : 'MAX'; btn.disabled = true; }\n    else {\n      btn.textContent = cost + ' \ud83e\ude99';\n      btn.disabled = S.coins < cost;\n      btn.addEventListener('click', () => {\n        if (S.coins < cost) return;\n        S.coins -= cost;\n        if (it.decor) S.decor[it.id] = true; else S.up[it.id]++;\n        sBuy(); save(); hud(); renderShop();\n        toast(it.ic + ' ' + it.name + '!');\n      });\n    }\n    row.appendChild(btn);\n    box.appendChild(row);\n  });\n  const total = S.rescued + S.born;\n  $('stats').textContent = 'Rescued ' + S.rescued + ' \u00b7 Born ' + S.born + ' \u00b7 ' + titleFor(total);\n}\n\n// ============================================================ boot & loop\nconst hadSave = load();\nprocessOffline();\nhud();\n$('sndBtn').textContent = S.muted ? '\ud83d\udd07' : '\ud83d\udd0a';\n\nif (!hadSave) {\n  setTimeout(() => toast('Pop the bubbles to rescue baby horses! \ud83e\udee7\ud83d\udc34'), 600);\n  setTimeout(() => toast('Tap a horse to say hello \ud83d\udc97'), 4000);\n}\n\nlet lastT = performance.now(), saveT = 0;\nfunction loop(t) {\n  const dt = Math.min((t - lastT) / 1000, 0.05);\n  lastT = t;\n  update(dt);\n  draw(t / 1000);\n  saveT += dt;\n  if (saveT > 5) { saveT = 0; save(); }\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nwindow.addEventListener('pagehide', save);\ndocument.addEventListener('visibilitychange', () => {\n  if (document.visibilityState === 'hidden') save();\n  else { processOffline(); lastT = performance.now(); }\n});\n</script>\n","index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<meta name=\"description\" content=\"A cozy bubble-pop game: rescue baby horses from bubbles and grow your meadow herd. No ads, no timers, saves automatically.\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Foal Meadow\">\n<meta name=\"theme-color\" content=\"#9fdcf5\">\n<link rel=\"apple-touch-icon\" href=\"icon-180.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"icon-192.png\">\n<link rel=\"manifest\" href=\"manifest.json\">\n<title>Foal Rescue Meadow</title>\n<style>\n  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }\n  body {\n    position: fixed; inset: 0; width: 100%;\n    background: #aee4f7;\n    font-family: ui-rounded, -apple-system, \"SF Pro Rounded\", \"Segoe UI\", system-ui, sans-serif;\n    -webkit-tap-highlight-color: transparent;\n    user-select: none; -webkit-user-select: none;\n    touch-action: none;\n    overscroll-behavior: none;\n  }\n  #game { position: fixed; inset: 0; display: block; }\n\n  #hud {\n    position: fixed; top: env(safe-area-inset-top, 0px); left: 0; right: 0;\n    display: flex; align-items: center; gap: 8px;\n    padding: 10px 12px; z-index: 5; pointer-events: none;\n  }\n  .pill {\n    background: rgba(255, 248, 238, 0.92);\n    border-radius: 999px; padding: 8px 14px;\n    font-weight: 800; color: #5a4632; font-size: 16px;\n    box-shadow: 0 2px 10px rgba(90, 70, 50, 0.18);\n    display: flex; align-items: center; gap: 6px;\n    font-variant-numeric: tabular-nums;\n  }\n  .spacer { flex: 1; }\n  .hbtn {\n    pointer-events: auto;\n    background: rgba(255, 248, 238, 0.94);\n    border: none; border-radius: 999px;\n    min-width: 46px; height: 46px; font-size: 21px;\n    box-shadow: 0 2px 10px rgba(90, 70, 50, 0.2);\n    color: #5a4632;\n  }\n  .hbtn:active { transform: scale(0.94); }\n  #shopBtn { padding: 0 18px; font-weight: 800; font-size: 16px; font-family: inherit; }\n\n  #toast {\n    position: fixed; left: 50%; top: calc(env(safe-area-inset-top, 0px) + 68px);\n    transform: translateX(-50%) translateY(-10px);\n    background: rgba(255, 248, 238, 0.96); color: #5a4632;\n    font-weight: 700; font-size: 15px;\n    padding: 10px 18px; border-radius: 999px;\n    box-shadow: 0 4px 16px rgba(90, 70, 50, 0.22);\n    opacity: 0; transition: opacity 0.25s, transform 0.25s;\n    z-index: 8; max-width: 86%; text-align: center; pointer-events: none;\n  }\n  #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n\n  #backdrop {\n    position: fixed; inset: 0; background: rgba(60, 45, 30, 0.25);\n    opacity: 0; pointer-events: none; transition: opacity 0.25s; z-index: 9;\n  }\n  #backdrop.open { opacity: 1; pointer-events: auto; }\n\n  #sheet {\n    position: fixed; left: 0; right: 0; bottom: 0;\n    background: #fff8ee;\n    border-radius: 24px 24px 0 0;\n    box-shadow: 0 -8px 32px rgba(60, 45, 30, 0.3);\n    transform: translateY(105%); transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);\n    z-index: 10; max-height: 72%;\n    display: flex; flex-direction: column;\n    padding-bottom: env(safe-area-inset-bottom, 8px);\n  }\n  #sheet.open { transform: translateY(0); }\n  .sheetHead {\n    display: flex; justify-content: space-between; align-items: center;\n    padding: 16px 18px 10px; font-size: 19px; font-weight: 800; color: #5a4632;\n  }\n  #closeShop {\n    border: none; background: #f0e6d8; color: #8a7a66;\n    border-radius: 999px; width: 38px; height: 38px; font-size: 16px; font-weight: 700;\n  }\n  #items { overflow-y: auto; padding: 0 12px 10px; touch-action: pan-y; -webkit-overflow-scrolling: touch; }\n  .item {\n    display: flex; align-items: center; gap: 12px;\n    background: #ffffff; border-radius: 18px;\n    padding: 12px 14px; margin-bottom: 9px;\n    box-shadow: 0 1px 5px rgba(90, 70, 50, 0.1);\n  }\n  .item .ic { font-size: 27px; width: 34px; text-align: center; }\n  .item .tx { flex: 1; min-width: 0; }\n  .item .tx b { display: block; color: #5a4632; font-size: 15.5px; }\n  .item .tx span { font-size: 12.5px; color: #9a8a74; }\n  .buy {\n    border: none; border-radius: 999px;\n    background: #ffd45e; color: #6b4e12;\n    font-weight: 800; font-family: inherit;\n    padding: 12px 15px; font-size: 14px; min-width: 82px;\n    font-variant-numeric: tabular-nums;\n  }\n  .buy:active { transform: scale(0.95); }\n  .buy:disabled { background: #ece4d6; color: #b0a591; transform: none; }\n  .buy.owned { background: #c5e8ad; color: #3e6a28; }\n  #stats { padding: 6px 18px 14px; font-size: 13px; color: #9a8a74; text-align: center; font-weight: 600; }\n</style>\n</head>\n<body>\n<canvas id=\"game\"></canvas>\n\n<div id=\"hud\">\n  <div class=\"pill\">\ud83e\ude99 <span id=\"coinsEl\">0</span></div>\n  <div class=\"pill\">\ud83d\udc34 <span id=\"herdEl\">0/4</span></div>\n  <div class=\"spacer\"></div>\n  <button class=\"hbtn\" id=\"sndBtn\">\ud83d\udd0a</button>\n  <button class=\"hbtn\" id=\"shopBtn\">\ud83c\udf80 Shop</button>\n</div>\n\n<div id=\"toast\"></div>\n<div id=\"backdrop\"></div>\n<div id=\"sheet\">\n  <div class=\"sheetHead\"><span>\ud83c\udf80 Ranch Shop</span><button id=\"closeShop\">\u2715</button></div>\n  <div id=\"items\"></div>\n  <div id=\"stats\"></div>\n</div>\n\n<script>\n'use strict';\n// ============================================================ helpers\nconst $ = id => document.getElementById(id);\nconst rand = (a, b) => a + Math.random() * (b - a);\nconst clamp = (v, a, b) => Math.max(a, Math.min(b, v));\nconst TAU = Math.PI * 2;\n\nfunction shade(hex, amt) { // lighten (+) / darken (-) a #rrggbb color\n  const n = parseInt(hex.slice(1), 16);\n  const r = clamp((n >> 16) + amt, 0, 255), g = clamp(((n >> 8) & 255) + amt, 0, 255), b = clamp((n & 255) + amt, 0, 255);\n  return `rgb(${r},${g},${b})`;\n}\n\n// ============================================================ constants\nconst GROW_MS = 3 * 60 * 1000;          // foal -> horse\nconst SAVE_KEY = 'foal-rescue-meadow-v1';\n\nconst COATS = [\n  { body: '#b5773f', mane: '#6d4423' }, // chestnut\n  { body: '#8a5a33', mane: '#3f2a17' }, // bay\n  { body: '#e2b25f', mane: '#f6e7c1' }, // palomino\n  { body: '#b9bcc9', mane: '#8a8da0' }, // grey\n  { body: '#565661', mane: '#33333c' }, // black\n  { body: '#e8d3ab', mane: '#c9a86b' }, // cream\n  { body: '#c98f80', mane: '#8f5a4e' }, // strawberry roan\n  { body: '#f3efe7', mane: '#d8cfc0' }, // snow white\n];\n\nconst NAMES = ['Buttercup','Clover','Daisy','Willow','Maple','Star','Biscuit','Pepper','Honey','Blossom',\n  'Juniper','Rosie','Cocoa','Misty','Sunny','Poppy','Hazel','Ginger','Luna','Marigold',\n  'Pippin','Toffee','Nutmeg','Snowdrop','Bramble','Fern','Dandelion','Sprout','Pebble','Cricket',\n  'Tulip','Sky','Acorn','Berry','Doodle','Waffles','Mochi','Peanut','Cupcake','Petal'];\n\nconst SHOP = [\n  { id: 'cap',     ic: '\ud83c\udf3f', name: 'Bigger Meadow', desc: 'Room for 2 more horses',  max: 8, cost: l => Math.round(25 * Math.pow(2.1, l)) },\n  { id: 'breeze',  ic: '\ud83c\udf43', name: 'Gentle Breeze', desc: 'Bubbles float in faster', max: 6, cost: l => Math.round(40 * Math.pow(2.2, l)) },\n  { id: 'lucky',   ic: '\ud83c\udf40', name: 'Lucky Skies',   desc: 'Rarer, richer bubbles',   max: 5, cost: l => Math.round(60 * Math.pow(2.3, l)) },\n  { id: 'flowers', ic: '\ud83c\udf3c', name: 'Wildflowers',   desc: 'Blooms across the meadow', decor: true, cost: () => 50 },\n  { id: 'pond',    ic: '\ud83e\udeb7', name: 'Lily Pond',     desc: 'A cool drink for the herd', decor: true, cost: () => 150 },\n  { id: 'barn',    ic: '\ud83c\udfe1', name: 'Cozy Barn',     desc: 'Shelter for stormy nights', decor: true, cost: () => 350 },\n  { id: 'rainbow', ic: '\ud83c\udf08', name: 'Rainbow',       desc: 'Every meadow needs one',    decor: true, cost: () => 700 },\n];\n\nfunction titleFor(n) {\n  if (n >= 150) return 'Meadow Legend';\n  if (n >= 100) return 'Stable Star';\n  if (n >= 60)  return 'Herd Hero';\n  if (n >= 30)  return 'Pony Pal';\n  if (n >= 10)  return 'Foal Friend';\n  return 'New Rancher';\n}\n\n// ============================================================ state\nlet S = null;\nlet herdId = 1;\n\nfunction freshState() {\n  return {\n    coins: 0, rescued: 0, born: 0, muted: false, seenHint: false,\n    up: { cap: 0, breeze: 0, lucky: 0 },\n    decor: { flowers: false, pond: false, barn: false, rainbow: false },\n    herd: [], lastSeen: Date.now(),\n  };\n}\nconst capOf = () => 4 + S.up.cap * 2;\nconst adults = () => S.herd.filter(h => h.stage === 'adult');\n\nfunction pickName() {\n  const used = new Set(S.herd.map(h => h.name));\n  const free = NAMES.filter(n => !used.has(n));\n  return free.length ? free[Math.floor(Math.random() * free.length)]\n                     : NAMES[Math.floor(Math.random() * NAMES.length)] + ' Jr';\n}\n\nfunction makeHorse(stage, xf, yf) {\n  return {\n    id: herdId++, name: pickName(), coat: Math.floor(Math.random() * COATS.length),\n    stage, bornAt: Date.now(),\n    xf: xf !== undefined ? xf : rand(0.1, 0.9),\n    yf: yf !== undefined ? yf : rand(0.1, 0.9),\n    dir: Math.random() < 0.5 ? 1 : -1,\n    mode: 'idle', modeT: rand(0.5, 2), targetXf: 0, targetYf: 0,\n    phase: rand(0, TAU), petUntil: 0, petCd: 0,\n    nextCoinAt: Date.now() + rand(25000, 45000),\n  };\n}\n\nfunction save() {\n  S.lastSeen = Date.now();\n  try { localStorage.setItem(SAVE_KEY, JSON.stringify(S)); } catch (e) {}\n}\n\nfunction load() {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (raw) {\n      const d = JSON.parse(raw);\n      S = Object.assign(freshState(), d);\n      S.up = Object.assign({ cap: 0, breeze: 0, lucky: 0 }, d.up);\n      S.decor = Object.assign({ flowers: false, pond: false, barn: false, rainbow: false }, d.decor);\n      S.herd.forEach(h => {\n        herdId = Math.max(herdId, h.id + 1);\n        h.mode = 'idle'; h.modeT = rand(0.5, 2); h.phase = rand(0, TAU);\n        h.petUntil = 0; h.petCd = 0;\n        if (!h.nextCoinAt) h.nextCoinAt = Date.now() + rand(25000, 45000);\n      });\n      return true;\n    }\n  } catch (e) {}\n  S = freshState();\n  const mama = makeHorse('adult', 0.5, 0.55);\n  S.herd.push(mama);\n  return false;\n}\n\n// ============================================================ sound\nlet AC = null;\nfunction unlockAudio() {\n  if (!AC) { try { AC = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {} }\n  if (AC && AC.state === 'suspended') AC.resume();\n}\nfunction tone(f0, f1, dur, type, vol, delay) {\n  if (!AC || S.muted) return;\n  const t = AC.currentTime + (delay || 0);\n  const o = AC.createOscillator(), g = AC.createGain();\n  o.type = type;\n  o.frequency.setValueAtTime(f0, t);\n  o.frequency.exponentialRampToValueAtTime(Math.max(40, f1), t + dur);\n  g.gain.setValueAtTime(vol, t);\n  g.gain.exponentialRampToValueAtTime(0.001, t + dur);\n  o.connect(g).connect(AC.destination);\n  o.start(t); o.stop(t + dur + 0.02);\n}\nconst sPop    = () => tone(520 + Math.random() * 160, 980, 0.09, 'triangle', 0.12);\nconst sCoin   = () => { tone(880, 880, 0.06, 'sine', 0.08); tone(1318, 1318, 0.1, 'sine', 0.08, 0.06); };\nconst sRescue = () => [523, 659, 784].forEach((f, i) => tone(f, f, 0.14, 'sine', 0.09, i * 0.09));\nconst sGrow   = () => [392, 494, 587].forEach((f, i) => tone(f, f, 0.16, 'sine', 0.09, i * 0.1));\nconst sBirth  = () => [523, 659, 784, 1047].forEach((f, i) => tone(f, f, 0.15, 'sine', 0.09, i * 0.09));\nconst sBuy    = () => tone(600, 950, 0.13, 'sine', 0.1);\nconst sPet    = () => tone(700 + Math.random() * 200, 1100, 0.08, 'sine', 0.07);\n\n// ============================================================ canvas setup\nconst cv = $('game'), ctx = cv.getContext('2d');\nlet W = 0, H = 0, MT = 0; // MT = meadow top\n\nfunction resize() {\n  W = window.innerWidth; H = window.innerHeight;\n  const dpr = Math.min(window.devicePixelRatio || 1, 2);\n  cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);\n  cv.style.width = W + 'px'; cv.style.height = H + 'px';\n  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  MT = Math.round(H * 0.55);\n}\nwindow.addEventListener('resize', resize);\nresize();\n\nconst horseXY = h => [h.xf * W, MT + 34 + h.yf * (H - MT - 78)];\nconst horseScale = h => (0.72 + 0.4 * h.yf) * (h.stage === 'foal' ? 0.62 : 1);\n\n// ============================================================ entities\nlet bubbles = [], fallers = [], parts = [], floaters = [];\nlet spawnT = 1.2, growCheckT = 0, nextBirthAt = Date.now() + 60000, comboN = 0, lastPop = 0;\n\nconst spawnInterval = () => Math.max(0.72, 1.5 * Math.pow(0.88, S.up.breeze));\n\nfunction pickKind() {\n  const L = S.up.lucky;\n  const w = [\n    ['foal',   S.herd.length + fallers.length < capOf() ? 3 : 0],\n    ['coin',   5],\n    ['clover', 1.2 + 0.5 * L],\n    ['star',   0.35 + 0.18 * L],\n  ];\n  let tot = w.reduce((s, x) => s + x[1], 0), r = Math.random() * tot;\n  for (const [k, v] of w) { if ((r -= v) <= 0) return k; }\n  return 'coin';\n}\n\nfunction spawnBubble() {\n  const kind = pickKind();\n  bubbles.push({\n    x: rand(30, W - 30), y: MT + rand(0, 30),\n    r: kind === 'foal' ? rand(30, 36) : rand(22, 28),\n    vy: rand(26, 42), wob: rand(14, 26), ph: rand(0, TAU),\n    kind, coat: Math.floor(Math.random() * COATS.length),\n  });\n}\n\nfunction burst(x, y, r, col) {\n  parts.push({ t: 'ring', x, y, r, age: 0, life: 0.35 });\n  for (let i = 0; i < 7; i++) {\n    const a = rand(0, TAU);\n    parts.push({ t: 'drop', x, y, vx: Math.cos(a) * rand(60, 160), vy: Math.sin(a) * rand(60, 160) - 40,\n                 age: 0, life: rand(0.35, 0.6), col: col || 'rgba(190,230,250,0.9)' });\n  }\n}\nfunction hearts(x, y, n) {\n  for (let i = 0; i < n; i++)\n    parts.push({ t: 'heart', x: x + rand(-14, 14), y: y + rand(-8, 4), vx: rand(-15, 15), vy: rand(-70, -40),\n                 age: 0, life: rand(0.8, 1.3), s: rand(8, 13) });\n}\nfunction sparkle(x, y, n) {\n  for (let i = 0; i < n; i++)\n    parts.push({ t: 'spark', x: x + rand(-16, 16), y: y + rand(-16, 16), vx: rand(-25, 25), vy: rand(-60, -15),\n                 age: 0, life: rand(0.4, 0.8), s: rand(3, 6) });\n}\nfunction floater(x, y, text, col) {\n  floaters.push({ x, y, text, col: col || '#5a4632', age: 0, life: 1.1 });\n}\n\nfunction gainCoins(n, x, y) {\n  S.coins += n;\n  if (x !== undefined) floater(x, y, '+' + n + ' \ud83e\ude99', '#8a6a12');\n  hud();\n}\n\n// ============================================================ toasts\nconst toastEl = $('toast');\nlet toastQ = [], toastBusy = false;\nfunction toast(msg) {\n  toastQ.push(msg);\n  if (!toastBusy) nextToast();\n}\nfunction nextToast() {\n  if (!toastQ.length) { toastBusy = false; return; }\n  toastBusy = true;\n  toastEl.textContent = toastQ.shift();\n  toastEl.classList.add('show');\n  setTimeout(() => {\n    toastEl.classList.remove('show');\n    setTimeout(nextToast, 350);\n  }, 2400);\n}\n\n// ============================================================ game events\nfunction rescueFoal(b) {\n  const h = makeHorse('foal', clamp(b.x / W, 0.08, 0.92), rand(0.15, 0.85));\n  h.coat = b.coat;\n  const [, ty] = horseXY(h);\n  fallers.push({ x: b.x, y: b.y, vy: 30, targetY: ty, horse: h });\n  S.rescued++;\n  gainCoins(3, b.x, b.y - 10);\n  sRescue();\n}\n\nfunction landFaller(f) {\n  const h = f.horse;\n  h.xf = clamp(f.x / W, 0.06, 0.94);\n  S.herd.push(h);\n  sparkle(f.x, f.targetY - 20, 8);\n  toast('\ud83d\udc96 ' + h.name + ' rescued!');\n  if (S.rescued === 1) toast('Foals grow up in a few minutes \ud83c\udf31');\n  hud();\n}\n\nfunction popBubble(b) {\n  b.dead = true;\n  burst(b.x, b.y, b.r);\n  sPop();\n  const t = Date.now();\n  comboN = (t - lastPop < 1300) ? comboN + 1 : 1;\n  lastPop = t;\n  if (b.kind === 'coin')   { gainCoins(2 + (S.up.lucky > 2 ? 1 : 0), b.x, b.y); sCoin(); }\n  if (b.kind === 'clover') { gainCoins(6, b.x, b.y); sCoin(); }\n  if (b.kind === 'star')   { gainCoins(25, b.x, b.y); sparkle(b.x, b.y, 12); sCoin(); }\n  if (b.kind === 'foal')   rescueFoal(b);\n  if (comboN >= 3) {\n    gainCoins(comboN);\n    floater(b.x, b.y - 34, 'Combo x' + comboN + '! +' + comboN, '#c05a8a');\n    sparkle(b.x, b.y, 5);\n  }\n}\n\nfunction doBirth() {\n  const ad = adults();\n  const a = ad[Math.floor(Math.random() * ad.length)];\n  const h = makeHorse('foal', clamp(a.xf + rand(-0.08, 0.08), 0.08, 0.92), clamp(a.yf + rand(-0.1, 0.1), 0.05, 0.95));\n  S.herd.push(h);\n  S.born++;\n  const [px, py] = horseXY(h);\n  hearts(px, py - 40, 8);\n  sparkle(px, py - 20, 8);\n  toast('\ud83c\udf89 A foal was born \u2014 welcome, ' + h.name + '!');\n  sBirth();\n  hud();\n}\n\nfunction petHorse(h, px, py) {\n  const t = Date.now();\n  h.petUntil = t + 2000;\n  hearts(px, py - 40 * horseScale(h), 4);\n  sPet();\n  if (t > h.petCd) { h.petCd = t + 3000; gainCoins(1, px, py - 60 * horseScale(h)); }\n}\n\n// ============================================================ offline progress\nfunction processOffline() {\n  const t = Date.now(), gone = t - (S.lastSeen || t);\n  if (gone < 60000) return;\n  let grew = 0, births = 0, coins = 0;\n  S.herd.forEach(h => {\n    if (h.stage === 'foal' && t >= h.bornAt + GROW_MS) { h.stage = 'adult'; grew++; }\n  });\n  const tries = Math.min(Math.floor(gone / 120000), 3);\n  for (let i = 0; i < tries; i++) {\n    if (adults().length >= 2 && S.herd.length < capOf() && Math.random() < 0.75) {\n      const a = adults()[0];\n      const h = makeHorse('foal', clamp(a.xf + rand(-0.1, 0.1), 0.08, 0.92), rand(0.1, 0.9));\n      h.bornAt = t - rand(0, Math.min(gone * 0.5, GROW_MS * 0.8)); // still a foal when you return\n      S.herd.push(h); S.born++; births++;\n    }\n  }\n  coins = Math.min(adults().length * Math.floor(gone / 35000), 120);\n  S.coins += coins;\n  const bits = [];\n  if (grew)   bits.push(grew + (grew > 1 ? ' foals grew up' : ' foal grew up'));\n  if (births) bits.push(births + (births > 1 ? ' foals were born' : ' foal was born'));\n  if (coins)  bits.push('the herd earned ' + coins + ' \ud83e\ude99');\n  if (bits.length) toast('While you were away, ' + bits.join(', ') + '!');\n  nextBirthAt = t + rand(60000, 120000);\n  hud();\n}\n\n// ============================================================ update\nfunction update(dt) {\n  const t = Date.now();\n\n  // bubbles\n  spawnT -= dt;\n  if (spawnT <= 0 && bubbles.length < 14) { spawnBubble(); spawnT = spawnInterval() * rand(0.7, 1.3); }\n  bubbles.forEach(b => { b.y -= b.vy * dt; b.ph += dt * 1.6; });\n  bubbles = bubbles.filter(b => !b.dead && b.y > -b.r - 10);\n\n  // falling rescued foals\n  fallers.forEach(f => {\n    f.vy = Math.min(f.vy + 60 * dt, 90);\n    f.y += f.vy * dt;\n    if (f.y >= f.targetY) { f.done = true; landFaller(f); }\n  });\n  fallers = fallers.filter(f => !f.done);\n\n  // horses wander\n  S.herd.forEach(h => {\n    h.modeT -= dt;\n    if (h.mode === 'walk') {\n      const sp = (h.stage === 'foal' ? 0.045 : 0.032);\n      const dx = h.targetXf - h.xf, dy = h.targetYf - h.yf;\n      const d = Math.hypot(dx, dy);\n      if (d < 0.015) { h.mode = Math.random() < 0.5 ? 'graze' : 'idle'; h.modeT = rand(1.5, 4.5); }\n      else {\n        h.xf += (dx / d) * sp * dt; h.yf += (dy / d) * sp * dt;\n        h.dir = dx >= 0 ? 1 : -1;\n        h.phase += dt * 7;\n      }\n    } else if (h.modeT <= 0) {\n      if (Math.random() < 0.7) {\n        h.mode = 'walk';\n        h.targetXf = clamp(h.xf + rand(-0.3, 0.3), 0.06, 0.94);\n        h.targetYf = clamp(h.yf + rand(-0.35, 0.35), 0.05, 0.95);\n      } else { h.mode = Math.random() < 0.5 ? 'graze' : 'idle'; h.modeT = rand(1.5, 4); }\n    }\n    if (h.mode === 'graze') h.phase += dt * 2;\n\n    // idle income from grown horses\n    if (h.stage === 'adult' && t >= h.nextCoinAt) {\n      h.nextCoinAt = t + rand(25000, 45000);\n      const [px, py] = horseXY(h);\n      gainCoins(1, px, py - 62 * horseScale(h));\n      sparkle(px, py - 40 * horseScale(h), 3);\n    }\n  });\n\n  // growth\n  growCheckT -= dt;\n  if (growCheckT <= 0) {\n    growCheckT = 1;\n    S.herd.forEach(h => {\n      if (h.stage === 'foal' && t >= h.bornAt + GROW_MS) {\n        h.stage = 'adult';\n        const [px, py] = horseXY(h);\n        sparkle(px, py - 30, 10);\n        toast('\ud83c\udf31 ' + h.name + ' grew into a horse!');\n        sGrow();\n        if (adults().length === 2 && S.born === 0) toast('Two grown horses may have a baby \ud83d\udc95');\n      }\n    });\n  }\n\n  // births\n  if (t >= nextBirthAt) {\n    if (adults().length >= 2 && S.herd.length < capOf()) doBirth();\n    nextBirthAt = t + rand(90000, 150000);\n  }\n\n  // particles & floaters\n  parts.forEach(p => {\n    p.age += dt;\n    if (p.t === 'drop' || p.t === 'heart' || p.t === 'spark') {\n      p.x += p.vx * dt; p.y += p.vy * dt;\n      if (p.t === 'drop') p.vy += 300 * dt;\n    }\n  });\n  parts = parts.filter(p => p.age < p.life);\n  floaters.forEach(f => { f.age += dt; f.y -= 34 * dt; });\n  floaters = floaters.filter(f => f.age < f.life);\n}\n\n// ============================================================ drawing: horse\nfunction drawHorse(c, x, y, k, ci, dir, phase, amp, graze, isFoal) {\n  const co = COATS[ci];\n  const dark = shade(co.body, -22), near = shade(co.body, -6);\n  c.save();\n  c.translate(x, y);\n  c.scale(dir * k, k);\n\n  // shadow\n  c.fillStyle = 'rgba(50,90,35,0.22)';\n  c.beginPath(); c.ellipse(0, 1.5, isFoal ? 20 : 24, 4.5, 0, 0, TAU); c.fill();\n\n  const bob = Math.sin(phase * 2) * 0.8 * (amp > 0 ? 1 : 0.3);\n  const bodyY = -27 + bob;\n  const legW = isFoal ? 3.6 : 4.8;\n  const rx = isFoal ? 16.5 : 21, ry = isFoal ? 10.5 : 13.5;\n\n  // legs (far pair darker, near pair)\n  const legs = [\n    { x: -14, ph: 0,           col: dark },\n    { x: 12,  ph: Math.PI,     col: dark },\n    { x: -10, ph: Math.PI,     col: near },\n    { x: 15,  ph: 0,           col: near },\n  ];\n  c.lineCap = 'round';\n  legs.forEach(L => {\n    const swing = Math.sin(phase + L.ph) * amp;\n    c.strokeStyle = L.col; c.lineWidth = legW;\n    c.beginPath(); c.moveTo(L.x, bodyY + 5); c.lineTo(L.x + swing, -2); c.stroke();\n    c.fillStyle = shade(co.mane, -12);\n    c.beginPath(); c.arc(L.x + swing, -1.5, legW * 0.62, 0, TAU); c.fill();\n  });\n\n  // tail\n  c.strokeStyle = co.mane; c.lineWidth = 6;\n  c.beginPath(); c.moveTo(-rx + 1, bodyY - 5);\n  c.quadraticCurveTo(-rx - 9, bodyY + 5, -rx - 6, -9); c.stroke();\n  c.lineWidth = 3.5;\n  c.beginPath(); c.moveTo(-rx + 1, bodyY - 4);\n  c.quadraticCurveTo(-rx - 12, bodyY + 8, -rx - 10, -11); c.stroke();\n\n  // body\n  c.fillStyle = co.body;\n  c.beginPath(); c.ellipse(0, bodyY, rx, ry, 0, 0, TAU); c.fill();\n\n  // neck + head (graze lowers the head)\n  const headX = 22 + graze * 4 - (isFoal ? 2 : 0);\n  const headY = bodyY - 19 + graze * (0 - bodyY - 15) + Math.sin(phase) * graze * 1.5;\n  const nsx = 11, nsy = bodyY - 6;\n  c.strokeStyle = co.body; c.lineWidth = isFoal ? 8.5 : 11;\n  c.beginPath(); c.moveTo(nsx, nsy); c.lineTo(headX - 2, headY + 2); c.stroke();\n\n  // mane along neck\n  c.fillStyle = co.mane;\n  for (const tt of [0.3, 0.58, 0.86]) {\n    const mx = nsx + (headX - 2 - nsx) * tt - 2.5;\n    const my = nsy + (headY + 2 - nsy) * tt - 4;\n    c.beginPath(); c.arc(mx, my, 4.4 - tt, 0, TAU); c.fill();\n  }\n\n  // head\n  const hr = isFoal ? 8.8 : 8.4;\n  c.fillStyle = co.body;\n  c.beginPath(); c.ellipse(headX + 2, headY, hr, hr * 0.85, 0, 0, TAU); c.fill();\n  // muzzle\n  c.fillStyle = shade(co.body, 34);\n  c.beginPath(); c.arc(headX + 8.6, headY + 2.6, 4.5, 0, TAU); c.fill();\n  c.fillStyle = shade(co.body, -40);\n  c.beginPath(); c.arc(headX + 10.2, headY + 2.2, 0.8, 0, TAU); c.fill();\n  // ear\n  c.fillStyle = co.body;\n  c.beginPath();\n  c.moveTo(headX - 2.5, headY - 5.5); c.lineTo(headX + 0.5, headY - 13.5); c.lineTo(headX + 4, headY - 5);\n  c.closePath(); c.fill();\n  // forelock\n  c.fillStyle = co.mane;\n  c.beginPath(); c.arc(headX - 1.5, headY - 6.5, 3.4, 0, TAU); c.fill();\n  // eye\n  const er = isFoal ? 2.1 : 1.7;\n  c.fillStyle = '#2a2118';\n  c.beginPath(); c.arc(headX + 3.6, headY - 1.4, er, 0, TAU); c.fill();\n  c.fillStyle = '#fff';\n  c.beginPath(); c.arc(headX + 3, headY - 2, er * 0.38, 0, TAU); c.fill();\n  // foal blush\n  if (isFoal) {\n    c.fillStyle = 'rgba(240,140,160,0.45)';\n    c.beginPath(); c.arc(headX + 0.5, headY + 3.2, 2.1, 0, TAU); c.fill();\n  }\n  c.restore();\n}\n\n// ============================================================ drawing: world\nconst clouds = [];\nfor (let i = 0; i < 4; i++) clouds.push({ xf: Math.random(), yf: 0.08 + Math.random() * 0.3, s: rand(0.7, 1.3), v: rand(3, 7) });\n\nconst flowerSpots = [];\nfor (let i = 0; i < 16; i++) {\n  // deterministic pseudo-random spots\n  const a = Math.sin(i * 127.1) * 43758.5453, b = Math.sin(i * 311.7) * 12543.85;\n  flowerSpots.push({ xf: a - Math.floor(a), yf: b - Math.floor(b), hue: i % 3 });\n}\n\nfunction drawWorld(t) {\n  // sky\n  let g = ctx.createLinearGradient(0, 0, 0, MT);\n  g.addColorStop(0, '#9fdcf5'); g.addColorStop(1, '#eaf8fe');\n  ctx.fillStyle = g; ctx.fillRect(0, 0, W, MT + 2);\n\n  // sun\n  ctx.fillStyle = 'rgba(255,236,160,0.9)';\n  ctx.beginPath(); ctx.arc(W - 58, 84, 26, 0, TAU); ctx.fill();\n  ctx.fillStyle = 'rgba(255,236,160,0.3)';\n  ctx.beginPath(); ctx.arc(W - 58, 84, 40, 0, TAU); ctx.fill();\n\n  // rainbow decor\n  if (S.decor.rainbow) {\n    const cx = W * 0.72, cy = MT + 20;\n    const cols = ['rgba(240,110,110,.5)','rgba(245,180,90,.5)','rgba(245,230,120,.5)','rgba(140,210,130,.5)','rgba(120,170,235,.5)','rgba(180,140,225,.5)'];\n    cols.forEach((col, i) => {\n      ctx.strokeStyle = col; ctx.lineWidth = 7;\n      ctx.beginPath(); ctx.arc(cx, cy, W * 0.34 - i * 7, Math.PI, TAU); ctx.stroke();\n    });\n  }\n\n  // clouds\n  ctx.fillStyle = 'rgba(255,255,255,0.85)';\n  clouds.forEach(cl => {\n    cl.xf += (cl.v / W) * 0.016;\n    if (cl.xf > 1.15) cl.xf = -0.15;\n    const cx = cl.xf * W, cy = cl.yf * MT, s = cl.s;\n    ctx.beginPath();\n    ctx.arc(cx, cy, 16 * s, 0, TAU);\n    ctx.arc(cx + 18 * s, cy + 4 * s, 13 * s, 0, TAU);\n    ctx.arc(cx - 18 * s, cy + 5 * s, 12 * s, 0, TAU);\n    ctx.arc(cx + 2 * s, cy + 8 * s, 14 * s, 0, TAU);\n    ctx.fill();\n  });\n\n  // hills at horizon\n  ctx.fillStyle = '#a8d888';\n  ctx.beginPath(); ctx.ellipse(W * 0.22, MT + 14, W * 0.42, 42, 0, Math.PI, TAU); ctx.fill();\n  ctx.fillStyle = '#98cf76';\n  ctx.beginPath(); ctx.ellipse(W * 0.78, MT + 16, W * 0.46, 34, 0, Math.PI, TAU); ctx.fill();\n\n  // meadow\n  g = ctx.createLinearGradient(0, MT, 0, H);\n  g.addColorStop(0, '#8fce6a'); g.addColorStop(1, '#5fae44');\n  ctx.fillStyle = g; ctx.fillRect(0, MT, W, H - MT);\n\n  // barn decor (background)\n  if (S.decor.barn) {\n    const bx = W - 74, by = MT + 26, s = 1;\n    ctx.fillStyle = '#c05a4a';\n    ctx.fillRect(bx - 30 * s, by - 26 * s, 60 * s, 34 * s);\n    ctx.fillStyle = '#8a4234';\n    ctx.beginPath(); ctx.moveTo(bx - 36 * s, by - 26 * s); ctx.lineTo(bx, by - 48 * s); ctx.lineTo(bx + 36 * s, by - 26 * s); ctx.closePath(); ctx.fill();\n    ctx.fillStyle = '#6d4423';\n    ctx.fillRect(bx - 9 * s, by - 12 * s, 18 * s, 20 * s);\n    ctx.strokeStyle = '#f3e6cf'; ctx.lineWidth = 2;\n    ctx.strokeRect(bx - 9 * s, by - 12 * s, 18 * s, 20 * s);\n  }\n\n  // pond decor (background)\n  if (S.decor.pond) {\n    const px = W * 0.2, py = MT + 46;\n    ctx.fillStyle = '#7ec4d8';\n    ctx.beginPath(); ctx.ellipse(px, py, 62, 19, 0, 0, TAU); ctx.fill();\n    ctx.fillStyle = 'rgba(255,255,255,0.35)';\n    ctx.beginPath(); ctx.ellipse(px - 14, py - 4, 26, 6, 0, 0, TAU); ctx.fill();\n    ctx.fillStyle = '#4e9a5f';\n    ctx.beginPath(); ctx.ellipse(px + 26, py + 2, 9, 5, 0.3, 0, TAU); ctx.fill();\n    ctx.fillStyle = '#f0a8c8';\n    ctx.beginPath(); ctx.arc(px + 26, py, 3, 0, TAU); ctx.fill();\n  }\n\n  // grass tufts\n  ctx.strokeStyle = 'rgba(60,130,45,0.5)'; ctx.lineWidth = 1.6; ctx.lineCap = 'round';\n  for (let i = 0; i < 22; i++) {\n    const a = Math.sin(i * 91.3) * 4721.7, b = Math.sin(i * 53.7) * 8231.3;\n    const gx = (a - Math.floor(a)) * W, gy = MT + 20 + (b - Math.floor(b)) * (H - MT - 40);\n    ctx.beginPath(); ctx.moveTo(gx, gy); ctx.lineTo(gx - 2.5, gy - 6); ctx.stroke();\n    ctx.beginPath(); ctx.moveTo(gx, gy); ctx.lineTo(gx + 2.5, gy - 6.5); ctx.stroke();\n  }\n\n  // wildflowers decor\n  if (S.decor.flowers) {\n    const cols = ['#f5d76e', '#f0a8c8', '#e8ecf5'];\n    flowerSpots.forEach(f => {\n      const fx = 14 + f.xf * (W - 28), fy = MT + 24 + f.yf * (H - MT - 52);\n      ctx.fillStyle = cols[f.hue];\n      for (let p = 0; p < 5; p++) {\n        const a = (p / 5) * TAU + f.xf * 6;\n        ctx.beginPath(); ctx.arc(fx + Math.cos(a) * 3.2, fy + Math.sin(a) * 3.2, 2.4, 0, TAU); ctx.fill();\n      }\n      ctx.fillStyle = '#e8952e';\n      ctx.beginPath(); ctx.arc(fx, fy, 2, 0, TAU); ctx.fill();\n    });\n  }\n}\n\nfunction drawBubble(b) {\n  const { x, y, r } = b;\n  const wx = x + Math.sin(b.ph) * b.wob * 0.25;\n  ctx.save();\n  ctx.translate(wx, y);\n  // bubble sphere\n  const g = ctx.createRadialGradient(-r * 0.3, -r * 0.35, r * 0.15, 0, 0, r);\n  g.addColorStop(0, 'rgba(255,255,255,0.55)');\n  g.addColorStop(0.7, 'rgba(200,235,250,0.28)');\n  g.addColorStop(1, 'rgba(160,215,245,0.5)');\n  ctx.fillStyle = g;\n  ctx.beginPath(); ctx.arc(0, 0, r, 0, TAU); ctx.fill();\n  ctx.strokeStyle = 'rgba(255,255,255,0.75)'; ctx.lineWidth = 1.6;\n  ctx.beginPath(); ctx.arc(0, 0, r - 0.8, 0, TAU); ctx.stroke();\n  // highlight\n  ctx.strokeStyle = 'rgba(255,255,255,0.9)'; ctx.lineWidth = 2.4; ctx.lineCap = 'round';\n  ctx.beginPath(); ctx.arc(0, 0, r * 0.68, -2.4, -1.5); ctx.stroke();\n  // contents\n  if (b.kind === 'foal') {\n    drawHorse(ctx, 0, r * 0.5, r / 58, b.coat, 1, b.ph * 2, 1.5, 0, true);\n  } else {\n    const icon = b.kind === 'coin' ? '\ud83e\ude99' : b.kind === 'clover' ? '\ud83c\udf40' : '\u2b50';\n    ctx.font = Math.round(r * 0.95) + 'px sans-serif';\n    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';\n    ctx.fillText(icon, 0, 2);\n  }\n  ctx.restore();\n  b.drawX = wx; // remember for hit test\n}\n\nfunction drawParticles() {\n  parts.forEach(p => {\n    const f = 1 - p.age / p.life;\n    if (p.t === 'ring') {\n      ctx.strokeStyle = 'rgba(255,255,255,' + (0.8 * f) + ')';\n      ctx.lineWidth = 2.5;\n      ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (1 + (1 - f) * 1.1), 0, TAU); ctx.stroke();\n    } else if (p.t === 'drop') {\n      ctx.fillStyle = p.col;\n      ctx.globalAlpha = f;\n      ctx.beginPath(); ctx.arc(p.x, p.y, 2.6, 0, TAU); ctx.fill();\n      ctx.globalAlpha = 1;\n    } else if (p.t === 'heart') {\n      ctx.globalAlpha = f;\n      ctx.font = p.s + 'px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';\n      ctx.fillText('\ud83d\udc97', p.x, p.y);\n      ctx.globalAlpha = 1;\n    } else if (p.t === 'spark') {\n      ctx.fillStyle = 'rgba(255,235,140,' + f + ')';\n      ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.age * 5);\n      ctx.fillRect(-p.s / 2, -1, p.s, 2); ctx.fillRect(-1, -p.s / 2, 2, p.s);\n      ctx.restore();\n    }\n  });\n}\n\nfunction draw(t) {\n  drawWorld(t);\n  bubbles.forEach(drawBubble);\n\n  // rescued foals gently floating down\n  fallers.forEach(f => {\n    ctx.save(); ctx.globalAlpha = 0.95;\n    drawHorse(ctx, f.x, f.y, 0.5, f.horse.coat, 1, t * 6, 1.5, 0, true);\n    ctx.restore();\n  });\n\n  // herd, sorted by depth\n  const sorted = [...S.herd].sort((a, b) => a.yf - b.yf);\n  const tn = Date.now();\n  sorted.forEach(h => {\n    const [px, py] = horseXY(h);\n    const k = horseScale(h);\n    const amp = h.mode === 'walk' ? 3.5 : 0;\n    const graze = h.mode === 'graze' ? 0.85 + Math.sin(h.phase) * 0.1 : 0;\n    drawHorse(ctx, px, py, k, h.coat, h.dir, h.phase, amp, graze, h.stage === 'foal');\n    if (tn < h.petUntil) {\n      ctx.font = '700 13px ui-rounded, -apple-system, sans-serif';\n      ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';\n      const label = h.name + (h.stage === 'foal' ? ' \ud83c\udf7c' : '');\n      const tw = ctx.measureText(label).width;\n      ctx.fillStyle = 'rgba(255,248,238,0.92)';\n      const ly = py - 68 * k;\n      ctx.beginPath();\n      ctx.roundRect(px - tw / 2 - 8, ly - 18, tw + 16, 22, 11);\n      ctx.fill();\n      ctx.fillStyle = '#5a4632';\n      ctx.fillText(label, px, ly + 1);\n    }\n  });\n\n  drawParticles();\n\n  // floating texts\n  floaters.forEach(f => {\n    const a = 1 - f.age / f.life;\n    ctx.globalAlpha = a;\n    ctx.font = '800 16px ui-rounded, -apple-system, sans-serif';\n    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';\n    ctx.strokeStyle = 'rgba(255,255,255,0.85)'; ctx.lineWidth = 4;\n    ctx.strokeText(f.text, f.x, f.y);\n    ctx.fillStyle = f.col;\n    ctx.fillText(f.text, f.x, f.y);\n    ctx.globalAlpha = 1;\n  });\n}\n\n// roundRect polyfill for older Safari\nif (!CanvasRenderingContext2D.prototype.roundRect) {\n  CanvasRenderingContext2D.prototype.roundRect = function (x, y, w, h, r) {\n    this.moveTo(x + r, y);\n    this.arcTo(x + w, y, x + w, y + h, r);\n    this.arcTo(x + w, y + h, x, y + h, r);\n    this.arcTo(x, y + h, x, y, r);\n    this.arcTo(x, y, x + w, y, r);\n    this.closePath();\n    return this;\n  };\n}\n\n// ============================================================ input\ncv.addEventListener('pointerdown', e => {\n  e.preventDefault();\n  unlockAudio();\n  const x = e.clientX, y = e.clientY;\n\n  // bubbles first (topmost)\n  for (let i = bubbles.length - 1; i >= 0; i--) {\n    const b = bubbles[i];\n    const bx = b.drawX !== undefined ? b.drawX : b.x;\n    if (Math.hypot(x - bx, y - b.y) < b.r + 16) { popBubble(b); return; }\n  }\n  // then horses\n  let best = null, bestD = 1e9;\n  S.herd.forEach(h => {\n    const [px, py] = horseXY(h);\n    const d = Math.hypot(x - px, y - (py - 26 * horseScale(h)));\n    if (d < 46 * horseScale(h) + 8 && d < bestD) { best = h; bestD = d; }\n  });\n  if (best) { const [px, py] = horseXY(best); petHorse(best, px, py); return; }\n  // gentle feedback anywhere\n  sparkle(x, y, 2);\n});\n\ndocument.addEventListener('gesturestart', e => e.preventDefault());\ndocument.addEventListener('dblclick', e => e.preventDefault());\n\n// ============================================================ HUD & shop\nfunction hud() {\n  $('coinsEl').textContent = S.coins;\n  $('herdEl').textContent = S.herd.length + '/' + capOf();\n}\n\nconst sheet = $('sheet'), backdrop = $('backdrop');\nfunction openShop() { renderShop(); sheet.classList.add('open'); backdrop.classList.add('open'); }\nfunction closeShop() { sheet.classList.remove('open'); backdrop.classList.remove('open'); }\n$('shopBtn').addEventListener('click', () => { unlockAudio(); openShop(); });\n$('closeShop').addEventListener('click', closeShop);\nbackdrop.addEventListener('click', closeShop);\n\n$('sndBtn').addEventListener('click', () => {\n  unlockAudio();\n  S.muted = !S.muted;\n  $('sndBtn').textContent = S.muted ? '\ud83d\udd07' : '\ud83d\udd0a';\n  save();\n});\n\nfunction renderShop() {\n  const box = $('items');\n  box.innerHTML = '';\n  SHOP.forEach(it => {\n    const lvl = it.decor ? (S.decor[it.id] ? 1 : 0) : S.up[it.id];\n    const maxed = it.decor ? S.decor[it.id] : lvl >= it.max;\n    const cost = it.cost(lvl);\n    const row = document.createElement('div');\n    row.className = 'item';\n    const lvlTxt = it.decor ? '' : ' <span style=\"color:#c0a878\">Lv ' + lvl + '/' + it.max + '</span>';\n    row.innerHTML =\n      '<div class=\"ic\">' + it.ic + '</div>' +\n      '<div class=\"tx\"><b>' + it.name + lvlTxt + '</b><span>' + it.desc + '</span></div>';\n    const btn = document.createElement('button');\n    btn.className = 'buy';\n    if (maxed) { btn.classList.add('owned'); btn.textContent = it.decor ? 'Yours \u2713' : 'MAX'; btn.disabled = true; }\n    else {\n      btn.textContent = cost + ' \ud83e\ude99';\n      btn.disabled = S.coins < cost;\n      btn.addEventListener('click', () => {\n        if (S.coins < cost) return;\n        S.coins -= cost;\n        if (it.decor) S.decor[it.id] = true; else S.up[it.id]++;\n        sBuy(); save(); hud(); renderShop();\n        toast(it.ic + ' ' + it.name + '!');\n      });\n    }\n    row.appendChild(btn);\n    box.appendChild(row);\n  });\n  const total = S.rescued + S.born;\n  $('stats').textContent = 'Rescued ' + S.rescued + ' \u00b7 Born ' + S.born + ' \u00b7 ' + titleFor(total);\n}\n\n// ============================================================ boot & loop\nconst hadSave = load();\nprocessOffline();\nhud();\n$('sndBtn').textContent = S.muted ? '\ud83d\udd07' : '\ud83d\udd0a';\n\nif (!hadSave) {\n  setTimeout(() => toast('Pop the bubbles to rescue baby horses! \ud83e\udee7\ud83d\udc34'), 600);\n  setTimeout(() => toast('Tap a horse to say hello \ud83d\udc97'), 4000);\n}\n\nlet lastT = performance.now(), saveT = 0;\nfunction loop(t) {\n  const dt = Math.min((t - lastT) / 1000, 0.05);\n  lastT = t;\n  update(dt);\n  draw(t / 1000);\n  saveT += dt;\n  if (saveT > 5) { saveT = 0; save(); }\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nwindow.addEventListener('pagehide', save);\ndocument.addEventListener('visibilitychange', () => {\n  if (document.visibilityState === 'hidden') save();\n  else { processOffline(); lastT = performance.now(); }\n});\n</script>\n</body>\n</html>\n","review-findings.json":"{\n  \"findings\": [\n    {\"location\": \"load\", \"category\": \"save-load\", \"defect\": \"The saved upgrade levels are merged before the zero defaults, so every load resets Bigger Meadow, Gentle Breeze and Lucky Skies to level 0.\"},\n    {\"location\": \"load\", \"category\": \"save-load\", \"defect\": \"Horses from older saves have no nextCoinAt, but the default is only applied when it equals 0, so those horses never drop idle coins.\"},\n    {\"location\": \"processOffline\", \"category\": \"offline-progress\", \"defect\": \"Away birth tries test herd size <= capacity, so a full meadow can gain one foal beyond its capacity.\"},\n    {\"location\": \"processOffline\", \"category\": \"offline-progress\", \"defect\": \"Away coins divide the time away by 3500 ms instead of 35000 ms, so even a short absence hits the 120 coin cap.\"},\n    {\"location\": \"popBubble\", \"category\": \"play-rewards\", \"defect\": \"A new pop chain restarts at 0 instead of 1, so the chain bonus starts one pop late and pays one less.\"},\n    {\"location\": \"petHorse\", \"category\": \"play-rewards\", \"defect\": \"The petting cooldown is reset on every tap instead of only on paying taps, so rapid petting stops paying coins.\"},\n    {\"location\": \"drawBubble\", \"category\": \"input\", \"defect\": \"drawX stores the unswayed x instead of the drawn swaying x, so the hit test misses taps near the visible edge of a swaying bubble.\"},\n    {\"location\": \"renderShop (buy click handler)\", \"category\": \"shop\", \"defect\": \"The handler raises the level first and then charges the next level's price instead of the price shown, which can drive coins negative.\"}\n  ]\n}\n"}
