{"hardware/cad/build.py":"\"\"\"Build every output for the brass alethiometer (gear-train excerpt).\n\n    python build.py            # checks + SendCutSend order + build report\n    python build.py --check    # checks only\n\nOutputs go to hardware/out/ (committed so the parts can be ordered without Python).\nThe full build also exports DXF/STEP and renders with cadquery; those steps and the 3-D\ninterference sweep are not part of this excerpt.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport json\nimport sys\nimport time\nfrom pathlib import Path\n\nimport design as D\n\nHERE = Path(__file__).resolve().parent\nOUT = HERE.parent / \"out\"\n\n# SendCutSend minimum part size (instant quote) and a conservative min web for laser\nSCS_MIN = (0.25 * 25.4, 0.375 * 25.4)\nDENSITY = {\"brass\": 8.5e-3}           # g/mm\u00b3\n\n\ndef log(msg: str) -> None:\n    print(msg, flush=True)\n\n\ndef _area(pts) -> float:\n    return abs(sum(x0 * y1 - x1 * y0 for (x0, y0), (x1, y1) in zip(pts, pts[1:] + pts[:1]))) / 2\n\n\ndef interference(parts, lid_angles=(0.0,)) -> list[str]:\n    \"\"\"3-D solid interference between every pair of placed parts (cadquery; not in this excerpt).\"\"\"\n    return []\n\n\ndef manufacturability(parts) -> list[str]:\n    notes = []\n    for p in parts:\n        if p.kind != \"scs\" or not p.outline:\n            continue\n        xs, ys = [x for x, _ in p.outline], [y for _, y in p.outline]\n        w, h = sorted((max(xs) - min(xs), max(ys) - min(ys)))\n        if w < SCS_MIN[0] or h < SCS_MIN[1]:\n            notes.append(f\"{p.name}: {w:.1f}\u00d7{h:.1f} mm is under SendCutSend's minimum part size\")\n    return notes\n\n\ndef weight_report(parts) -> tuple[list[dict], float]:\n    rows = []\n    for p in parts:\n        if not p.outline:\n            continue\n        grams = _area(p.outline) * D.T040 * DENSITY[\"brass\"] * len(p.placements) * p.qty\n        rows.append(dict(part=p.name, qty=len(p.placements) * p.qty, grams=round(grams, 2), material=p.material))\n    return rows, sum(r[\"grams\"] for r in rows)\n\n\ndef export_fabrication(parts) -> list[dict]:\n    \"\"\"One SendCutSend line per laser-cut part; writes out/sendcutsend_order.csv.\"\"\"\n    order = [dict(file=f\"{p.name}__{p.material.split()[0]}__qty{max(1, len(p.placements)) * p.qty}.dxf\",\n                  part=p.name, qty=max(1, len(p.placements)) * p.qty, material=p.material)\n             for p in parts if p.kind == \"scs\"]\n    with open(OUT / \"sendcutsend_order.csv\", \"w\", newline=\"\", encoding=\"utf-8\") as f:\n        w = csv.DictWriter(f, fieldnames=[\"file\", \"part\", \"qty\", \"material\"])\n        w.writeheader()\n        w.writerows(order)\n    return order\n\n\n# ---------------------------------------------------------------------------\ndef main() -> int:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--check\", action=\"store_true\", help=\"checks only\")\n    ap.add_argument(\"--no-render\", action=\"store_true\")\n    args = ap.parse_args()\n\n    t0 = time.time()\n    parts = D.all_parts()\n    log(f\"built {len(parts)} part types in {time.time() - t0:.1f}s\")\n    log(json.dumps(D.summary(), indent=1))\n\n    tools = D.tooling()\n    spares = D.mesh_tuning_gears()\n    notes = manufacturability(parts + tools + spares)\n    log(\"manufacturability: \" + (\"OK\" if not notes else \"\"))\n    for n in notes:\n        log(\"  ! \" + n)\n\n    t1 = time.time()\n    problems = interference(parts)\n    log(f\"interference check ({time.time() - t1:.0f}s): \" + (\"none\" if not problems else \"\"))\n    for pr in problems:\n        log(\"  X \" + pr)\n\n    import mesh\n    t1 = time.time()\n    gear_mesh = mesh.report()\n    log(f\"gear mesh ({time.time() - t1:.0f}s), mm at the driven pitch circle:\")\n    fmt = lambda v: \"binds\" if v is None else f\"{v:.2f}\"   # noqa: E731\n    for r in gear_mesh:\n        log(f\"  {r['pair']:<22} backlash {fmt(r['backlash_mm'])}, worst-case cut {fmt(r['backlash_fat_mm'])}\"\n            f\" (with the loose spare {fmt(r['backlash_loose_fat_mm'])}), centre margin {r['margin_mm']:+.2f}\")\n    mesh_problems = mesh.problems(gear_mesh)\n    for pr in mesh_problems:\n        log(\"  X \" + pr)\n\n    rows, grams = weight_report(parts)\n    log(f\"estimated weight: {grams:.0f} g\")\n    if args.check:\n        return 1 if problems or mesh_problems else 0\n\n    OUT.mkdir(exist_ok=True)\n    order = export_fabrication(parts + tools + spares)\n    report = dict(summary=D.summary(), weight_g=round(grams), interference=problems,\n                  manufacturability=notes, sendcutsend_files=len(order), gear_mesh=gear_mesh,\n                  gear_mesh_problems=mesh_problems)\n    (OUT / \"build_report.json\").write_text(json.dumps(report, indent=1), encoding=\"utf-8\")\n    log(f\"exported {len(order)} SendCutSend files\")\n    log(f\"done in {time.time() - t0:.0f}s\")\n    return 1 if problems or mesh_problems else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","hardware/cad/design.py":"\"\"\"The brass alethiometer: every part, its material and its place (gear-train excerpt).\n\nCoordinates (mm): origin at the dial centre on the outside of the case floor.\n+x points to the hinge, +y to 12 o'clock (the \"Hourglass\"), +z up out of the\ndial.\n\nThe full module builds cadquery solids; this excerpt keeps the gear train as plain data:\neach gear Part carries its tooth count, its tooth thinning and its plan-view outline\n(gears.gear_polygon), plus its placements. Run build.py for the checks and the order.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\n\nimport layout as L\nfrom gears import gear_polygon\n\nIN = 25.4\nT040, T063 = 0.040 * IN, 0.063 * IN\nROD_332, ROD_18, TUBE_18, TUBE_532, TUBE_316 = 3 / 32 * IN, 1 / 8 * IN, 1 / 8 * IN, 5 / 32 * IN, 3 / 16 * IN\n\nMODULE = L.MODULE\nZ_HAND, Z_SENSOR, Z_KNOB = L.Z_HAND, L.Z_SENSOR, L.Z_KNOB\nZ_NEEDLE, Z_MOTOR = L.Z_NEEDLE, L.Z_MOTOR\nR_SENSOR, R_KNOB = L.R_SENSOR, L.R_KNOB\nX27_SHAFT = L.X27_SHAFT\n\nGEAR_BACKLASH = 0.20                  # tooth thinning per laser-cut gear (plus layout.CENTER_SLOP)\nGEAR_BACKLASH_LOOSE = 0.36            # mesh-tuning spares: still turn freely with worst-case fat cuts\nGEAR_FIT = 0.08                       # gear bores: kept close so each gear runs centred on its arbor\nKNOB_BORE = 4.0\nKNOB_GEAR_SPEC = (\"Misumi spur gear, module 0.8, 20\u00b0 PA, brass, shape A (no hub), 26 teeth, \"\n                  \"bore enlarged to 4.0 mm\")\n\nZ_P1_TOP = 10.0                       # top of the movement base plate (full stack-up not in this excerpt)\nGEAR_PITCH_Z = 2.0\nLEVELS = [Z_P1_TOP + 0.5 + i * GEAR_PITCH_Z for i in range(4)]   # L0..L3 gear bottoms\n\n# The three framing hands. Knobs at 12 (top), 9 (left), 6 (bottom) o'clock.\nTRAINS = [\n    dict(name=\"I\", angle=90.0, level=0, arbor=ROD_332, arbor_name=\"3/32 rod\"),\n    dict(name=\"II\", angle=180.0, level=1, arbor=TUBE_18, arbor_name=\"1/8 tube\"),\n    dict(name=\"III\", angle=270.0, level=2, arbor=TUBE_532, arbor_name=\"5/32 tube\"),\n]\n\n\n@dataclass\nclass Part:\n    name: str\n    kind: str                 # \"scs\" = laser-cut by SendCutSend, \"bought\", \"stock\"\n    material: str\n    teeth: int = 0\n    backlash: float = 0.0     # tooth thinning the outline was built with (gears.gear_polygon)\n    outline: list = field(default_factory=list)\n    placements: list = field(default_factory=list)   # (x, y, z, rz_deg)\n    qty: int = 1\n    spec: str = \"\"\n    bore: float = 0.0\n\n\ndef knob_xy(train) -> tuple[float, float]:\n    return L.polar(R_KNOB, train[\"angle\"])\n\n\ndef sensor_xy(train) -> tuple[float, float]:\n    return L.polar(R_SENSOR, train[\"angle\"])\n\n\ndef mesh_rot(direction_deg, z, gap=False):\n    \"\"\"Rotation that puts a tooth (or a gap) of a gear toward direction_deg.\"\"\"\n    return direction_deg + (180.0 / z if gap else 0.0)\n\n\ndef gear_part(name, z, bore, placement, backlash=None) -> Part:\n    \"\"\"A laser-cut .040\" brass gear.\"\"\"\n    backlash = GEAR_BACKLASH if backlash is None else backlash\n    return Part(name, \"scs\", \"brass .040\\\"\", z, backlash, gear_polygon(MODULE, z, backlash=backlash),\n                [placement], spec=f\"{z}T module {MODULE} involute, bore {bore:.2f}\", bore=bore)\n\n\ndef gears(backlash=None) -> list[Part]:\n    parts = []\n    tubes = [ROD_332, TUBE_18, TUBE_532]\n    for tr, od in zip(TRAINS, tubes):\n        z = LEVELS[tr[\"level\"]]\n        a = tr[\"angle\"]\n        sx, sy = sensor_xy(tr)\n        kx, ky = knob_xy(tr)\n        parts.append(gear_part(f\"gear_hand_{tr['name']}_{Z_HAND}T\", Z_HAND, od + GEAR_FIT,\n                               (0.0, 0.0, z, mesh_rot(a, Z_HAND)), backlash))\n        parts.append(gear_part(f\"gear_sensor_{tr['name']}_{Z_SENSOR}T\", Z_SENSOR, ROD_18 + GEAR_FIT,\n                               (sx, sy, z, mesh_rot(a + 180, Z_SENSOR, gap=True)), backlash))\n        parts.append(Part(f\"knob_{tr['name']}_{Z_KNOB}T\", \"bought\", \"brass\", Z_KNOB, 0.08,\n                          gear_polygon(MODULE, Z_KNOB), [(kx, ky, LEVELS[0], mesh_rot(a + 180, Z_KNOB))],\n                          spec=KNOB_GEAR_SPEC, bore=KNOB_BORE))\n    parts.append(gear_part(f\"gear_needle_{Z_NEEDLE}T\", Z_NEEDLE, TUBE_316 + GEAR_FIT,\n                           (0.0, 0.0, LEVELS[3], 0.0), backlash))\n    parts.append(gear_part(f\"gear_motor_{Z_MOTOR}T\", Z_MOTOR, 1.0 + GEAR_FIT,\n                           (*X27_SHAFT, LEVELS[3], mesh_rot(180, Z_MOTOR, gap=True)), backlash))\n    return parts\n\n\ndef mesh_tuning_gears() -> list[Part]:\n    \"\"\"One spare of every laser-cut gear with thinner teeth (GEAR_BACKLASH_LOOSE). Ordered with the\n    rest; swapped in only for a pair that binds on the dry run (ASSEMBLY.md). Not in the assembly.\"\"\"\n    out = []\n    for p in gears(GEAR_BACKLASH_LOOSE):\n        if p.kind != \"scs\":\n            continue\n        p.name += \"_L\"\n        p.spec = (f\"{p.spec}; mesh-tuning spare (\u00d80.5 mark hole in the rim), teeth \"\n                  f\"{GEAR_BACKLASH_LOOSE - GEAR_BACKLASH:.2f} mm thinner: fit only if its pair binds on the dry run\")\n        out.append(p)\n    return out\n\n\ndef tooling() -> list[Part]:\n    \"\"\"Bench tools ordered with the parts (hand-setting tool, hinge gauge; outlines not in this excerpt).\"\"\"\n    return [Part(\"hand_setting_tool\", \"scs\", \"brass .063\\\"\"),\n            Part(\"hinge_gauge\", \"scs\", \"brass .063\\\"\")]\n\n\ndef all_parts() -> list[Part]:\n    \"\"\"Everything in the assembled instrument (this excerpt: the gear train).\"\"\"\n    return gears()\n\n\ndef summary() -> dict:\n    return dict(module=MODULE, gear_backlash=GEAR_BACKLASH, gear_backlash_loose=GEAR_BACKLASH_LOOSE,\n                center_slop=L.CENTER_SLOP,\n                ratios={\"knob:sensor\": f\"{Z_KNOB}:{Z_SENSOR}\", \"sensor:hand\": f\"{Z_SENSOR}:{Z_HAND}\",\n                        \"motor:needle\": f\"{Z_MOTOR}:{Z_NEEDLE}\"})\n","hardware/cad/mesh.py":"\"\"\"Gear mesh analysis: does every pair turn freely, how much backlash, and how much margin.\n\nEach meshing pair is taken from the design (the same outlines that are laser-cut, and the bought\nthumbwheel's nominal profile), placed at its real centres, and analysed in plan view:\n\n- free running: the driven gear can follow the driver without the teeth ever overlapping;\n- backlash: with the driver held, how far the driven gear can rock, in mm at its pitch circle;\n- margin: how much the centre distance can shrink before the pair binds, with the laser-cut\n  teeth cut fat by the supplier's worst case. This is what the bushings, plate holes and\n  laser tolerance have to stay inside.\n\n    python mesh.py            # print the table\n\nThe outlines are ideal involutes (gears.gear_polygon): 20\u00b0 pressure angle, addendum m,\ndedendum 1.25 m, each tooth thinned by half its gear's `backlash`. A laser cut that comes out fat\nby f per side is a normal offset of the whole outline: flanks, tips and roots.\n\"\"\"\nfrom __future__ import annotations\n\nimport math\nfrom dataclasses import dataclass\n\nimport design as D\nimport layout as L\nfrom gears import PRESSURE_ANGLE, _inv, pitch_radius\n\nLASER_FAT = 0.065      # per side: SendCutSend holds about \u00b10.13 mm on a cut feature\nBACKLASH_RANGE = (0.05, 0.45)   # mm at the pitch circle: enough to run free, little enough to read well\nMIN_MARGIN = 0.12      # mm of centre-distance shrink the worst-case-fat teeth must survive\nTYPICAL_FAT, TYPICAL_SHRINK = 0.03, 0.05   # a typical cut: teeth this fat per side, centres this close\n\n\n@dataclass\nclass Pair:\n    name: str\n    a: str                  # driver part name\n    b: str                  # driven part name\n    za: int\n    zb: int\n    ca: tuple[float, float]\n    cb: tuple[float, float]\n    thin_a: float           # tooth thinning each outline was built with (gears.gear_polygon backlash=)\n    thin_b: float\n    laser_a: bool           # laser-cut (subject to the cut tolerance) or bought\n    laser_b: bool\n    module: float = L.MODULE\n\n    @property\n    def nominal_distance(self) -> float:\n        return math.dist(self.ca, self.cb)\n\n    @property\n    def theoretical_distance(self) -> float:\n        return pitch_radius(self.module, self.za) + pitch_radius(self.module, self.zb)\n\n    def operating(self, shrink: float = 0.0) -> tuple[float, float]:\n        \"\"\"Centre distance with the driven gear moved shrink mm toward the driver, and the\n        operating pressure angle there.\"\"\"\n        d = self.nominal_distance - shrink\n        return d, math.acos(min(1.0, self.theoretical_distance * math.cos(PRESSURE_ANGLE) / d))\n\n\ndef pairs(backlash=None) -> list[Pair]:\n    \"\"\"Every meshing pair; backlash= builds the laser-cut gears with that tooth thinning instead.\"\"\"\n    parts = {p.name: p for p in D.gears(backlash)}\n    xy = lambda p: tuple(p.placements[0][:2])            # noqa: E731\n    out = []\n\n    def pair(name, a, b):\n        pa, pb = parts[a], parts[b]\n        return Pair(name, a, b, pa.teeth, pb.teeth, xy(pa), xy(pb), pa.backlash, pb.backlash,\n                    pa.kind == \"scs\", pb.kind == \"scs\")\n\n    for tr in D.TRAINS:\n        n = tr[\"name\"]\n        hand, sensor, knob = f\"gear_hand_{n}_{D.Z_HAND}T\", f\"gear_sensor_{n}_{D.Z_SENSOR}T\", f\"knob_{n}_{D.Z_KNOB}T\"\n        out.append(pair(f\"knob {n} \u2192 sensor {n}\", knob, sensor))\n        out.append(pair(f\"sensor {n} \u2192 hand {n}\", sensor, hand))\n    out.append(pair(\"motor \u2192 needle\", f\"gear_motor_{D.Z_MOTOR}T\", f\"gear_needle_{D.Z_NEEDLE}T\"))\n    return out\n\n\ndef _gear(pair: Pair, side: str, fat: float):\n    \"\"\"(teeth, pitch r, base r, tip r, root r, half-thickness angle at the base circle) as cut.\"\"\"\n    z, thin, laser = (pair.za, pair.thin_a, pair.laser_a) if side == \"a\" else (pair.zb, pair.thin_b, pair.laser_b)\n    f = fat if laser else 0.0\n    m = pair.module\n    r = pitch_radius(m, z)\n    rb = r * math.cos(PRESSURE_ANGLE)\n    psi = (math.pi * m / 2 - thin / 2) / (2 * r) + _inv(PRESSURE_ANGLE) + f / rb\n    return z, r, rb, r + m + f, r - 1.25 * m + f, psi\n\n\ndef backlash(pair: Pair, shrink=0.0, fat=0.0) -> float | None:\n    \"\"\"Total backlash (mm at the driven pitch circle) with the driver held, or None if the pair binds\n    (teeth overlap at some angle: no flank play left, or a tip reaching the other gear's root).\"\"\"\n    d, alpha = pair.operating(shrink)\n    za, ra, rba, raa, rfa, psia = _gear(pair, \"a\", fat)\n    zb, rb, rbb, rab, rfb, psib = _gear(pair, \"b\", fat)\n    if d - raa - rfb <= 0 or d - rab - rfa <= 0:\n        return None\n    inv_w = _inv(alpha)\n    play = 2 * math.pi / zb - 2 * (psib - inv_w) - 2 * (psia - inv_w) * za / zb   # driven rad\n    if play <= 0:\n        return None\n    return play * rb\n\n\ndef margin(pair: Pair, fat=LASER_FAT) -> float:\n    \"\"\"How far (mm) the centres can close up, with fat laser-cut teeth, before the pair binds.\"\"\"\n    lo, hi = -0.3, 0.6\n    if backlash(pair, lo, fat) is None:\n        return lo\n    if backlash(pair, hi, fat) is not None:\n        return hi\n    for _ in range(40):\n        m = (lo + hi) / 2\n        if backlash(pair, m, fat) is None:\n            hi = m\n        else:\n            lo = m\n    return lo\n\n\ndef contact_ratio(pair: Pair, shrink=0.0) -> float:\n    \"\"\"Transverse contact ratio of the nominal outlines at the operating centre distance.\"\"\"\n    d, alpha = pair.operating(shrink)\n    _, _, rba, raa, _, _ = _gear(pair, \"a\", 0.0)\n    _, _, rbb, rab, _, _ = _gear(pair, \"b\", 0.0)\n    action = math.sqrt(raa ** 2 - rba ** 2) + math.sqrt(rab ** 2 - rbb ** 2) - d * math.sin(alpha)\n    return action / (math.pi * pair.module * math.cos(PRESSURE_ANGLE))\n\n\ndef _mm(value):\n    return None if value is None else round(value, 3)\n\n\ndef report() -> list[dict]:\n    rows = []\n    for p, pl in zip(pairs(), pairs(D.GEAR_BACKLASH_LOOSE)):\n        rows.append(dict(\n            pair=p.name, ratio=f\"{p.za}:{p.zb}\",\n            centre_mm=round(p.nominal_distance, 3), theoretical_mm=round(p.theoretical_distance, 3),\n            backlash_mm=_mm(backlash(p)),\n            backlash_fat_mm=_mm(backlash(p, fat=LASER_FAT)),\n            backlash_typical_mm=_mm(backlash(p, TYPICAL_SHRINK, TYPICAL_FAT)),\n            backlash_loose_fat_mm=_mm(backlash(pl, fat=LASER_FAT)),\n            margin_mm=round(margin(p), 3),\n            contact_ratio=round(contact_ratio(p), 3),\n        ))\n    return rows\n\n\ndef problems(rows: list[dict]) -> list[str]:\n    \"\"\"Design rules: nominal parts run with readable backlash, a typical cut still reads, and the\n    loose spares fix a worst-case cut.\"\"\"\n    out = []\n    lo, hi = BACKLASH_RANGE\n    for r in rows:\n        if r[\"backlash_mm\"] is None:\n            out.append(f\"{r['pair']}: binds as designed\")\n        elif not lo <= r[\"backlash_mm\"] <= hi:\n            out.append(f\"{r['pair']}: backlash {r['backlash_mm']:.2f} mm outside {lo}-{hi} mm\")\n        if r[\"backlash_typical_mm\"] is None or r[\"backlash_typical_mm\"] < lo:\n            out.append(f\"{r['pair']}: a typical cut leaves under {lo} mm of backlash\")\n        if r[\"backlash_loose_fat_mm\"] is None or r[\"backlash_loose_fat_mm\"] < lo:\n            out.append(f\"{r['pair']}: binds at worst-case cut even with the loose spare\")\n    return out\n\n\nif __name__ == \"__main__\":\n    print(f\"{'pair':<22} {'ratio':>6} {'centre':>8} {'backlash':>9} {'fat':>6} {'fat+L':>6} {'margin':>7} {'\u03b5':>5}  (mm)\")\n    f = lambda v: \"binds\" if v is None else f\"{v:.3f}\"   # noqa: E731\n    for r in report():\n        print(f\"{r['pair']:<22} {r['ratio']:>6} {r['centre_mm']:>8.3f} {f(r['backlash_mm']):>9} \"\n              f\"{f(r['backlash_fat_mm']):>6} {f(r['backlash_loose_fat_mm']):>6} {r['margin_mm']:>7.3f} \"\n              f\"{r['contact_ratio']:>5.2f}\")\n"}
