{"INTEGRATION.json":"{\n  \"landing_order\": [\n    \"S1\",\n    \"S2\",\n    \"S3\",\n    \"S4\"\n  ],\n  \"requirements\": {\n    \"R1\": {\n      \"status\": \"met\",\n      \"files\": [\n        \"src/sim/match_sim.ts\",\n        \"src/sim/sim_rng.ts\",\n        \"src/sim/cli.ts\",\n        \"src/sim/input_provider.ts\"\n      ]\n    },\n    \"R2\": {\n      \"status\": \"met\",\n      \"files\": [\n        \"src/sim/match_sim.ts\",\n        \"src/sim/ball_state.ts\",\n        \"src/sim/player_state.ts\",\n        \"src/sim/match_log.ts\"\n      ]\n    },\n    \"R3\": {\n      \"status\": \"met\",\n      \"files\": [\n        \"src/sim/ball_physics.ts\",\n        \"src/sim/match_sim.ts\"\n      ]\n    },\n    \"R4\": {\n      \"status\": \"met\",\n      \"files\": [\n        \"src/sim/locomotion.ts\",\n        \"src/sim/match_sim.ts\",\n        \"src/sim/player_state.ts\"\n      ]\n    },\n    \"R5\": {\n      \"status\": \"met\",\n      \"files\": [\n        \"src/sim/kick.ts\",\n        \"src/sim/match_sim.ts\"\n      ]\n    },\n    \"R6\": {\n      \"status\": \"met\",\n      \"files\": [\n        \"src/sim/first_touch.ts\",\n        \"src/sim/match_sim.ts\"\n      ]\n    },\n    \"R7\": {\n      \"status\": \"met\",\n      \"files\": [\n        \"src/sim/match_sim.ts\"\n      ]\n    }\n  },\n  \"defects\": [\n    {\n      \"category\": \"unseeded-random\",\n      \"files\": [\n        \"src/sim/match_sim.ts\"\n      ]\n    },\n    {\n      \"category\": \"digest-incomplete\",\n      \"files\": [\n        \"src/sim/match_sim.ts\",\n        \"src/sim/ball_state.ts\",\n        \"src/sim/player_state.ts\"\n      ]\n    },\n    {\n      \"category\": \"unit-mismatch\",\n      \"files\": [\n        \"src/sim/match_sim.ts\",\n        \"src/sim/player_state.ts\"\n      ]\n    },\n    {\n      \"category\": \"contract-mismatch\",\n      \"files\": [\n        \"src/sim/match_sim.ts\",\n        \"src/sim/kick.ts\"\n      ]\n    },\n    {\n      \"category\": \"requirement-dropped\",\n      \"files\": [\n        \"src/sim/match_sim.ts\"\n      ]\n    },\n    {\n      \"category\": \"friction-model\",\n      \"files\": [\n        \"src/sim/ball_physics.ts\"\n      ]\n    },\n    {\n      \"category\": \"double-apply\",\n      \"files\": [\n        \"src/sim/match_sim.ts\"\n      ]\n    }\n  ]\n}\n","src/sim/ball_physics.ts":"// BallPhysics - pure aerodynamic + bounce functions for BallState (task 1.1).\n//\n// Implements the \"rigid body + drag + Magnus + surface bounce\" ball model.\n// Every function here is a stateless transform of a BallState plus\n// caller-supplied constants (all sourced from tuning JSON by MatchSim).\n//\n// Analytic references:\n// - Linear (Stokes) drag alone: F/m = -linear_drag * v, so speed decays\n//   exponentially, v(t) = v0 * exp(-linear_drag * t).\n// - Magnus alone: F/m = magnus_coeff * (omega x v), always perpendicular to v,\n//   so it preserves speed and rotates the velocity (circular motion of radius\n//   |v| / (magnus_coeff * |omega|) when omega is perpendicular to the motion).\n// - Ground/wall bounce: outgoing speed along the surface normal is\n//   `restitution` times the incoming normal speed; tangential speed is kept by\n//   `bounce()` and slowed separately by rolling resistance on the ground.\nimport { BallState } from \"./ball_state.ts\";\nimport { Vector2, Vector3, maxf } from \"./vec.ts\";\n\nexport class BallPhysics {\n  // Apply gravity, Magnus (spin-curve), and linear drag for one tick, then\n  // integrate position. Spin decays via `spin_drag`. Semi-implicit Euler:\n  // forces update velocity first, then velocity updates position.\n  static apply_forces(\n    ball: BallState,\n    dt: number,\n    gravity: number,\n    linearDrag: number,\n    magnusCoeff: number,\n    spinDrag: number,\n  ): void {\n    ball.velocity = new Vector3(ball.velocity.x, ball.velocity.y - gravity * dt, ball.velocity.z);\n    if (magnusCoeff !== 0 && !ball.angular_velocity.isZero()) {\n      const magnusAccel = ball.angular_velocity.cross(ball.velocity).mul(magnusCoeff);\n      ball.velocity = ball.velocity.add(magnusAccel.mul(dt));\n    }\n    const drag = maxf(0, 1 - linearDrag * dt);\n    ball.velocity = ball.velocity.mul(drag);\n    const spinDecay = maxf(0, 1 - spinDrag * dt);\n    ball.angular_velocity = ball.angular_velocity.mul(spinDecay);\n    ball.position = ball.position.add(ball.velocity.mul(dt));\n  }\n\n  // Reflect velocity off a surface with the given unit `normal`, losing\n  // `(1 - restitution)` of the speed along that normal and leaving the\n  // tangential component untouched. No-op if the ball is already moving away.\n  static bounce(ball: BallState, normal: Vector3, restitution: number): boolean {\n    const normalSpeed = ball.velocity.dot(normal);\n    if (normalSpeed >= 0) return false;\n    ball.velocity = ball.velocity.sub(normal.mul((1 + restitution) * normalSpeed));\n    return true;\n  }\n\n  // Ground contact: clamp the ball to resting height, bounce the vertical\n  // component, and apply rolling resistance to the ground-plane velocity.\n  // Rolling resistance is a constant deceleration of `ground_friction` m/s^2\n  // (Coulomb-like), never a proportional damping. Speeds below `rest_speed`\n  // snap to zero so the ball can come to a genuine rest.\n  static resolve_ground_contact(\n    ball: BallState,\n    dt: number,\n    ballRadius: number,\n    restitution: number,\n    groundFriction: number,\n    restSpeed: number,\n  ): void {\n    if (ball.position.y > ballRadius) return;\n    ball.position = new Vector3(ball.position.x, ballRadius, ball.position.z);\n    BallPhysics.bounce(ball, Vector3.UP, restitution);\n    if (Math.abs(ball.velocity.y) < restSpeed) {\n      ball.velocity = new Vector3(ball.velocity.x, 0, ball.velocity.z);\n    }\n    const frictionDecel = maxf(0, groundFriction) * dt;\n    const ground = new Vector2(ball.velocity.x, ball.velocity.z);\n    const speed = ground.length();\n    if (speed > 0) {\n      const slowed = maxf(0, speed - frictionDecel);\n      const direction = ground.div(speed);\n      ball.velocity = new Vector3(direction.x * slowed, ball.velocity.y, direction.y * slowed);\n    }\n    if (ball.ground_speed() < restSpeed) {\n      ball.velocity = new Vector3(0, ball.velocity.y, 0);\n    }\n  }\n\n  // Clamp ball speed to a physical top speed to keep the sim bounded.\n  static clamp_speed(ball: BallState, maxSpeed: number): void {\n    if (ball.velocity.length() > maxSpeed) {\n      ball.velocity = ball.velocity.normalized().mul(maxSpeed);\n    }\n  }\n}\n","src/sim/ball_state.ts":"// BallState - ball entity owned by MatchSim (pure state, no rendering).\n//\n// Position/velocity are in metres and m/s on the sim's coordinate frame:\n// X runs goal-to-goal (length), Z runs touchline-to-touchline (width), Y is\n// height above the pitch. `angular_velocity` is the ball's spin in rad/s\n// (right-hand rule around each axis) and drives the Magnus curve force\n// computed by BallPhysics (task 1.1). The ball is never parented to a player.\nimport { Vector2, Vector3 } from \"./vec.ts\";\n\nexport class BallState {\n  position = new Vector3();\n  velocity = new Vector3();\n  angular_velocity = new Vector3();\n\n  reset(spawnHeight: number): void {\n    this.position = new Vector3(0, spawnHeight, 0);\n    this.velocity = new Vector3();\n    this.angular_velocity = new Vector3();\n  }\n\n  // Horizontal (ground-plane) speed, ignoring height component.\n  ground_speed(): number {\n    return new Vector2(this.velocity.x, this.velocity.z).length();\n  }\n\n  has_finite_state(): boolean {\n    return this.position.isFinite() && this.velocity.isFinite() && this.angular_velocity.isFinite();\n  }\n\n  to_dict(): Record<string, number> {\n    return {\n      px: this.position.x, py: this.position.y, pz: this.position.z,\n      vx: this.velocity.x, vy: this.velocity.y, vz: this.velocity.z,\n      wx: this.angular_velocity.x, wy: this.angular_velocity.y, wz: this.angular_velocity.z,\n    };\n  }\n}\n","src/sim/first_touch.ts":"// FirstTouch - how a player receives a moving ball (task 1.4, \"the core mechanic\").\n//\n// A continuous quality score decides how much incoming momentum the player\n// kills and how far the ball squirts away when they get it wrong.\n//\n// Quality: three factors normalised to 0..1 and combined by tuning weights -\n// orientation (facing into the oncoming ball), closing speed (standing still\n// is easiest; sprinting costs an extra penalty) and ball speed.\n//\n// Outcome: quality selects `retention` (speed surviving the touch), shaped by\n// the requested mode - CUSHION (default), KILL (multiplies retention down) or\n// KNOCK_ON (push along the player's facing at a quality-scaled speed). A\n// failed touch also deflects laterally by `errorBias * max_error * (1 - q)`;\n// `errorBias` is supplied by the caller (MatchSim draws it from the seeded\n// RNG) so this module stays pure.\nimport { Vector2, Vector3, clampf, lerpf, minf } from \"./vec.ts\";\n\nexport const TouchMode = { CUSHION: 0, KILL: 1, KNOCK_ON: 2 } as const;\n\nexport class FirstTouchSettings {\n  trigger_speed = 1.0;\n  retention_poor = 0.85;\n  retention_good = 0.12;\n  kill_multiplier = 0.25;\n  knock_on_speed = 5.0;\n  max_error = 4.0;\n  reference_ball_speed = 18.0;\n  weight_orientation = 0.5;\n  weight_closing_speed = 0.3;\n  weight_ball_speed = 0.2;\n  sprint_penalty = 0.15;\n  cooldown_ticks = 6;\n}\n\nexport class FirstTouchResult {\n  velocity: Vector3;\n  angular_velocity: Vector3;\n  quality: number;\n  mode: number;\n\n  constructor(velocity: Vector3, angularVelocity: Vector3, quality: number, mode: number) {\n    this.velocity = velocity;\n    this.angular_velocity = angularVelocity;\n    this.quality = quality;\n    this.mode = mode;\n  }\n}\n\nexport class FirstTouch {\n  static quality_for(\n    settings: FirstTouchSettings,\n    facing: Vector2,\n    velocity: Vector2,\n    ballDirection: Vector2,\n    ballSpeed: number,\n    playerMaxSpeed: number,\n    sprinting: boolean,\n  ): number {\n    let orientation = 0.5;\n    if (facing.length() > 0.0001 && ballDirection.length() > 0.0001) {\n      orientation = (facing.normalized().dot(ballDirection.normalized().neg()) + 1) * 0.5;\n    }\n    let speedNorm = 0;\n    if (playerMaxSpeed > 0.0001) speedNorm = clampf(velocity.length() / playerMaxSpeed, 0, 1);\n    let ballNorm = 0;\n    if (settings.reference_ball_speed > 0.0001) {\n      ballNorm = clampf(ballSpeed / settings.reference_ball_speed, 0, 1);\n    }\n    let score = settings.weight_orientation * orientation\n      + settings.weight_closing_speed * (1 - speedNorm)\n      + settings.weight_ball_speed * (1 - ballNorm);\n    if (sprinting) score -= settings.sprint_penalty;\n    return clampf(score, 0, 1);\n  }\n\n  static receive(\n    settings: FirstTouchSettings,\n    mode: number,\n    quality: number,\n    facing: Vector2,\n    ballVelocity: Vector3,\n    ballSpin: Vector3 = Vector3.ZERO,\n    errorBias = 0,\n  ): FirstTouchResult {\n    const q = clampf(quality, 0, 1);\n    const ground = new Vector2(ballVelocity.x, ballVelocity.z);\n    const speed = ground.length();\n    const direction = speed > 0.0001 ? ground.normalized() : Vector2.ZERO;\n\n    let outgoing = Vector2.ZERO;\n    if (mode === TouchMode.KNOCK_ON && facing.length() > 0.0001) {\n      const push = settings.knock_on_speed * (0.4 + 0.6 * q);\n      outgoing = facing.normalized().mul(push);\n    } else {\n      let retention = lerpf(settings.retention_poor, settings.retention_good, q);\n      if (mode === TouchMode.KILL) retention *= settings.kill_multiplier;\n      outgoing = direction.mul(speed * retention);\n    }\n\n    // Mis-control: perpendicular-and-add (no trig) keeps this exact everywhere.\n    if (direction.length() > 0.0001) {\n      const lateral = new Vector2(-direction.y, direction.x);\n      outgoing = outgoing.add(lateral.mul(errorBias * settings.max_error * (1 - q)));\n    }\n\n    // Receiving flattens the ball and scrubs spin in proportion to quality.\n    const vertical = minf(ballVelocity.y * (1 - q), ballVelocity.y);\n    const spin = ballSpin.mul(1 - q);\n    return new FirstTouchResult(new Vector3(outgoing.x, vertical, outgoing.y), spin, q, mode);\n  }\n\n  static mode_from_input(value: number): number {\n    if (value === TouchMode.KILL) return TouchMode.KILL;\n    if (value === TouchMode.KNOCK_ON) return TouchMode.KNOCK_ON;\n    return TouchMode.CUSHION;\n  }\n\n  static mode_name(mode: number): string {\n    if (mode === TouchMode.KILL) return \"kill\";\n    if (mode === TouchMode.KNOCK_ON) return \"knock_on\";\n    return \"cushion\";\n  }\n}\n","src/sim/input_provider.ts":"// InputProvider - the input abstraction feeding MatchSim.\n//\n// Every input source (local pads, network peers, AI bots, recorded replays)\n// implements `collect(sim)` and returns a per-tick Map keyed by player id. The\n// sim stays agnostic about where inputs come from - it receives one merged Map\n// per tick. Each input entry is a PlayerInput (see the plan's input contract):\n//   move: Vector2 (desired ground-plane direction, magnitude <= 1)\n//   aim: Vector2 (desired facing; zero means \"keep current facing\")\n//   sprint: boolean, kick: boolean\n//   kick_type: number (KickType: 0 PASS, 1 SHOT, 2 LOB)\n//   kick_power: number (0..1 button-hold charge)\n//   touch_mode: number (TouchMode: 0 CUSHION, 1 KILL, 2 KNOCK_ON - applied\n//     when receiving rather than striking)\nimport { KickType } from \"./kick.ts\";\nimport { TouchMode } from \"./first_touch.ts\";\nimport type { PlayerState } from \"./player_state.ts\";\nimport { Vector2, clampf, maxf } from \"./vec.ts\";\n\nexport type PlayerInput = {\n  move: Vector2;\n  aim: Vector2;\n  sprint: boolean;\n  kick: boolean;\n  kick_type: number;\n  kick_power: number;\n  touch_mode: number;\n};\n\nexport type InputMap = Map<number, PlayerInput>;\n\n// Deep copy of one input entry (GDScript Dictionary.duplicate(true)).\nexport function clone_input(input: PlayerInput): PlayerInput {\n  const copy = { ...input } as PlayerInput;\n  if (input.move instanceof Vector2) copy.move = input.move.copy();\n  if (input.aim instanceof Vector2) copy.aim = input.aim.copy();\n  return copy;\n}\n\nexport function clone_inputs(inputs: InputMap): InputMap {\n  const out: InputMap = new Map();\n  for (const [id, input] of inputs) out.set(id, clone_input(input));\n  return out;\n}\n\nexport class InputProvider {\n  // Player ids this provider is responsible for. Empty means \"all\".\n  player_ids: number[];\n\n  constructor(ids: number[] = []) {\n    this.player_ids = ids;\n  }\n\n  // Override: return a Map { player_id: input } for owned players.\n  collect(_sim: any): InputMap {\n    return new Map();\n  }\n\n  static make_input(\n    move: Vector2,\n    sprint = false,\n    kick = false,\n    aim: Vector2 = Vector2.ZERO,\n    kickType: number = KickType.PASS,\n    kickPower = 1.0,\n    touchMode: number = TouchMode.CUSHION,\n  ): PlayerInput {\n    if (move.length() > 1) move = move.normalized();\n    if (aim.length() > 1) aim = aim.normalized();\n    return {\n      move,\n      aim,\n      sprint,\n      kick,\n      kick_type: kickType,\n      kick_power: clampf(kickPower, 0, 1),\n      touch_mode: touchMode,\n    };\n  }\n\n  static idle(): PlayerInput {\n    return InputProvider.make_input(Vector2.ZERO, false, false);\n  }\n}\n\n// AI bot: chases the ball with the nearest player, holds formation with the\n// rest, and requests a kick toward the opponent goal when in control range.\n// All randomness is drawn from the sim's seeded RNG so matches stay reproducible.\nexport class AiProvider extends InputProvider {\n  team: number;\n\n  constructor(teamId: number, ids: number[] = []) {\n    super(ids);\n    this.team = teamId;\n  }\n\n  collect(sim: any): InputMap {\n    const out: InputMap = new Map();\n    const owned = this.owned_players(sim);\n    if (owned.length === 0) return out;\n    const ballPos = new Vector2(sim.ball.position.x, sim.ball.position.z);\n    const chaser = this.nearest_to_ball(owned, ballPos);\n    const jitter = sim.config.get_float(\"ai\", \"chase_jitter\", 0.1);\n    const control = sim.control_radius() + sim.ball_radius();\n    for (const p of owned) {\n      if (p === chaser) {\n        let dir = ballPos.sub(p.position);\n        dir = dir.add(new Vector2(sim.rng.jitter(jitter), sim.rng.jitter(jitter)));\n        const sprint = p.position.distanceTo(ballPos) > 4.0;\n        const kick = p.position.distanceTo(ballPos) <= control;\n        // The chaser aims at the target goal while steering toward the ball.\n        const goal: Vector2 = sim.opponent_goal_center(this.team);\n        const aim = goal.sub(p.position);\n        // Shoot when the goal is in range, otherwise play a pass upfield.\n        const goalDistance = p.position.distanceTo(goal);\n        const shootRange = sim.config.get_float(\"ai\", \"shoot_range\", 14.0);\n        let kickType: number = KickType.PASS;\n        let kickPower = 0.6;\n        if (goalDistance <= shootRange) {\n          kickType = KickType.SHOT;\n          kickPower = clampf(goalDistance / maxf(shootRange, 0.001), 0.35, 1.0);\n        }\n        out.set(p.id, InputProvider.make_input(dir, sprint, kick, aim, kickType, kickPower));\n      } else {\n        // Off the ball: run to the formation anchor while watching the ball.\n        out.set(p.id, InputProvider.make_input(p.home.sub(p.position), false, false, ballPos.sub(p.position)));\n      }\n    }\n    return out;\n  }\n\n  owned_players(sim: any): PlayerState[] {\n    return sim.players.filter((p: PlayerState) => p.team === this.team\n      && (this.player_ids.length === 0 || this.player_ids.includes(p.id)));\n  }\n\n  nearest_to_ball(owned: PlayerState[], ballPos: Vector2): PlayerState {\n    let best = owned[0];\n    let bestD = best.position.distanceSquaredTo(ballPos);\n    for (const p of owned) {\n      const d = p.position.distanceSquaredTo(ballPos);\n      if (d < bestD) {\n        bestD = d;\n        best = p;\n      }\n    }\n    return best;\n  }\n}\n\n// Scripted/local provider: replays a fixed input per player, or a per-tick\n// table keyed by tick. Stands in for local gamepads and recorded-input replays.\nexport class ScriptedProvider extends InputProvider {\n  script_inputs: InputMap = new Map();\n  per_tick: Map<number, InputMap> = new Map();\n\n  collect(sim: any): InputMap {\n    const table = this.per_tick.get(sim.tick_count);\n    return clone_inputs(table !== undefined ? table : this.script_inputs);\n  }\n}\n\n// Network provider (Phase 3 stub): serves inputs pushed by remote peers for a\n// given tick, defaulting to idle when a packet has not arrived yet.\nexport class NetworkProvider extends InputProvider {\n  private buffer: Map<number, InputMap> = new Map();\n\n  push(tick: number, inputs: InputMap): void {\n    this.buffer.set(tick, inputs);\n  }\n\n  collect(sim: any): InputMap {\n    const buffered = this.buffer.get(sim.tick_count);\n    if (buffered !== undefined) return buffered;\n    const out: InputMap = new Map();\n    for (const pid of this.player_ids) out.set(pid, InputProvider.idle());\n    return out;\n  }\n}\n","src/sim/kick.ts":"// Kick - pure impulse + spin model for striking the ball (task 1.3).\n//\n// Three mechanics, one model. Each produces a horizontal impulse, a vertical\n// loft, and a spin vector; the differences are entirely in the tuning bands:\n//   PASS - grounded and accurate; power interpolates speed between\n//          pass.speed_min and pass.speed_max (the \"weighted pass\").\n//   SHOT - power-hold strike: highest speed band, low loft, topspin (dips).\n//   LOB  - lifted ball: highest loft, lowest speed, backspin (floats).\n//\n// Spin model (BallPhysics applies Magnus as magnus_coeff * (omega x v)):\n// - Sidespin (omega along +Y) curves the ball left/right. It comes from the\n//   approach angle: the signed lateral component of the striker's velocity\n//   relative to the kick direction (2D cross product), scaled by\n//   approach_spin_factor, plus a caller-supplied bias, clamped to max_side_spin.\n// - Top/backspin (omega along up x travel) gives a purely vertical force:\n//   axial_spin > 0 dips, < 0 floats.\n//\n// `build` itself performs no randomness: the caller supplies the seeded bias.\nimport { Vector2, Vector3, clampf, lerpf } from \"./vec.ts\";\n\nexport const KickType = { PASS: 0, SHOT: 1, LOB: 2 } as const;\n\nconst UP = new Vector3(0, 1, 0);\n\n// Per-mechanic tuning band, built by MatchSim from tuning JSON.\nexport class KickProfile {\n  speed_min: number;\n  speed_max: number;\n  loft_min: number;\n  loft_max: number;\n  // Spin about the across-travel axis: > 0 topspin (dips), < 0 backspin.\n  axial_spin: number;\n\n  constructor(speedMin: number, speedMax: number, loftMin: number, loftMax: number, axialSpin: number) {\n    this.speed_min = speedMin;\n    this.speed_max = speedMax;\n    this.loft_min = loftMin;\n    this.loft_max = loftMax;\n    this.axial_spin = axialSpin;\n  }\n}\n\n// Resulting impulse for one strike: a world-space ball velocity plus spin.\nexport class KickImpulse {\n  velocity: Vector3;\n  angular_velocity: Vector3;\n\n  constructor(velocity: Vector3, angularVelocity: Vector3) {\n    this.velocity = velocity;\n    this.angular_velocity = angularVelocity;\n  }\n}\n\nexport class Kick {\n  // `direction` is the aim (need not be normalised). `power` is the 0..1\n  // charge. `strikerVelocity` is the player's ground-plane velocity.\n  static build(\n    profile: KickProfile,\n    direction: Vector2,\n    power: number,\n    strikerVelocity: Vector2,\n    approachSpinFactor: number,\n    maxSideSpin: number,\n    sideSpinBias = 0,\n  ): KickImpulse {\n    const charge = clampf(power, 0, 1);\n    const dir = direction.normalized();\n    const speed = lerpf(profile.speed_min, profile.speed_max, charge);\n    const loft = lerpf(profile.loft_min, profile.loft_max, charge);\n\n    const lateral = dir.cross(strikerVelocity);\n    const sideSpin = clampf(lateral * approachSpinFactor + sideSpinBias, -maxSideSpin, maxSideSpin);\n\n    const travel = new Vector3(dir.x, 0, dir.y);\n    const spin = UP.mul(sideSpin).add(UP.cross(travel).mul(profile.axial_spin));\n    return new KickImpulse(new Vector3(dir.x * speed, loft, dir.y * speed), spin);\n  }\n\n  // Map an input's requested kick type onto KickType, defaulting to PASS.\n  static type_from_input(value: number): number {\n    if (value === KickType.SHOT) return KickType.SHOT;\n    if (value === KickType.LOB) return KickType.LOB;\n    return KickType.PASS;\n  }\n\n  // Human-readable name for match-log events.\n  static type_name(kickType: number): string {\n    if (kickType === KickType.SHOT) return \"shot\";\n    if (kickType === KickType.LOB) return \"lob\";\n    return \"pass\";\n  }\n}\n","src/sim/locomotion.ts":"// Locomotion - pure player movement, stamina, and decoupled-aim integrator (task 1.2).\n//\n// Stateless transforms of a PlayerState plus caller-supplied constants (all\n// sourced from tuning JSON by MatchSim), stepped at the fixed tick.\n//\n// Two independent layers per tick, matching the two analog sticks:\n//   - Movement: `moveInput` (magnitude <= 1) scales speed continuously;\n//     `sprintRequested` raises the top speed by `sprintMultiplier` but only\n//     while `stamina` is above `staminaSprintMin`. Sprinting drains stamina\n//     (points per second); otherwise it recovers, capped at `staminaMax`.\n//   - Aim: `aimInput` drives `facing`, turning toward the aim direction at a\n//     bounded `turnRate` (rad/s), decoupled from velocity. A zero aim input\n//     leaves `facing` unchanged.\nimport { PlayerState } from \"./player_state.ts\";\nimport { Vector2, clampf, maxf, minf, wrapf } from \"./vec.ts\";\n\nexport class Locomotion {\n  static update(\n    player: PlayerState,\n    moveInput: Vector2,\n    aimInput: Vector2,\n    sprintRequested: boolean,\n    dt: number,\n    maxSpeed: number,\n    sprintMultiplier: number,\n    acceleration: number,\n    turnRate: number,\n    staminaMax: number,\n    staminaDrainRate: number,\n    staminaRecoveryRate: number,\n    staminaSprintMin: number,\n  ): void {\n    Locomotion.update_movement(\n      player, moveInput, sprintRequested, dt,\n      maxSpeed, sprintMultiplier, acceleration,\n      staminaMax, staminaDrainRate, staminaRecoveryRate, staminaSprintMin,\n    );\n    Locomotion.update_aim(player, aimInput, turnRate, dt);\n  }\n\n  static update_movement(\n    player: PlayerState,\n    moveInput: Vector2,\n    sprintRequested: boolean,\n    dt: number,\n    maxSpeed: number,\n    sprintMultiplier: number,\n    acceleration: number,\n    staminaMax: number,\n    staminaDrainRate: number,\n    staminaRecoveryRate: number,\n    staminaSprintMin: number,\n  ): void {\n    const moveMagnitude = clampf(moveInput.length(), 0, 1);\n    let moveDirection = Vector2.ZERO;\n    if (moveInput.length() > 0.0001) moveDirection = moveInput.normalized();\n\n    const canSprint = sprintRequested && player.stamina > staminaSprintMin;\n    const topSpeed = maxSpeed * (canSprint ? sprintMultiplier : 1);\n    // Analog speed: the stick's own magnitude scales the target speed.\n    const desiredVelocity = moveDirection.mul(moveMagnitude * topSpeed);\n\n    player.velocity = player.velocity.moveToward(desiredVelocity, acceleration * dt);\n    player.position = player.position.add(player.velocity.mul(dt));\n\n    player.sprinting = canSprint && moveMagnitude > 0.01;\n    if (player.sprinting) {\n      player.stamina = maxf(0, player.stamina - staminaDrainRate * dt);\n    } else {\n      player.stamina = minf(staminaMax, player.stamina + staminaRecoveryRate * dt);\n    }\n  }\n\n  static update_aim(player: PlayerState, aimInput: Vector2, turnRate: number, dt: number): void {\n    if (aimInput.length() <= 0.0001) {\n      // Decoupled aim: no stick input means \"keep looking where I was\".\n      return;\n    }\n    const targetDirection = aimInput.normalized();\n    const currentAngle = player.facing.angle();\n    const targetAngle = targetDirection.angle();\n    const deltaAngle = wrapf(targetAngle - currentAngle, -Math.PI, Math.PI);\n    const maxStep = turnRate * dt;\n    const step = clampf(deltaAngle, -maxStep, maxStep);\n    player.facing = player.facing.rotated(step).normalized();\n  }\n}\n","src/sim/match_log.ts":"// MatchLog - replay / match-log recorder for MatchSim.\n//\n// Emits the match as JSON Lines: a header describing the seeded run, event and\n// snapshot records during play, and a summary footer. This is the seam the\n// golden-replay determinism check reads from. Records are plain objects and\n// are only serialised on output.\nexport class MatchLog {\n  records: Record<string, unknown>[] = [];\n\n  record(entry: Record<string, unknown>): void {\n    this.records.push(entry);\n  }\n\n  header(seed: number, ticks: number, tickHz: number, players: any[]): void {\n    const roster = players.map((p) => ({ id: p.id, team: p.team, role: p.role }));\n    this.record({ type: \"header\", seed, ticks, tick_hz: tickHz, players: roster });\n  }\n\n  snapshot(sim: any): void {\n    this.record({\n      type: \"snapshot\",\n      tick: sim.tick_count,\n      ball: sim.ball.to_dict(),\n      players: sim.players.map((p: any) => p.to_dict()),\n      score: { ...sim.score },\n    });\n  }\n\n  event(tick: number, name: string, data: Record<string, unknown> = {}): void {\n    const entry: Record<string, unknown> = { type: \"event\", tick, event: name };\n    for (const key of Object.keys(data)) entry[key] = data[key];\n    this.record(entry);\n  }\n\n  footer(sim: any): void {\n    this.record({\n      type: \"footer\",\n      final_tick: sim.tick_count,\n      score: { ...sim.score },\n      possession_ticks: { ...sim.possession_ticks },\n      state_digest: sim.state_digest(),\n    });\n  }\n\n  // Serialise every record to newline-delimited JSON.\n  to_jsonl(): string {\n    return this.records.map((entry) => JSON.stringify(entry)).join(\"\\n\");\n  }\n}\n","src/sim/match_sim.ts":"// MatchSim - deterministic, headless-runnable simulation core.\n//\n// MatchSim owns all gameplay state (players, ball, score) and is advanced by\n// fixed-tick calls to `tick()`. It is PURE and DETERMINISTIC: no rendering, no\n// reads of presentation state, and no unseeded randomness (all random draws go\n// through the seeded `SimRng`).\n//\n// Coordinate frame: X runs goal-to-goal (length), Z runs touchline-to-touchline\n// (width); players live on that ground plane (Vector2 x = X, y = Z), the ball\n// adds height Y. Team 0 attacks +X, team 1 attacks -X. Every numeric constant is\n// read from the tuning JSON via MatchConfig.\n//\n// The scaffold establishes the fixed-tick loop, entity state and input plumbing.\n// Ball aerodynamics (task 1.1, BallPhysics), player locomotion (task 1.2,\n// Locomotion), kick mechanics (task 1.3, Kick) and first touch (task 1.4,\n// FirstTouch) plug into it.\nimport { BallPhysics } from \"./ball_physics.ts\";\nimport { BallState } from \"./ball_state.ts\";\nimport { FirstTouch, FirstTouchSettings, TouchMode } from \"./first_touch.ts\";\nimport type { InputMap, InputProvider, PlayerInput } from \"./input_provider.ts\";\nimport { Kick, KickProfile, KickType } from \"./kick.ts\";\nimport { Locomotion } from \"./locomotion.ts\";\nimport { MatchConfig, type Tuning } from \"./match_config.ts\";\nimport { PlayerState } from \"./player_state.ts\";\nimport { SimRng } from \"./sim_rng.ts\";\nimport { Vector2, Vector3, clampf, maxi, snappedf } from \"./vec.ts\";\n\nexport const TICK_HZ = 60;\nexport const TICK_DELTA = 1.0 / TICK_HZ;\n\nexport type SimEvent = Record<string, unknown> & { event: string };\n\nexport class MatchSim {\n  config: MatchConfig;\n  rng: SimRng;\n  ball: BallState;\n  players: PlayerState[] = [];\n  score: Record<number, number> = { 0: 0, 1: 0 };\n  possession_ticks: Record<number, number> = { 0: 0, 1: 0 };\n  tick_count = 0;\n  last_toucher_team = -1;\n\n  // Cached tuning (pulled once so the hot loop avoids lookups).\n  private _tick_delta = TICK_DELTA;\n  private _team_size = 3;\n  private _half_length = 20;\n  private _half_width = 12.5;\n  private _goal_half_width = 3.5;\n  private _goal_height = 2.5;\n  private _wall_restitution = 0.6;\n  private _ball_radius = 0.11;\n  private _gravity = 9.81;\n  private _linear_drag = 0.15;\n  private _magnus_coefficient = 0.12;\n  private _spin_drag = 0.6;\n  private _ground_restitution = 0.55;\n  private _ground_friction = 2.5;\n  private _rest_speed = 0.05;\n  private _ball_max_speed = 45;\n  private _spawn_height = 0.11;\n  private _player_radius = 0.4;\n  private _player_max_speed = 7;\n  private _sprint_multiplier = 1.35;\n  private _acceleration = 30;\n  private _turn_rate = 12;\n  private _stamina_max = 100;\n  private _stamina_drain_rate = 25;\n  private _stamina_recovery_rate = 15;\n  private _stamina_sprint_min = 5;\n  private _control_radius = 1;\n  private _reach_height = 1.6;\n  private _touch_cooldown = 8;\n  private _kickoff_reset_ticks = 45;\n  private _kickoff_team = 0;\n  private _formation_depth = 8;\n  private _formation_spread = 6;\n  private _kick_profiles: Map<number, KickProfile> = new Map();\n  private _approach_spin_factor = 1.2;\n  private _max_side_spin = 14;\n  private _side_spin_jitter = 0.6;\n  private _first_touch: FirstTouchSettings = new FirstTouchSettings();\n  private _first_touch_error_jitter = 1.0;\n\n  constructor(seedValue = 0, configSource: MatchConfig | Tuning | null = null) {\n    this.config = configSource instanceof MatchConfig ? configSource : new MatchConfig(configSource);\n    this.rng = new SimRng(seedValue);\n    this._cache_tuning();\n    this.ball = new BallState();\n    this._spawn_players();\n    this.kickoff();\n  }\n\n  private _cache_tuning(): void {\n    const c = this.config;\n    this._tick_delta = 1.0 / c.get_int(\"match\", \"tick_hz\", TICK_HZ);\n    this._team_size = c.get_int(\"match\", \"team_size\", 3);\n    this._half_length = c.get_float(\"pitch\", \"length\", 40.0) * 0.5;\n    this._half_width = c.get_float(\"pitch\", \"width\", 25.0) * 0.5;\n    this._goal_half_width = c.get_float(\"pitch\", \"goal_width\", 7.0) * 0.5;\n    this._goal_height = c.get_float(\"pitch\", \"goal_height\", 2.5);\n    this._wall_restitution = c.get_float(\"pitch\", \"wall_restitution\", 0.6);\n    this._ball_radius = c.get_float(\"ball\", \"radius\", 0.11);\n    this._gravity = c.get_float(\"ball\", \"gravity\", 9.81);\n    this._linear_drag = c.get_float(\"ball\", \"linear_drag\", 0.15);\n    this._magnus_coefficient = c.get_float(\"ball\", \"magnus_coefficient\", 0.12);\n    this._spin_drag = c.get_float(\"ball\", \"spin_drag\", 0.6);\n    this._ground_restitution = c.get_float(\"ball\", \"ground_restitution\", 0.55);\n    this._ground_friction = c.get_float(\"ball\", \"ground_friction\", 2.5);\n    this._rest_speed = c.get_float(\"ball\", \"rest_speed\", 0.05);\n    this._ball_max_speed = c.get_float(\"ball\", \"max_speed\", 45.0);\n    this._spawn_height = c.get_float(\"ball\", \"spawn_height\", this._ball_radius);\n    this._player_radius = c.get_float(\"player\", \"radius\", 0.4);\n    this._player_max_speed = c.get_float(\"player\", \"max_speed\", 7.0);\n    this._sprint_multiplier = c.get_float(\"player\", \"sprint_multiplier\", 1.35);\n    this._acceleration = c.get_float(\"player\", \"acceleration\", 30.0);\n    this._turn_rate = c.get_float(\"player\", \"turn_rate_rad\", 12.0);\n    this._stamina_max = c.get_float(\"player\", \"stamina_max\", 100.0);\n    this._stamina_drain_rate = c.get_float(\"player\", \"stamina_drain_rate\", 25.0);\n    this._stamina_recovery_rate = c.get_float(\"player\", \"stamina_recovery_rate\", 15.0);\n    this._stamina_sprint_min = c.get_float(\"player\", \"stamina_sprint_min\", 5.0);\n    this._control_radius = c.get_float(\"player\", \"control_radius\", 1.0);\n    this._reach_height = c.get_float(\"player\", \"reach_height\", 1.6);\n    this._touch_cooldown = c.get_int(\"player\", \"touch_cooldown_ticks\", 8);\n    this._kickoff_reset_ticks = c.get_int(\"match\", \"kickoff_reset_ticks\", 45);\n    this._formation_depth = c.get_float(\"ai\", \"formation_depth\", 8.0);\n    this._formation_spread = c.get_float(\"ai\", \"formation_spread\", 6.0);\n    this._cache_kick_tuning();\n  }\n\n  private _cache_kick_tuning(): void {\n    this._kick_profiles = new Map([\n      [KickType.PASS, this._kick_profile(\"pass\", 6.0, 16.0, 0.0, 0.6, 2.0)],\n      [KickType.SHOT, this._kick_profile(\"shot\", 14.0, 30.0, 0.8, 3.2, 6.0)],\n      [KickType.LOB, this._kick_profile(\"lob\", 5.0, 13.0, 4.0, 8.0, -4.0)],\n    ]);\n    this._approach_spin_factor = this.config.get_float(\"kick\", \"approach_spin_factor\", 1.2);\n    this._max_side_spin = this.config.get_float(\"kick\", \"max_side_spin\", 14.0);\n    this._side_spin_jitter = this.config.get_float(\"kick\", \"side_spin_jitter\", 0.6);\n    this._cache_first_touch_tuning();\n  }\n\n  private _cache_first_touch_tuning(): void {\n    const c = this.config;\n    const s = new FirstTouchSettings();\n    s.trigger_speed = c.get_float(\"first_touch\", \"trigger_speed\", s.trigger_speed);\n    s.retention_poor = c.get_float(\"first_touch\", \"retention_poor\", s.retention_poor);\n    s.retention_good = c.get_float(\"first_touch\", \"retention_good\", s.retention_good);\n    s.kill_multiplier = c.get_float(\"first_touch\", \"kill_multiplier\", s.kill_multiplier);\n    s.knock_on_speed = c.get_float(\"first_touch\", \"knock_on_speed\", s.knock_on_speed);\n    s.max_error = c.get_float(\"first_touch\", \"max_error\", s.max_error);\n    s.reference_ball_speed = c.get_float(\"first_touch\", \"reference_ball_speed\", s.reference_ball_speed);\n    s.weight_orientation = c.get_float(\"first_touch\", \"weight_orientation\", s.weight_orientation);\n    s.weight_closing_speed = c.get_float(\"first_touch\", \"weight_closing_speed\", s.weight_closing_speed);\n    s.weight_ball_speed = c.get_float(\"first_touch\", \"weight_ball_speed\", s.weight_ball_speed);\n    s.sprint_penalty = c.get_float(\"first_touch\", \"sprint_penalty\", s.sprint_penalty);\n    s.cooldown_ticks = c.get_int(\"first_touch\", \"cooldown_ticks\", s.cooldown_ticks);\n    this._first_touch = s;\n    this._first_touch_error_jitter = c.get_float(\"first_touch\", \"error_jitter\", 1.0);\n  }\n\n  // One mechanic's tuning band: the `kick` section nests an object per\n  // mechanic; fall back per key for partial tuning.\n  private _kick_profile(\n    name: string, speedMin: number, speedMax: number, loftMin: number, loftMax: number, axialSpin: number,\n  ): KickProfile {\n    const raw = this.config.get_value(\"kick\", name, {});\n    const band = (raw !== null && typeof raw === \"object\" ? raw : {}) as Record<string, unknown>;\n    const pick = (key: string, fallback: number) => Number(key in band ? band[key] : fallback);\n    return new KickProfile(\n      pick(\"speed_min\", speedMin), pick(\"speed_max\", speedMax),\n      pick(\"loft_min\", loftMin), pick(\"loft_max\", loftMax), pick(\"axial_spin\", axialSpin),\n    );\n  }\n\n  private _spawn_players(): void {\n    this.players = [];\n    let nextId = 0;\n    for (const team of [0, 1]) {\n      const dir = team === 0 ? 1.0 : -1.0;\n      for (let role = 0; role < this._team_size; role += 1) {\n        const p = new PlayerState();\n        p.id = nextId;\n        p.team = team;\n        p.role = role;\n        // Fan players across their defensive half; role 0 sits deepest.\n        const lane = this._team_size <= 1 ? 0.0 : (role / (this._team_size - 1) - 0.5) * 2.0;\n        const depth = -dir * this._formation_depth * (1.0 - role / maxi(this._team_size, 1));\n        p.home = new Vector2(depth, lane * this._formation_spread);\n        p.facing = new Vector2(dir, 0.0);\n        p.stamina = this._stamina_max;\n        this.players.push(p);\n        nextId += 1;\n      }\n    }\n  }\n\n  // Reset ball to centre and players to their formation anchors (start /\n  // post-goal). `kickTeam` takes the kickoff: opponents are held by a short\n  // standoff cooldown. Passing -1 keeps the current kickoff team.\n  kickoff(kickTeam = -1): void {\n    if (kickTeam >= 0) this._kickoff_team = kickTeam;\n    this.ball.reset(this._spawn_height);\n    for (const p of this.players) {\n      p.position = p.home.copy();\n      p.velocity = Vector2.ZERO;\n      p.touch_cooldown = p.team === this._kickoff_team ? 0 : this._kickoff_reset_ticks;\n    }\n    this.last_toucher_team = -1;\n  }\n\n  // --- Read-only helpers used by input providers ---------------------------\n\n  opponent_goal_center(team: number): Vector2 {\n    return new Vector2(team === 0 ? this._half_length : -this._half_length, 0.0);\n  }\n\n  control_radius(): number {\n    return this._control_radius;\n  }\n\n  ball_radius(): number {\n    return this._ball_radius;\n  }\n\n  // Merge inputs from every provider into one per-tick Map (later providers win).\n  gather_inputs(providers: InputProvider[]): InputMap {\n    const merged: InputMap = new Map();\n    for (const provider of providers) {\n      for (const [pid, input] of provider.collect(this)) merged.set(pid, input);\n    }\n    return merged;\n  }\n\n  // Convenience: gather inputs from providers then advance one tick.\n  advance(providers: InputProvider[], delta = -1.0): SimEvent[] {\n    return this.tick(this.gather_inputs(providers), delta);\n  }\n\n  // Advance the simulation exactly one fixed tick. Pure: same (state, inputs)\n  // in -> same state out. Returns the discrete events that fired this tick.\n  tick(inputs: InputMap, delta = -1.0): SimEvent[] {\n    const dt = delta <= 0.0 ? this._tick_delta : delta;\n    const events: SimEvent[] = [];\n    this._update_players(inputs, dt);\n    this._resolve_touches(inputs, events);\n    this._integrate_ball(dt);\n    this._resolve_bounds(events);\n    this._track_possession();\n    this.tick_count += 1;\n    return events;\n  }\n\n  private _update_players(inputs: InputMap, dt: number): void {\n    for (const p of this.players) {\n      if (p.touch_cooldown > 0) p.touch_cooldown -= 1;\n      let move = Vector2.ZERO;\n      let aim = Vector2.ZERO;\n      let sprint = false;\n      const cmd = inputs.get(p.id);\n      if (cmd !== undefined) {\n        move = cmd.move ?? Vector2.ZERO;\n        aim = cmd.aim ?? Vector2.ZERO;\n        sprint = Boolean(cmd.sprint ?? false);\n      }\n      Locomotion.update(\n        p, move, aim, sprint, dt,\n        this._player_max_speed, this._sprint_multiplier, this._acceleration, this._turn_rate,\n        this._stamina_max, this._stamina_drain_rate, this._stamina_recovery_rate, this._stamina_sprint_min,\n      );\n      this._clamp_to_pitch(p);\n    }\n  }\n\n  private _clamp_to_pitch(p: PlayerState): void {\n    const lx = this._half_length - this._player_radius;\n    const lz = this._half_width - this._player_radius;\n    p.position = new Vector2(clampf(p.position.x, -lx, lx), clampf(p.position.y, -lz, lz));\n  }\n\n  private _resolve_touches(inputs: InputMap, events: SimEvent[]): void {\n    // The player closest to the ball wins the touch; ties break by id so the\n    // result stays deterministic, but distance decides first.\n    if (this.ball.position.y > this._reach_height) return;\n    const ballGround = new Vector2(this.ball.position.x, this.ball.position.z);\n    const reach = this._control_radius + this._ball_radius + this._player_radius;\n    let winner: PlayerState | null = null;\n    let winnerDistance = Infinity;\n    for (const p of this.players) {\n      if (p.touch_cooldown > 0) continue;\n      if (!inputs.has(p.id)) continue;\n      const distance = p.position.distanceTo(ballGround);\n      if (distance > reach) continue;\n      if (distance < winnerDistance) {\n        winner = p;\n        winnerDistance = distance;\n      }\n    }\n    if (winner === null) return;\n    const cmd = inputs.get(winner.id) as PlayerInput;\n    if (Boolean(cmd.kick ?? false)) {\n      this._kick_ball(winner, cmd, events);\n      this._commit_challengers(winner, ballGround, reach);\n    } else {\n      this._receive_ball(winner, cmd, events);\n    }\n  }\n\n  // Receive a moving ball (task 1.4). A player in the ball's path who is not\n  // striking it still meets it, through the FirstTouch model. A ball already\n  // trickling below `trigger_speed` needs no touch simulating.\n  private _receive_ball(p: PlayerState, cmd: PlayerInput, events: SimEvent[]): void {\n    const ground = new Vector2(this.ball.velocity.x, this.ball.velocity.z);\n    const speed = ground.length();\n    if (speed < this._first_touch.trigger_speed) return;\n    const mode = FirstTouch.mode_from_input(Math.trunc(Number(cmd.touch_mode ?? TouchMode.CUSHION)));\n    const quality = FirstTouch.quality_for(\n      this._first_touch, p.facing, p.velocity, ground.normalized(), speed,\n      this._player_max_speed, p.sprinting,\n    );\n    const result = FirstTouch.receive(\n      this._first_touch, mode, quality, p.facing, this.ball.velocity, this.ball.angular_velocity,\n      this.rng.jitter(this._first_touch_error_jitter),\n    );\n    this.ball.velocity = result.velocity;\n    this.ball.angular_velocity = result.angular_velocity;\n    p.touch_cooldown = this._first_touch.cooldown_ticks;\n    this.last_toucher_team = p.team;\n    events.push({\n      event: \"touch\",\n      player: p.id,\n      team: p.team,\n      touch: FirstTouch.mode_name(mode),\n      quality: snappedf(quality, 0.001),\n    });\n  }\n\n  // A challenge commits every player already contesting the ball (they lunged\n  // and were beaten), so the kick can't be instantly returned.\n  private _commit_challengers(kicker: PlayerState, ballGround: Vector2, reach: number): void {\n    for (const p of this.players) {\n      if (p === kicker) continue;\n      if (p.position.distanceTo(ballGround) <= reach) {\n        p.touch_cooldown = maxi(p.touch_cooldown, this._touch_cooldown);\n      }\n    }\n  }\n\n  // Strike the ball with whichever mechanic the input requested (task 1.3).\n  // Aim comes from the input when supplied, otherwise from the player's\n  // facing, otherwise toward the opponent goal. The seeded side-spin jitter is\n  // drawn here so Kick.build stays pure.\n  private _kick_ball(p: PlayerState, cmd: PlayerInput, events: SimEvent[]): void {\n    const kickType = Kick.type_from_input(Math.trunc(Number(cmd.kick_type ?? KickType.PASS)));\n    const power = clampf(Number(cmd.kick_power ?? 1.0), 0.0, 1.0);\n    let aim: Vector2 = cmd.aim ?? Vector2.ZERO;\n    if (aim.length() < 0.0001) aim = p.facing;\n    if (aim.length() < 0.0001) aim = this.opponent_goal_center(p.team).sub(p.position);\n    const profile = this._kick_profiles.get(kickType) as KickProfile;\n    const impulse = Kick.build(\n      profile, aim, power, p.velocity,\n      this._approach_spin_factor, this._max_side_spin,\n      this.rng.jitter(this._side_spin_jitter),\n    );\n    this.ball.velocity = impulse.velocity;\n    this.ball.angular_velocity = impulse.angular_velocity;\n    p.touch_cooldown = this._touch_cooldown;\n    this.last_toucher_team = p.team;\n    events.push({ event: \"kick\", player: p.id, team: p.team, kick: Kick.type_name(kickType), power });\n  }\n\n  private _integrate_ball(dt: number): void {\n    BallPhysics.apply_forces(this.ball, dt, this._gravity, this._linear_drag, this._magnus_coefficient, this._spin_drag);\n    BallPhysics.resolve_ground_contact(\n      this.ball, dt, this._ball_radius, this._ground_restitution, this._ground_friction, this._rest_speed,\n    );\n    BallPhysics.clamp_speed(this.ball, this._ball_max_speed);\n  }\n\n  private _resolve_bounds(events: SimEvent[]): void {\n    const maxX = this._half_length - this._ball_radius;\n    const maxZ = this._half_width - this._ball_radius;\n    // End lines: goal if within the mouth, otherwise a cage-wall rebound.\n    if (Math.abs(this.ball.position.x) >= maxX) {\n      const attackingTeam = this.ball.position.x > 0.0 ? 0 : 1;\n      const inGoal = Math.abs(this.ball.position.z) < this._goal_half_width\n        && this.ball.position.y < this._goal_height;\n      if (inGoal) {\n        this._score_goal(attackingTeam, events);\n        return;\n      }\n      const pos = this.ball.position;\n      this.ball.position = new Vector3(clampf(pos.x, -maxX, maxX), pos.y, pos.z);\n      const xNormal = new Vector3(this.ball.position.x < 0.0 ? 1.0 : -1.0, 0.0, 0.0);\n      BallPhysics.bounce(this.ball, xNormal, this._wall_restitution);\n    }\n    // Touchline walls (cage rebound).\n    if (Math.abs(this.ball.position.z) >= maxZ) {\n      const pos = this.ball.position;\n      this.ball.position = new Vector3(pos.x, pos.y, clampf(pos.z, -maxZ, maxZ));\n      const zNormal = new Vector3(0.0, 0.0, this.ball.position.z < 0.0 ? 1.0 : -1.0);\n      BallPhysics.bounce(this.ball, zNormal, this._wall_restitution);\n    }\n  }\n\n  private _score_goal(team: number, events: SimEvent[]): void {\n    this.score[team] += 1;\n    events.push({ event: \"goal\", team, score: { ...this.score } });\n    // Conceding team restarts (real-football kickoff).\n    this.kickoff(1 - team);\n  }\n\n  private _track_possession(): void {\n    if (this.last_toucher_team >= 0) this.possession_ticks[this.last_toucher_team] += 1;\n  }\n\n  // Deterministic digest of the full sim state. Two runs with the same seed and\n  // inputs must produce identical digests - the basis of the golden-replay check.\n  state_digest(): number {\n    const parts: string[] = [];\n    parts.push(`t=${this.tick_count}`);\n    parts.push(`s=${this.score[0]}:${this.score[1]}`);\n    parts.push(MatchSim._quantize_vec3(this.ball.position));\n    parts.push(MatchSim._quantize_vec3(this.ball.velocity));\n    parts.push(MatchSim._quantize_vec3(this.ball.angular_velocity));\n    for (const p of this.players) {\n      parts.push(`${p.id}|${MatchSim._quantize_vec2(p.position)}|${MatchSim._quantize_vec2(p.velocity)}|`\n        + `${MatchSim._quantize_vec2(p.facing)}|${p.stamina.toFixed(4)}`);\n    }\n    return MatchSim._hash(parts.join(\"\\n\"));\n  }\n\n  // Godot String.hash(): djb2 over the string's code points, as uint32.\n  private static _hash(text: string): number {\n    let hash = 5381;\n    for (const ch of text) hash = (Math.imul(hash, 33) + (ch.codePointAt(0) as number)) >>> 0;\n    return hash;\n  }\n\n  private static _quantize_vec3(v: Vector3): string {\n    return `${v.x.toFixed(4)},${v.y.toFixed(4)},${v.z.toFixed(4)}`;\n  }\n\n  private static _quantize_vec2(v: Vector2): string {\n    return `${v.x.toFixed(4)},${v.y.toFixed(4)}`;\n  }\n\n  // Invariant check: all entity state is finite (no NaN/inf).\n  state_is_finite(): boolean {\n    if (!this.ball.has_finite_state()) return false;\n    return this.players.every((p) => p.has_finite_state());\n  }\n}\n","src/sim/player_state.ts":"// PlayerState - a footballer entity owned by MatchSim (pure state).\n//\n// Players live on the ground plane (X = length, Z = width); `position` and\n// `velocity` are Vector2 in that plane (vector .y is the world Z axis). `home`\n// is the AI formation anchor. `facing` is the player's aim / body-orientation\n// unit vector, driven independently of `velocity` (task 1.2's decoupled aim).\n// `stamina` fuels sprinting and is owned by Locomotion: it is measured in\n// stamina points on the same scale as the tuning's player.stamina_max.\nimport { Vector2 } from \"./vec.ts\";\n\nexport class PlayerState {\n  id = 0;\n  team = 0;\n  role = 0;\n  position = new Vector2();\n  velocity = new Vector2();\n  home = new Vector2();\n  facing = Vector2.RIGHT;\n  stamina = 1.0;\n  sprinting = false;\n  touch_cooldown = 0;\n\n  has_finite_state(): boolean {\n    return this.position.isFinite() && this.velocity.isFinite() && this.facing.isFinite()\n      && Number.isFinite(this.stamina);\n  }\n\n  to_dict(): Record<string, number | boolean> {\n    return {\n      id: this.id, team: this.team, role: this.role,\n      px: this.position.x, pz: this.position.y,\n      vx: this.velocity.x, vz: this.velocity.y,\n      fx: this.facing.x, fz: this.facing.y,\n      stamina: this.stamina, sprinting: this.sprinting,\n    };\n  }\n}\n"}
