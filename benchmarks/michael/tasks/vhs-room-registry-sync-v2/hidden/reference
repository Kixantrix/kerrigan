{"api/db.js":"/**\n * Database module for VHS Video Stack\n * Uses SQLite for persistent storage of rooms, users, and sessions\n */\n\nimport Database from './lib/sqlite.js';\nimport crypto from 'crypto';\nimport path from 'path';\nimport fs from 'fs';\nimport { fileURLToPath } from 'url';\nimport {\n  createLogicalClock,\n  exportSnapshot as exportSnapshotRecords,\n  applySnapshotToRecords,\n} from './sync.js';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\n// Database file: DB_PATH (compose mounts a persistent volume at /data), else ../data/vhs.db\nexport const dbPath = process.env.DB_PATH || path.join(__dirname, '..', 'data', 'vhs.db');\nconst dataDir = path.dirname(dbPath);\nif (!fs.existsSync(dataDir)) {\n  fs.mkdirSync(dataDir, { recursive: true });\n}\n\nconst db = new Database(dbPath);\n\n// Enable WAL mode for better performance\ndb.pragma('journal_mode = WAL');\n\n// Initialize schema\ndb.exec(`\n  CREATE TABLE IF NOT EXISTS users (\n    id TEXT PRIMARY KEY,\n    name TEXT NOT NULL,\n    email TEXT UNIQUE,\n    is_admin INTEGER DEFAULT 0,\n    can_create_rooms INTEGER DEFAULT 0,\n    created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n    updated_at TEXT DEFAULT CURRENT_TIMESTAMP\n  );\n  \n  CREATE TABLE IF NOT EXISTS rooms (\n    id TEXT PRIMARY KEY,\n    name TEXT UNIQUE NOT NULL,\n    display_name TEXT,\n    access_code TEXT NOT NULL,\n    created_by TEXT REFERENCES users(id),\n    enabled INTEGER DEFAULT 1,\n    created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n    updated_at TEXT DEFAULT CURRENT_TIMESTAMP,\n    updated_at_ms INTEGER DEFAULT 0,\n    deleted_at TEXT\n  );\n  \n  CREATE TABLE IF NOT EXISTS sessions (\n    id TEXT PRIMARY KEY,\n    user_id TEXT REFERENCES users(id),\n    magic_token TEXT UNIQUE,\n    created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n    last_used TEXT DEFAULT CURRENT_TIMESTAMP,\n    expires_at TEXT NOT NULL,\n    user_agent TEXT,\n    ip_address TEXT\n  );\n  \n  CREATE TABLE IF NOT EXISTS room_access (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id TEXT REFERENCES users(id),\n    room_id TEXT REFERENCES rooms(id),\n    session_id TEXT REFERENCES sessions(id),\n    first_joined_at TEXT DEFAULT CURRENT_TIMESTAMP,\n    last_joined_at TEXT DEFAULT CURRENT_TIMESTAMP,\n    join_count INTEGER DEFAULT 1,\n    UNIQUE(user_id, room_id)\n  );\n  \n  CREATE TABLE IF NOT EXISTS audit_log (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    event_type TEXT NOT NULL,\n    user_id TEXT,\n    room_id TEXT,\n    session_id TEXT,\n    details TEXT,\n    ip_address TEXT,\n    user_agent TEXT,\n    created_at TEXT DEFAULT CURRENT_TIMESTAMP\n  );\n  \n  CREATE INDEX IF NOT EXISTS idx_sessions_user ON sessions(user_id);\n  CREATE INDEX IF NOT EXISTS idx_sessions_magic_token ON sessions(magic_token);\n  CREATE INDEX IF NOT EXISTS idx_room_access_user ON room_access(user_id);\n  CREATE INDEX IF NOT EXISTS idx_audit_log_type ON audit_log(event_type);\n  CREATE INDEX IF NOT EXISTS idx_audit_log_user ON audit_log(user_id);\n  CREATE INDEX IF NOT EXISTS idx_audit_log_room ON audit_log(room_id);\n`);\n\n// ============ MIGRATIONS ============\n// Additive migrations for room-registry replication (hybrid hosting slice 1). Existing databases\n// created before these columns existed get them backfilled here; CREATE TABLE above covers fresh DBs.\nfunction ensureRoomSyncColumns() {\n  const cols = db.prepare(`PRAGMA table_info(rooms)`).all().map((c) => c.name);\n  if (!cols.includes('updated_at_ms')) {\n    db.exec(`ALTER TABLE rooms ADD COLUMN updated_at_ms INTEGER DEFAULT 0`);\n  }\n  if (!cols.includes('deleted_at')) {\n    db.exec(`ALTER TABLE rooms ADD COLUMN deleted_at TEXT`);\n  }\n  // Backfill a sane logical timestamp for pre-existing rooms from their second-granular updated_at\n  // so they participate in last-writer-wins with a deterministic ordering (older than any new edit).\n  db.prepare(\n    `UPDATE rooms\n       SET updated_at_ms = CAST(strftime('%s', COALESCE(updated_at, created_at, '1970-01-01')) AS INTEGER) * 1000\n     WHERE updated_at_ms IS NULL OR updated_at_ms = 0`\n  ).run();\n}\nensureRoomSyncColumns();\n\n// Process-wide monotonic logical clock for room edits, seeded past the largest timestamp already\n// stored so every new edit (and every applied remote record) advances it.\nconst maxRoomTs = db.prepare(`SELECT MAX(updated_at_ms) AS m FROM rooms`).get();\nconst roomClock = createLogicalClock(maxRoomTs && maxRoomTs.m ? Number(maxRoomTs.m) : Date.now());\n\n\n// Generate unique IDs\nexport function generateId(prefix = '') {\n  const id = crypto.randomBytes(12).toString('hex');\n  return prefix ? `${prefix}_${id}` : id;\n}\n\n// Generate magic link token\nexport function generateMagicToken() {\n  return crypto.randomBytes(32).toString('hex');\n}\n\n// Generate random passphrase (word-based)\nconst WORD_LIST = [\n  'apple', 'banana', 'cherry', 'dragon', 'eagle', 'forest', 'garden', 'harbor',\n  'island', 'jungle', 'kayak', 'lemon', 'mango', 'nature', 'ocean', 'piano',\n  'quartz', 'river', 'sunset', 'tiger', 'umbrella', 'valley', 'winter', 'xylophone',\n  'yellow', 'zebra', 'anchor', 'bridge', 'castle', 'desert', 'ember', 'falcon',\n  'glacier', 'horizon', 'iceberg', 'jupiter', 'kingdom', 'lantern', 'meadow', 'neptune',\n  'orchid', 'phoenix', 'quasar', 'rapids', 'summit', 'thunder', 'universe', 'volcano',\n  'whisper', 'xenon', 'yonder', 'zenith'\n];\n\nexport function generatePassphrase(wordCount = 3) {\n  const words = [];\n  for (let i = 0; i < wordCount; i++) {\n    const randomIndex = crypto.randomInt(0, WORD_LIST.length);\n    words.push(WORD_LIST[randomIndex]);\n  }\n  return words.join('-');\n}\n\n// ============ USER OPERATIONS ============\n\nconst createUserStmt = db.prepare(`\n  INSERT INTO users (id, name, email, is_admin, can_create_rooms, created_at, updated_at)\n  VALUES (?, ?, ?, ?, ?, datetime('now'), datetime('now'))\n`);\n\nconst getUserByIdStmt = db.prepare(`SELECT * FROM users WHERE id = ?`);\nconst getAllUsersStmt = db.prepare(`SELECT * FROM users ORDER BY created_at DESC`);\n\nexport function createUser({ name, email, isAdmin = false, canCreateRooms = false }) {\n  const id = generateId('user');\n  createUserStmt.run(id, name, email || null, isAdmin ? 1 : 0, canCreateRooms ? 1 : 0);\n  return getUserByIdStmt.get(id);\n}\n\nexport function getUserById(id) {\n  return getUserByIdStmt.get(id);\n}\n\nexport function getAllUsers() {\n  return getAllUsersStmt.all();\n}\n\n// ============ ROOM OPERATIONS ============\n\nconst createRoomStmt = db.prepare(`\n  INSERT INTO rooms (id, name, display_name, access_code, created_by, enabled, created_at, updated_at, updated_at_ms, deleted_at)\n  VALUES (?, ?, ?, ?, ?, 1, datetime('now'), datetime('now'), ?, NULL)\n`);\n\nconst getRoomByIdStmt = db.prepare(`SELECT * FROM rooms WHERE id = ?`);\nconst getRoomByNameStmt = db.prepare(`SELECT * FROM rooms WHERE name = ? AND enabled = 1 AND deleted_at IS NULL`);\nconst getRoomByNameAnyStmt = db.prepare(`SELECT * FROM rooms WHERE name = ?`);\nconst getAllRoomsStmt = db.prepare(`SELECT * FROM rooms ORDER BY created_at DESC`);\nconst getEnabledRoomsStmt = db.prepare(`SELECT * FROM rooms WHERE enabled = 1 AND deleted_at IS NULL ORDER BY created_at DESC`);\nconst getAllRoomsForSyncStmt = db.prepare(`SELECT * FROM rooms ORDER BY name`);\nconst updateRoomStmt = db.prepare(`\n  UPDATE rooms SET name = ?, display_name = ?, access_code = ?, enabled = ?, updated_at = datetime('now'), updated_at_ms = ?\n  WHERE id = ?\n`);\nconst softDeleteRoomStmt = db.prepare(`\n  UPDATE rooms SET enabled = 0, deleted_at = datetime('now'), updated_at = datetime('now'), updated_at_ms = ?\n  WHERE id = ?\n`);\nconst reviveRoomStmt = db.prepare(`\n  UPDATE rooms SET display_name = ?, access_code = ?, created_by = ?, enabled = 1, deleted_at = NULL, updated_at = datetime('now'), updated_at_ms = ?\n  WHERE name = ?\n`);\n\nexport function createRoom({ name, displayName, accessCode, createdBy }) {\n  const code = accessCode || generatePassphrase();\n  const ts = roomClock.next();\n\n  // If a row already exists for this name (e.g. a tombstone from a prior delete, or a disabled\n  // room), revive it in place instead of inserting \u2014 this preserves UNIQUE(name) and gives the\n  // re-creation a newer logical timestamp so it wins over the stale tombstone during sync.\n  const existing = getRoomByNameAnyStmt.get(name);\n  if (existing) {\n    reviveRoomStmt.run(displayName || name, code, createdBy ?? existing.created_by ?? null, ts, name);\n    return getRoomByNameAnyStmt.get(name);\n  }\n\n  const id = generateId('room');\n  createRoomStmt.run(id, name, displayName || name, code, createdBy, ts);\n  return getRoomByIdStmt.get(id);\n}\n\nexport function getRoomById(id) {\n  return getRoomByIdStmt.get(id);\n}\n\nexport function getRoomByName(name) {\n  return getRoomByNameStmt.get(name);\n}\n\nexport function getAllRooms() {\n  return getAllRoomsStmt.all();\n}\n\nexport function getEnabledRooms() {\n  return getEnabledRoomsStmt.all();\n}\n\nexport function updateRoom(id, { name, displayName, accessCode, enabled }) {\n  const room = getRoomByIdStmt.get(id);\n  if (!room) return null;\n  \n  updateRoomStmt.run(\n    name ?? room.name,\n    displayName ?? room.display_name,\n    accessCode ?? room.access_code,\n    enabled !== undefined ? (enabled ? 1 : 0) : room.enabled,\n    roomClock.next(),\n    id\n  );\n  return getRoomByIdStmt.get(id);\n}\n\nexport function deleteRoom(id) {\n  const room = getRoomByIdStmt.get(id);\n  if (!room) return { changes: 0 };\n  // Delete room_access records first (join history for a removed room is moot)\n  db.prepare(`DELETE FROM room_access WHERE room_id = ?`).run(id);\n  // Soft-delete (tombstone) instead of hard-deleting so the deletion replicates to the peer\n  // backend and a stale create cannot resurrect the room. The row (and its UNIQUE name) stays.\n  return softDeleteRoomStmt.run(roomClock.next(), id);\n}\n\n// ============ ROOM REGISTRY SYNC (hybrid hosting) ============\n\n/**\n * Export the local room registry (including tombstones) as a plain JSON-able snapshot array.\n * Reused by GET /sync/rooms and by a future background sync scheduler.\n */\nexport function getRoomRegistry() {\n  return exportSnapshotRecords(getAllRoomsForSyncStmt.all());\n}\n\nconst insertSyncRoomStmt = db.prepare(`\n  INSERT INTO rooms (id, name, display_name, access_code, created_by, enabled, created_at, updated_at, updated_at_ms, deleted_at)\n  VALUES (?, ?, ?, ?, NULL, ?, datetime('now'), datetime('now'), ?, ?)\n`);\nconst applySyncRoomStmt = db.prepare(`\n  UPDATE rooms SET display_name = ?, access_code = ?, enabled = ?, updated_at = datetime('now'), updated_at_ms = ?, deleted_at = ?\n  WHERE name = ?\n`);\n\n/**\n * Apply a peer snapshot to the local store: merge (last-writer-wins + tombstones), then apply the\n * resulting inserts/updates/deletes idempotently by room name. Returns the resulting local\n * snapshot and a change summary. Thin adapter over the pure primitives in sync.js.\n */\nexport function applyRoomRegistry(remoteSnapshot) {\n  const local = getRoomRegistry();\n  const { records, actions } = applySnapshotToRecords(local, remoteSnapshot || []);\n\n  const run = db.transaction((acts) => {\n    for (const { type, record } of acts) {\n      // Keep the local clock ahead of any timestamp we accept from a peer.\n      roomClock.observe(record.updated_at_ms);\n      const deletedAt = record.deleted ? new Date(record.updated_at_ms).toISOString() : null;\n      const enabled = record.deleted ? 0 : (record.enabled ? 1 : 0);\n\n      if (type === 'insert' || type === 'tombstone') {\n        // Create-by-name: never duplicate an existing name. Guard defensively in case a row\n        // appeared concurrently \u2014 fall back to update.\n        const existing = getRoomByNameAnyStmt.get(record.name);\n        if (existing) {\n          applySyncRoomStmt.run(record.display_name ?? null, record.access_code, enabled, record.updated_at_ms, deletedAt, record.name);\n        } else {\n          insertSyncRoomStmt.run(\n            generateId('room'),\n            record.name,\n            record.display_name ?? null,\n            record.access_code,\n            enabled,\n            record.updated_at_ms,\n            deletedAt\n          );\n        }\n      } else if (type === 'update') {\n        applySyncRoomStmt.run(record.display_name ?? null, record.access_code, enabled, record.updated_at_ms, deletedAt, record.name);\n      }\n    }\n  });\n  run(actions);\n\n  return {\n    snapshot: getRoomRegistry(),\n    changes: {\n      applied: actions.length,\n      inserted: actions.filter((a) => a.type === 'insert').length,\n      tombstoned: actions.filter((a) => a.type === 'tombstone').length,\n      updated: actions.filter((a) => a.type === 'update').length,\n    },\n  };\n}\n\n// ============ SESSION OPERATIONS ============\n\nconst createSessionStmt = db.prepare(`\n  INSERT INTO sessions (id, user_id, magic_token, expires_at, user_agent, ip_address)\n  VALUES (?, ?, ?, datetime('now', '+30 days'), ?, ?)\n`);\n\nconst getSessionByIdStmt = db.prepare(`\n  SELECT s.*, u.name as user_name, u.email as user_email, u.is_admin, u.can_create_rooms\n  FROM sessions s\n  JOIN users u ON s.user_id = u.id\n  WHERE s.id = ? AND datetime(s.expires_at) > datetime('now')\n`);\n\nconst updateSessionLastUsedStmt = db.prepare(`\n  UPDATE sessions SET last_used = datetime('now') WHERE id = ?\n`);\n\nconst deleteExpiredSessionsStmt = db.prepare(`\n  DELETE FROM sessions WHERE datetime(expires_at) < datetime('now')\n`);\n\nexport function createSession({ userId, userAgent, ipAddress }) {\n  const id = generateId('sess');\n  const magicToken = generateMagicToken();\n  createSessionStmt.run(id, userId, magicToken, userAgent || null, ipAddress || null);\n  return { \n    ...getSessionByIdStmt.get(id),\n    magicToken // Return the magic token only during creation\n  };\n}\n\nexport function getSessionById(id) {\n  return getSessionByIdStmt.get(id);\n}\n\nexport function updateSessionLastUsed(id) {\n  return updateSessionLastUsedStmt.run(id);\n}\n\nexport function cleanupExpiredSessions() {\n  return deleteExpiredSessionsStmt.run();\n}\n\n// ============ ROOM ACCESS OPERATIONS ============\n\nconst recordRoomAccessStmt = db.prepare(`\n  INSERT INTO room_access (user_id, room_id, session_id, first_joined_at, last_joined_at, join_count)\n  VALUES (?, ?, ?, datetime('now'), datetime('now'), 1)\n  ON CONFLICT(user_id, room_id) DO UPDATE SET\n    last_joined_at = datetime('now'),\n    join_count = join_count + 1,\n    session_id = excluded.session_id\n`);\n\nconst hasUserAccessedRoomStmt = db.prepare(`\n  SELECT 1 FROM room_access WHERE user_id = ? AND room_id = ?\n`);\n\nexport function recordRoomAccess({ userId, roomId, sessionId }) {\n  return recordRoomAccessStmt.run(userId, roomId, sessionId);\n}\n\nexport function hasUserAccessedRoom(userId, roomId) {\n  return !!hasUserAccessedRoomStmt.get(userId, roomId);\n}\n\n// ============ AUDIT LOG OPERATIONS ============\n\nconst addAuditLogStmt = db.prepare(`\n  INSERT INTO audit_log (event_type, user_id, room_id, session_id, details, ip_address, user_agent)\n  VALUES (?, ?, ?, ?, ?, ?, ?)\n`);\n\nconst getAuditLogStmt = db.prepare(`\n  SELECT al.*, u.name as user_name, r.name as room_name\n  FROM audit_log al\n  LEFT JOIN users u ON al.user_id = u.id\n  LEFT JOIN rooms r ON al.room_id = r.id\n  ORDER BY al.created_at DESC\n  LIMIT ?\n`);\n\nexport function addAuditLog({ eventType, userId, roomId, sessionId, details, ipAddress, userAgent }) {\n  return addAuditLogStmt.run(\n    eventType,\n    userId || null,\n    roomId || null,\n    sessionId || null,\n    details ? JSON.stringify(details) : null,\n    ipAddress || null,\n    userAgent || null\n  );\n}\n\nexport function getAuditLog(limit = 100) {\n  return getAuditLogStmt.all(limit);\n}\n\nexport function closeDatabase() {\n  db.close();\n}\n\nexport default {\n  dbPath,\n  generateId,\n  generateMagicToken,\n  generatePassphrase,\n\n  // Users\n  createUser,\n  getUserById,\n  getAllUsers,\n\n  // Rooms\n  createRoom,\n  getRoomById,\n  getRoomByName,\n  getAllRooms,\n  getEnabledRooms,\n  updateRoom,\n  deleteRoom,\n  getRoomRegistry,\n  applyRoomRegistry,\n  \n  // Sessions\n  createSession,\n  getSessionById,\n  updateSessionLastUsed,\n  cleanupExpiredSessions,\n\n  // Room access\n  recordRoomAccess,\n  hasUserAccessedRoom,\n\n  // Audit log\n  addAuditLog,\n  getAuditLog,\n\n  closeDatabase,\n};\n","api/index.js":"/**\n * VHS Video Stack API (room/PIN service).\n *\n * Trimmed to the room, join-token and admin surface. The LiveKit SDK is replaced by a local\n * HMAC-signed join token (no npm in this environment); the HTTP layer is ./lib/express.js.\n * The app is the default export; it only listens when this file is run directly.\n */\nimport express from \"./lib/express.js\";\nimport crypto from \"crypto\";\nimport { fileURLToPath } from \"url\";\n\n// Import local modules\nimport * as db from \"./db.js\";\nimport { requireRoomCreator, optionalAuth, getClientIp } from \"./middleware.js\";\nimport adminRoutes from \"./admin.js\";\nimport { createSyncRouter } from \"./sync-routes.js\";\n\nconst __filename = fileURLToPath(import.meta.url);\n\nconst app = express();\n\n// Middleware\napp.use(express.json());\n\n// Environment variables\nconst {\n  LIVEKIT_API_KEY = \"devkey\",\n  LIVEKIT_API_SECRET = \"devsecret\",\n  LIVEKIT_WS_URL = \"ws://localhost:7880\",\n  PORT = 3000,\n} = process.env;\n\n// ============ UTILITY FUNCTIONS ============\n\nfunction generateLiveKitToken(identity, name, roomName) {\n  const b64 = (value) => Buffer.from(JSON.stringify(value)).toString(\"base64url\");\n  const header = b64({ alg: \"HS256\", typ: \"JWT\" });\n  const payload = b64({\n    iss: LIVEKIT_API_KEY,\n    sub: identity,\n    name,\n    exp: Math.floor(Date.now() / 1000) + 30 * 60,\n    video: { roomJoin: true, room: roomName, canPublish: true, canSubscribe: true, canPublishData: true },\n  });\n  const signature = crypto.createHmac(\"sha256\", LIVEKIT_API_SECRET).update(`${header}.${payload}`).digest(\"base64url\");\n  return `${header}.${payload}.${signature}`;\n}\n\n// ============ ROUTES ============\n\n// Mount admin routes\napp.use('/admin', adminRoutes);\n\n// Room-registry replication (hybrid hosting). Guarded by SYNC_SHARED_SECRET; when the env var is\n// unset the routes are disabled (404) so default deployments are unaffected.\napp.use(\n  \"/sync\",\n  createSyncRouter({\n    store: {\n      getSnapshot: () => db.getRoomRegistry(),\n      applySnapshot: (remote) => db.applyRoomRegistry(remote),\n    },\n    getSecret: () => process.env.SYNC_SHARED_SECRET,\n  })\n);\n\n// Health check\napp.get(\"/healthz\", (_, res) => res.send(\"ok\"));\n\n/**\n * GET /rooms\n * List available rooms (only enabled rooms, no access codes exposed)\n */\napp.get(\"/rooms\", optionalAuth, (req, res) => {\n  try {\n    const rooms = db.getEnabledRooms();\n    res.json({\n      rooms: rooms.map(r => ({\n        id: r.id,\n        name: r.name,\n        displayName: r.display_name\n      }))\n    });\n  } catch (error) {\n    console.error('List rooms error:', error);\n    res.status(500).json({ error: 'Internal server error' });\n  }\n});\n\n/**\n * POST /rooms\n * Create a new room (requires room creator permission)\n */\napp.post(\"/rooms\", requireRoomCreator, (req, res) => {\n  try {\n    const { name, displayName, accessCode } = req.body;\n    \n    if (!name) {\n      return res.status(400).json({ error: \"Room name is required\" });\n    }\n    \n    // Check if room already exists\n    const existing = db.getRoomByName(name);\n    if (existing) {\n      return res.status(409).json({ error: \"Room name already exists\" });\n    }\n    \n    const room = db.createRoom({\n      name,\n      displayName,\n      accessCode,\n      createdBy: req.user.id\n    });\n    \n    db.addAuditLog({\n      eventType: 'room_created',\n      userId: req.user.id,\n      roomId: room.id,\n      details: { roomName: name, displayName },\n      ipAddress: getClientIp(req),\n      userAgent: req.get('User-Agent')\n    });\n    \n    res.json({\n      id: room.id,\n      name: room.name,\n      displayName: room.display_name,\n      accessCode: room.access_code\n    });\n  } catch (error) {\n    console.error('Create room error:', error);\n    res.status(500).json({ error: 'Internal server error' });\n  }\n});\n\n/**\n * POST /rooms/public\n * Create a room without authentication (public API)\n */\napp.post(\"/rooms/public\", (req, res) => {\n  try {\n    const { name, displayName, accessCode } = req.body;\n    \n    if (!name) {\n      return res.status(400).json({ error: \"Room name is required\" });\n    }\n    \n    if (!accessCode) {\n      return res.status(400).json({ error: \"Access code is required\" });\n    }\n    \n    // Check if room already exists\n    const existing = db.getRoomByName(name);\n    if (existing) {\n      return res.status(409).json({ error: \"Room name already exists\" });\n    }\n    \n    const room = db.createRoom({\n      name,\n      displayName: displayName || name,\n      accessCode,\n      createdBy: null // No user for public rooms\n    });\n    \n    res.json({\n      id: room.id,\n      name: room.name,\n      displayName: room.display_name,\n      accessCode: room.access_code\n    });\n  } catch (error) {\n    console.error('Create public room error:', error);\n    res.status(500).json({ error: 'Internal server error' });\n  }\n});\n\n/**\n * POST /tokens\n * Get a LiveKit token to join a room\n * Requires room access code OR authenticated session with room in history\n */\napp.post(\"/tokens\", optionalAuth, async (req, res) => {\n  try {\n    const { room: roomName, identity, name, accessCode, pin } = req.body;\n    \n    if (!roomName || !identity) {\n      return res.status(400).json({ error: \"Missing room/identity\" });\n    }\n    \n    // Find the room\n    const room = db.getRoomByName(roomName);\n    if (!room) {\n      return res.status(404).json({ error: \"Room not found\" });\n    }\n    \n    // Check authorization\n    let authorized = false;\n    let authMethod = '';\n    \n    // Method 1: Access code provided\n    if (accessCode || pin) {\n      const providedCode = accessCode || pin;\n      if (providedCode === room.access_code) {\n        authorized = true;\n        authMethod = 'access_code';\n      }\n    }\n    \n    // Method 2: Authenticated user with room in history (rejoin)\n    if (!authorized && req.user && req.session) {\n      if (db.hasUserAccessedRoom(req.user.id, room.id)) {\n        authorized = true;\n        authMethod = 'session_rejoin';\n      }\n    }\n    \n    if (!authorized) {\n      db.addAuditLog({\n        eventType: 'room_join_denied',\n        userId: req.user?.id,\n        roomId: room.id,\n        details: { reason: 'invalid_credentials' },\n        ipAddress: getClientIp(req),\n        userAgent: req.get('User-Agent')\n      });\n      \n      return res.status(401).json({ error: \"Invalid access code\" });\n    }\n    \n    const token = generateLiveKitToken(identity, name || identity, room.name);\n    \n    // Record room access if authenticated\n    if (req.user && req.session) {\n      db.recordRoomAccess({\n        userId: req.user.id,\n        roomId: room.id,\n        sessionId: req.session.id\n      });\n    }\n    \n    // Log successful join\n    db.addAuditLog({\n      eventType: 'room_joined',\n      userId: req.user?.id,\n      roomId: room.id,\n      sessionId: req.session?.id,\n      details: { identity, authMethod },\n      ipAddress: getClientIp(req),\n      userAgent: req.get('User-Agent')\n    });\n    \n    res.json({ \n      url: LIVEKIT_WS_URL, \n      token, \n      room: {\n        id: room.id,\n        name: room.name,\n        displayName: room.display_name\n      }\n    });\n  } catch (error) {\n    console.error('Get token error:', error);\n    res.status(500).json({ error: 'Internal server error' });\n  }\n});\n\n/**\n * GET /rooms/:name\n * Get room info (no access code exposed)\n */\napp.get(\"/rooms/:name\", optionalAuth, (req, res) => {\n  try {\n    const room = db.getRoomByName(req.params.name);\n    \n    if (!room) {\n      return res.status(404).json({ error: \"Room not found\" });\n    }\n    \n    // Check if user has access (for rejoin capability)\n    let canRejoin = false;\n    if (req.user) {\n      canRejoin = db.hasUserAccessedRoom(req.user.id, room.id);\n    }\n    \n    res.json({\n      id: room.id,\n      name: room.name,\n      displayName: room.display_name,\n      canRejoin\n    });\n  } catch (error) {\n    console.error('Get room error:', error);\n    res.status(500).json({ error: 'Internal server error' });\n  }\n});\n\n// ============ ERROR HANDLING ============\n\napp.use((err, req, res, next) => {\n  if (err && err.status && err.status < 500) {\n    return res.status(err.status).json({ error: err.message });\n  }\n  console.error('Unhandled error:', err);\n  res.status(500).json({ error: 'Internal server error' });\n});\n\n// ============ START SERVER ============\n\nif (process.argv[1] === __filename) {\n  app.listen(PORT, () => {\n    console.log(`API listening on port ${PORT}`);\n    console.log(`Database: ${db.dbPath}`);\n    \n    // Cleanup expired sessions on startup\n    const cleaned = db.cleanupExpiredSessions();\n    if (cleaned.changes > 0) {\n      console.log(`Cleaned up ${cleaned.changes} expired sessions`);\n    }\n  });\n}\n\nexport default app;\n","api/sync-routes.js":"/**\n * HTTP wiring for room-registry replication (thin adapter over the pure sync primitives).\n *\n * Two peer endpoints, both guarded by a shared secret:\n *   GET  /sync/rooms  -> returns the local snapshot.\n *   POST /sync/rooms  -> accepts a peer snapshot, merges + applies it, returns the resulting\n *                        local snapshot plus a change summary.\n *\n * Guard semantics (security-sensitive: this replicates room PINs):\n *   - If the shared secret is unset, the sync routes are DISABLED (404) so default deployments\n *     are unaffected.\n *   - If set, requests must present a matching `x-sync-secret` header; missing/wrong -> 401.\n *\n * The router is intentionally decoupled from better-sqlite3: it takes a `store` adapter so it\n * can be unit-tested with an in-memory store and reused by index.js with the real DB.\n *\n * @param {Object}   opts\n * @param {Object}   opts.store              - { getSnapshot(): record[], applySnapshot(remote): { snapshot, changes } }\n * @param {Function} opts.getSecret          - returns the current shared secret (or falsy when unset)\n * @param {string}   [opts.headerName]       - header carrying the secret (default 'x-sync-secret')\n */\nimport express from './lib/express.js';\n\nexport function createSyncRouter({ store, getSecret, headerName = 'x-sync-secret' }) {\n  if (!store || typeof store.getSnapshot !== 'function' || typeof store.applySnapshot !== 'function') {\n    throw new Error('createSyncRouter requires a store with getSnapshot() and applySnapshot()');\n  }\n  if (typeof getSecret !== 'function') {\n    throw new Error('createSyncRouter requires a getSecret() function');\n  }\n\n  const router = express.Router();\n\n  // Shared-secret guard. Runs before every /sync route.\n  router.use((req, res, next) => {\n    const secret = getSecret();\n    if (!secret) {\n      // Sync disabled \u2014 behave as if the routes do not exist.\n      return res.status(404).json({ error: 'Room sync is disabled' });\n    }\n    const provided = req.get(headerName);\n    if (!provided || provided !== secret) {\n      return res.status(401).json({ error: 'Invalid or missing sync secret' });\n    }\n    next();\n  });\n\n  // GET /sync/rooms -> local snapshot\n  router.get('/rooms', (req, res) => {\n    try {\n      res.json({ rooms: store.getSnapshot() });\n    } catch (error) {\n      console.error('Sync export error:', error);\n      res.status(500).json({ error: 'Internal server error' });\n    }\n  });\n\n  // POST /sync/rooms -> merge peer snapshot, apply, return resulting snapshot + change summary\n  router.post('/rooms', (req, res) => {\n    try {\n      const body = req.body || {};\n      const remote = Array.isArray(body) ? body : body.rooms;\n      if (!Array.isArray(remote)) {\n        return res.status(400).json({ error: 'Expected a \"rooms\" array (or a bare array)' });\n      }\n      const result = store.applySnapshot(remote);\n      res.json({ rooms: result.snapshot, changes: result.changes });\n    } catch (error) {\n      console.error('Sync import error:', error);\n      res.status(500).json({ error: 'Internal server error' });\n    }\n  });\n\n  return router;\n}\n\nexport default { createSyncRouter };\n","api/sync.js":"/**\n * Room-registry replication primitives for VHS Video Stack (hybrid hosting slice 1).\n *\n * These functions are PURE and store-agnostic: no Express, no better-sqlite3. They operate\n * on plain \"snapshot records\" so they are trivially unit-testable and reusable by both the\n * HTTP layer and the SQLite adapter in db.js. A future background sync scheduler (peer\n * pull/push on an interval) would reuse exactly these primitives: GET a peer snapshot,\n * mergeRoomRegistries() it against the local snapshot, then apply the diff.\n *\n * Snapshot record shape (the natural key is `name`, which is UNIQUE in the rooms table):\n *   {\n *     name:          string,        // natural key\n *     display_name:  string | null,\n *     access_code:   string,        // the PIN \u2014 replicated verbatim across backends\n *     enabled:       0 | 1,\n *     deleted:       boolean,       // tombstone flag (soft delete)\n *     updated_at_ms: number,        // logical timestamp driving last-writer-wins\n *   }\n */\n\n/**\n * Monotonic logical clock. next() returns a strictly increasing integer (milliseconds since\n * epoch, but never less than the previous value + 1). This guarantees that two rapid edits on\n * the same process order deterministically even within the same wall-clock millisecond.\n *\n * @param {number} initial - seed value (e.g. the max updated_at_ms already in the store).\n */\nexport function createLogicalClock(initial = 0) {\n  let last = Number.isFinite(initial) ? Math.floor(initial) : 0;\n  return {\n    next() {\n      const now = Date.now();\n      last = now > last ? now : last + 1;\n      return last;\n    },\n    /** Advance the clock past an externally-supplied timestamp (e.g. an applied remote record). */\n    observe(ts) {\n      const n = Number(ts);\n      if (Number.isFinite(n) && n > last) last = Math.floor(n);\n      return last;\n    },\n    peek() {\n      return last;\n    },\n  };\n}\n\n/** Normalize a raw rooms-table row into a snapshot record. Pure. */\nexport function roomRowToRecord(row) {\n  return {\n    name: row.name,\n    display_name: row.display_name ?? null,\n    access_code: row.access_code,\n    enabled: row.enabled ? 1 : 0,\n    deleted: row.deleted_at != null && row.deleted_at !== '',\n    updated_at_ms: Number(row.updated_at_ms) || 0,\n  };\n}\n\n/**\n * Serialize a list of rooms-table rows into a plain JSON-able snapshot array.\n * Includes tombstones so deletions propagate. Sorted by name for deterministic output.\n */\nexport function exportSnapshot(rows) {\n  return rows.map(roomRowToRecord).sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));\n}\n\n/** Canonical content string for deterministic tie-breaking (direction-independent). */\nfunction tiebreakKey(rec) {\n  return JSON.stringify([\n    rec.access_code ?? '',\n    rec.display_name ?? '',\n    rec.enabled ? 1 : 0,\n  ]);\n}\n\n/**\n * Choose the winning record between two records for the same room name. Defines a total order\n * that is independent of argument order, which makes the merge commutative and idempotent.\n *\n * Policy:\n *  1. Higher updated_at_ms wins (last-writer-wins).\n *  2. Exact timestamp tie: a tombstone beats a live record (anti-resurrection).\n *  3. Still tied: higher canonical content string wins (deterministic, content-only).\n */\nexport function pickWinner(a, b) {\n  if (!a) return b;\n  if (!b) return a;\n\n  const ta = Number(a.updated_at_ms) || 0;\n  const tb = Number(b.updated_at_ms) || 0;\n  if (ta !== tb) return ta > tb ? a : b;\n\n  const da = a.deleted ? 1 : 0;\n  const db = b.deleted ? 1 : 0;\n  if (da !== db) return da > db ? a : b;\n\n  const ka = tiebreakKey(a);\n  const kb = tiebreakKey(b);\n  if (ka !== kb) return ka > kb ? a : b;\n\n  // Fully equal content \u2014 return `a` deterministically (both are identical).\n  return a;\n}\n\n/** True when two snapshot records are semantically identical. */\nexport function recordsEqual(a, b) {\n  if (!a || !b) return false;\n  return (\n    a.name === b.name &&\n    (a.display_name ?? null) === (b.display_name ?? null) &&\n    a.access_code === b.access_code &&\n    (a.enabled ? 1 : 0) === (b.enabled ? 1 : 0) &&\n    !!a.deleted === !!b.deleted &&\n    (Number(a.updated_at_ms) || 0) === (Number(b.updated_at_ms) || 0)\n  );\n}\n\n/**\n * PURE merge of two room registries keyed by room `name`, using last-writer-wins with tombstone\n * support. Deterministic, commutative (same final set regardless of direction) and idempotent\n * (merging the same remote twice is a no-op). Returns a new array sorted by name.\n */\nexport function mergeRoomRegistries(local = [], remote = []) {\n  const byName = new Map();\n\n  for (const rec of local) {\n    if (!rec || rec.name == null) continue;\n    byName.set(rec.name, rec);\n  }\n  for (const rec of remote) {\n    if (!rec || rec.name == null) continue;\n    const existing = byName.get(rec.name);\n    byName.set(rec.name, existing ? pickWinner(existing, rec) : rec);\n  }\n\n  return [...byName.values()].sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));\n}\n\n/**\n * PURE diff between the current local snapshot and a merged snapshot. Returns the ordered list\n * of actions needed to make local match merged. Idempotent: applying the same merged twice\n * yields zero actions the second time.\n *\n * Action types:\n *   - 'insert': name not present locally and the winning record is live \u2192 create it.\n *   - 'tombstone': name not present locally and the winning record is a tombstone \u2192 record the\n *     tombstone so it propagates and a stale create can't resurrect it.\n *   - 'update': name present locally but the winning record differs (content, enabled or delete).\n */\nexport function diffRegistries(local = [], merged = []) {\n  const localByName = new Map();\n  for (const rec of local) {\n    if (rec && rec.name != null) localByName.set(rec.name, rec);\n  }\n\n  const actions = [];\n  for (const rec of merged) {\n    const existing = localByName.get(rec.name);\n    if (!existing) {\n      actions.push({ type: rec.deleted ? 'tombstone' : 'insert', record: rec });\n    } else if (!recordsEqual(existing, rec)) {\n      actions.push({ type: 'update', record: rec });\n    }\n  }\n  return actions;\n}\n\n/**\n * Convenience: merge a remote snapshot into a local snapshot and compute both the resulting\n * records and the diff actions in one pure call. The DB adapter executes `actions`; tests can\n * apply them to any store.\n */\nexport function applySnapshotToRecords(local = [], remote = []) {\n  const records = mergeRoomRegistries(local, remote);\n  const actions = diffRegistries(local, records);\n  return { records, actions };\n}\n\nexport default {\n  createLogicalClock,\n  roomRowToRecord,\n  exportSnapshot,\n  pickWinner,\n  recordsEqual,\n  mergeRoomRegistries,\n  diffRegistries,\n  applySnapshotToRecords,\n};\n"}
