 {
  "original_id": "enqueue writes one JSON entry holding the edit",
  "group": "queue",
  "probe": {
   "scenario": "enqueueOne"
  },
  "clauses": [
   [
    "path_equal",
    [
     "fileIsId"
    ],
    true
   ],
   [
    "path_equal",
    [
     "idMatches"
    ],
    true
   ],
   [
    "path_equal",
    [
     "idSafe"
    ],
    true
   ],
   [
    "path_match",
    [
     "content"
    ],
    {
     "markdown": "# plan v1",
     "planPath": "specs/p/plan.md",
     "timestamp": "2026-01-01T10:00:00.000Z"
    }
   ],
   [
    "path_keys",
    [
     "content"
    ],
    [
     "id",
     "markdown",
     "planPath",
     "timestamp"
    ]
   ]
  ]
 },
 {
  "original_id": "enqueue is crash-safe via tmp then rename",
  "group": "queue",
  "probe": {
   "scenario": "enqueueAtomic"
  },
  "clauses": [
   [
    "path_equal",
    [
     "writesTmpOnly"
    ],
    true
   ],
   [
    "path_equal",
    [
     "renamedTmpToJson"
    ],
    true
   ],
   [
    "path_equal",
    [
     "leftoverTmp"
    ],
    0
   ]
  ]
 },
 {
  "original_id": "ids are unique and time-sortable",
  "group": "queue",
  "probe": {
   "scenario": "enqueueDistinct"
  },
  "clauses": [
