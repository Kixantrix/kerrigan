[
 {
  "original_id": "flags a plan-edit PR when an agent:go issue exists",
  "group": "conflict",
  "probe": {
   "scenario": "conflictAgentGoAndPlanEdit"
  },
  "clauses": [
   [
    "path_equal",
    [
     "result"
    ],
    {
     "ok": true,
     "data": {
      "conflicted": true,
      "pr": {
       "number": 7,
       "url": "https://example.test/pull/7",
       "branch": "plan-edits/20260101T000000Z-abc1234"
      }
     }
    }
   ],
   [
    "path_equal",
    [
     "listIssuesCalls"
    ],
    [
     [
      "o",
      "r"
     ]
    ]
   ]
  ]
 },
