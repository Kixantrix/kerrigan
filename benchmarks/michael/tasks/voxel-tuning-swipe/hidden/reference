{"src/engine/swipe.ts":"// Swipe - the gesture arithmetic behind drag-to-travel (faithful TypeScript port\n// of engine/Swipe.kt), kept separate from the wallpaper service so it can be\n// exercised without a surface.\nimport { Tuning } from \"./tuning.ts\";\n\n// A gesture shorter than this counts as a flick and commits regardless of\n// distance, so a fast confident flick covering little distance is not ignored.\nexport const FLICK_MS = 250;\nexport const FLICK_DP = 24.0;\n\nexport const Swipe = {\n  FLICK_MS,\n  FLICK_DP,\n\n  // How far through a one-world hop the gesture has got, in -1..1. Clamped: a\n  // gesture is worth at most one world either way, matching how the launcher\n  // pages. `gestureDp` is signed in screen terms - positive is a rightward\n  // drag, which moves the camera left through the system, hence the negation.\n  fraction(gestureDp: number): number {\n    return Math.min(Math.max(-gestureDp / Tuning.swipeDistanceDp, -1.0), 1.0);\n  },\n\n  // Worlds to move when the finger lifts: -1, 0 or +1.\n  outcome(gestureDp: number, elapsedMs: number): number {\n    const frac = Swipe.fraction(gestureDp);\n    if (frac === 0) return 0;\n    const flicked = elapsedMs >= 1 && elapsedMs < FLICK_MS && Math.abs(gestureDp) >= FLICK_DP;\n    if (Math.abs(frac) < Tuning.swipeCommit && !flicked) return 0;\n    return frac > 0 ? 1 : -1;\n  },\n};\n","src/engine/tuning.ts":"// Tuning - the knobs the settings screen exposes (faithful TypeScript port of\n// engine/Tuning.kt).\n//\n// Every parameter is either a direct value in an obvious unit or a multiplier\n// on a built-in constant, and every default is chosen so that a fresh install\n// behaves exactly as the tuned design does: a slider at its default is the\n// shipped look, so \"reset\" is always a way back out of a mess. Ranges are\n// deliberately narrower than what the maths would tolerate.\n//\n// Kept free of platform imports so the engine stays testable headlessly; the\n// app layer is responsible for loading and saving values.\n\nexport const GROUP_SWIPE = \"Swipe\";\nexport const GROUP_CAMERA = \"Camera\";\nexport const GROUP_MOTION = \"Motion\";\nexport const GROUP_SKY = \"Sky\";\nexport const GROUP_EVENTS = \"Events\";\n\ntype ParamOptions = { asPercent?: boolean; suffix?: string; rebuilds?: boolean };\n\nexport class Param {\n  readonly id: string;\n  readonly label: string;\n  readonly group: string;\n  readonly min: number;\n  readonly max: number;\n  readonly default: number;\n  readonly hint: string;\n  // Multipliers read nicely as percentages; real units do not.\n  readonly asPercent: boolean;\n  readonly suffix: string;\n  // Whether changing this requires the scene to be rebuilt.\n  readonly rebuilds: boolean;\n\n  constructor(\n    id: string, label: string, group: string, min: number, max: number, defaultValue: number, hint: string,\n    options: ParamOptions = {},\n  ) {\n    this.id = id;\n    this.label = label;\n    this.group = group;\n    this.min = min;\n    this.max = max;\n    this.default = defaultValue;\n    this.hint = hint;\n    this.asPercent = options.asPercent ?? false;\n    this.suffix = options.suffix ?? \"\";\n    this.rebuilds = options.rebuilds ?? false;\n  }\n\n  format(v: number): string {\n    if (this.asPercent) return `${Math.round(v * 100)}%`;\n    // Fixed locale: a numeric readout next to a slider, not prose.\n    const s = v >= 100 ? `${Math.round(v)}` : v.toFixed(2);\n    return s + this.suffix;\n  }\n}\n\nexport const PARAMS: readonly Param[] = [\n  new Param(\"swipeDistance\", \"Swipe distance\", GROUP_SWIPE, 90.0, 420.0, 210.0,\n    \"How far the finger travels to move one world.\", { suffix: \"dp\" }),\n  new Param(\"swipeCommit\", \"Commit threshold\", GROUP_SWIPE, 0.15, 0.75, 0.35,\n    \"How much of that distance a swipe needs before it sticks. Below this the camera springs back.\",\n    { asPercent: true }),\n  new Param(\"cameraEase\", \"Camera glide\", GROUP_CAMERA, 0.05, 0.40, 0.15,\n    \"How hard the camera chases its destination. Lower is slower and floatier.\"),\n  new Param(\"foldEase\", \"Fold glide\", GROUP_CAMERA, 0.04, 0.30, 0.11, \"The same, for the unfold reveal.\"),\n  new Param(\"coverZoom\", \"Cover zoom out\", GROUP_CAMERA, 0.60, 1.80, 1.0,\n    \"How much of the system the cover screen shows. Higher pulls back.\", { asPercent: true }),\n  new Param(\"openZoom\", \"Unfolded zoom out\", GROUP_CAMERA, 0.50, 1.60, 1.0,\n    \"The same for the inner screen.\", { asPercent: true }),\n  new Param(\"verticalTravel\", \"Vertical travel\", GROUP_CAMERA, 0.0, 1.60, 1.0,\n    \"How much the camera rises and falls as you cross the system. Zero keeps travel purely side to side.\",\n    { asPercent: true }),\n  new Param(\"rollAmount\", \"Camera roll\", GROUP_CAMERA, 0.0, 2.0, 1.0,\n    \"How much the viewing angle tips as you travel, unfolded.\", { asPercent: true }),\n  new Param(\"spinSweep\", \"Planet spin\", GROUP_MOTION, 0.0, 3.0, 1.0,\n    \"How far worlds turn on their axes across a full sweep.\", { asPercent: true }),\n  new Param(\"moonSweep\", \"Moon orbit\", GROUP_MOTION, 0.0, 3.0, 1.0,\n    \"How far moons travel around their planet across a full sweep.\", { asPercent: true }),\n  new Param(\"glowStrength\", \"Atmosphere glow\", GROUP_SKY, 0.0, 2.0, 1.0,\n    \"Strength of the halo around each world.\", { asPercent: true }),\n  new Param(\"starDensity\", \"Star density\", GROUP_SKY, 0.30, 2.0, 1.0,\n    \"How many stars fill the sky.\", { asPercent: true, rebuilds: true }),\n  new Param(\"starBrightness\", \"Star brightness\", GROUP_SKY, 0.30, 2.0, 1.0,\n    \"How brightly they burn.\", { asPercent: true }),\n  new Param(\"moteDensity\", \"Foreground dust\", GROUP_SKY, 0.0, 2.5, 1.0,\n    \"Specks drifting close to the camera.\", { asPercent: true, rebuilds: true }),\n  new Param(\"beltDensity\", \"Asteroid belt\", GROUP_SKY, 0.0, 2.0, 1.0,\n    \"How thickly the belt is populated.\", { asPercent: true, rebuilds: true }),\n  new Param(\"eventRate\", \"Event frequency\", GROUP_EVENTS, 0.25, 4.0, 1.0,\n    \"How often comets and passing craft appear. Higher means more often, and costs a little more battery.\",\n    { asPercent: true }),\n  new Param(\"eventLength\", \"Event duration\", GROUP_EVENTS, 0.40, 2.50, 1.0,\n    \"How long each one lasts.\", { asPercent: true }),\n];\n\nconst byId = new Map(PARAMS.map((p) => [p.id, p] as const));\nconst values = new Map<string, number>();\nconst coerceIn = (v: number, min: number, max: number) => Math.min(Math.max(v, min), max);\n\nclass TuningState {\n  readonly GROUP_SWIPE = GROUP_SWIPE;\n  readonly GROUP_CAMERA = GROUP_CAMERA;\n  readonly GROUP_MOTION = GROUP_MOTION;\n  readonly GROUP_SKY = GROUP_SKY;\n  readonly GROUP_EVENTS = GROUP_EVENTS;\n  readonly PARAMS = PARAMS;\n\n  // Live values. Read directly on the draw path, so plain fields rather than a\n  // map lookup per frame.\n  swipeDistanceDp = 210.0;\n  swipeCommit = 0.35;\n  cameraEase = 0.15;\n  foldEase = 0.11;\n  coverZoom = 1.0;\n  openZoom = 1.0;\n  verticalTravel = 1.0;\n  rollAmount = 1.0;\n  spinSweep = 1.0;\n  moonSweep = 1.0;\n  glowStrength = 1.0;\n  starDensity = 1.0;\n  starBrightness = 1.0;\n  moteDensity = 1.0;\n  beltDensity = 1.0;\n  eventRate = 1.0;\n  eventLength = 1.0;\n\n  // Bumped whenever a value changed that the scene is built from, so the\n  // wallpaper rebuilds without a restart.\n  revision = 0;\n\n  param(id: string): Param | null {\n    return byId.get(id) ?? null;\n  }\n\n  value(id: string): number {\n    return values.get(id) ?? byId.get(id)?.default ?? 0.0;\n  }\n\n  // Current values for every parameter, defaults included.\n  snapshot(): Record<string, number> {\n    return Object.fromEntries(PARAMS.map((p) => [p.id, this.value(p.id)]));\n  }\n\n  isDefault(id: string): boolean {\n    const p = byId.get(id);\n    if (p === undefined) return true;\n    return Math.abs(this.value(id) - p.default) < 1e-9;\n  }\n\n  // True if nothing has been moved away from its shipped value.\n  allDefault(): boolean {\n    return PARAMS.every((p) => this.isDefault(p.id));\n  }\n\n  set(id: string, raw: number): void {\n    const p = byId.get(id);\n    if (p === undefined) return;\n    const v = coerceIn(raw, p.min, p.max);\n    if (Math.abs(this.value(id) - v) < 1e-12) return;\n    values.set(id, v);\n    if (p.rebuilds) this.revision += 1;\n    this.publish();\n  }\n\n  // Replaces every value at once, ignoring ids this build does not know.\n  replaceAll(incoming: Record<string, number>): void {\n    let rebuild = false;\n    for (const p of PARAMS) {\n      const given = Object.prototype.hasOwnProperty.call(incoming, p.id) ? incoming[p.id] : undefined;\n      const next = coerceIn(given ?? p.default, p.min, p.max);\n      if (p.rebuilds && Math.abs(this.value(p.id) - next) >= 1e-12) rebuild = true;\n      values.set(p.id, next);\n    }\n    if (rebuild) this.revision += 1;\n    this.publish();\n  }\n\n  resetAll(): void {\n    this.replaceAll({});\n  }\n\n  private publish(): void {\n    this.swipeDistanceDp = this.value(\"swipeDistance\");\n    this.swipeCommit = this.value(\"swipeCommit\");\n    this.cameraEase = this.value(\"cameraEase\");\n    this.foldEase = this.value(\"foldEase\");\n    this.coverZoom = this.value(\"coverZoom\");\n    this.openZoom = this.value(\"openZoom\");\n    this.verticalTravel = this.value(\"verticalTravel\");\n    this.rollAmount = this.value(\"rollAmount\");\n    this.spinSweep = this.value(\"spinSweep\");\n    this.moonSweep = this.value(\"moonSweep\");\n    this.glowStrength = this.value(\"glowStrength\");\n    this.starDensity = this.value(\"starDensity\");\n    this.starBrightness = this.value(\"starBrightness\");\n    this.moteDensity = this.value(\"moteDensity\");\n    this.beltDensity = this.value(\"beltDensity\");\n    this.eventRate = this.value(\"eventRate\");\n    this.eventLength = this.value(\"eventLength\");\n  }\n\n  // Scales a base count by a density multiplier. A multiplier of exactly 1 is\n  // guaranteed to return the base count unchanged: the scene is built from a\n  // seeded stream, so an off-by-one would silently reshuffle every body after it.\n  scaleCount(base: number, factor: number): number {\n    return factor === 1.0 ? base : Math.max(Math.trunc(base * factor), 0);\n  }\n}\n\nexport const Tuning = new TuningState();\n"}
