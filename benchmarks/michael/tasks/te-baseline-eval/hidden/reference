{"apps/taste-engine/eval/reports/ml-01-baselines.json":"{\n  \"baselines\": {\n    \"baseline-a\": {\n      \"coverage@10\": 0.3125,\n      \"ndcg@10\": 0.27545040722189046,\n      \"recall@20\": 0.5066666666666666\n    },\n    \"baseline-b\": {\n      \"coverage@10\": 0.775,\n      \"ndcg@10\": 0.23816280610093843,\n      \"recall@20\": 0.4533333333333333\n    }\n  },\n  \"comparison\": {\n    \"metric\": \"ndcg@10\",\n    \"p_value\": 1.0,\n    \"ties\": 1,\n    \"winner\": \"inconclusive\",\n    \"wins_a\": 5,\n    \"wins_b\": 4\n  },\n  \"cutoff\": 1721507819,\n  \"samples\": {\n    \"cold_start_viewers\": 1,\n    \"relevant_test_titles\": 43,\n    \"viewers_evaluated\": 10\n  }\n}\n","apps/taste-engine/src/taste_engine/eval/baselines.py":"\"\"\"Baseline A (popularity/genre) and Baseline B (liked-minus-disliked similarity).\"\"\"\n\nimport math\n\nfrom .split import is_disliked, is_liked, latest_by_title\n\n\ndef viewer_history(viewer, train):\n    \"\"\"The viewer's training evidence: {title: latest training event}.\"\"\"\n    return latest_by_title([event for event in train if event[\"viewer\"] == viewer])\n\n\ndef candidates(viewer, train, titles):\n    seen = viewer_history(viewer, train)\n    return [title for title in titles if title[\"id\"] not in seen]\n\n\ndef popularity_genre_rank(viewer, train, titles, k=20):\n    \"\"\"Rank unseen titles by liked-genre overlap, then household training popularity.\"\"\"\n    watchers = {}\n    for event in train:\n        watchers.setdefault(event[\"title\"], set()).add(event[\"viewer\"])\n    genres = {title[\"id\"]: title[\"genres\"] for title in titles}\n    liked_genres = set()\n    for title, event in viewer_history(viewer, train).items():\n        if is_liked(event[\"rating\"]):\n            liked_genres.update(genres.get(title, ()))\n    ranked = sorted(candidates(viewer, train, titles), key=lambda title: (\n        -len(liked_genres.intersection(title[\"genres\"])),\n        -len(watchers.get(title[\"id\"], ())), title[\"id\"]))\n    return [title[\"id\"] for title in ranked[:k]]\n\n\ndef _mean(vectors, width):\n    if not vectors:\n        return [0.0] * width\n    return [sum(vector[i] for vector in vectors) / len(vectors) for i in range(width)]\n\n\ndef cosine(left, right):\n    left_norm = math.sqrt(sum(value * value for value in left))\n    right_norm = math.sqrt(sum(value * value for value in right))\n    if left_norm == 0 or right_norm == 0:\n        return 0.0\n    return sum(a * b for a, b in zip(left, right)) / (left_norm * right_norm)\n\n\ndef similarity_rank(viewer, train, titles, k=20):\n    \"\"\"Rank unseen titles by cosine to mean(liked) - mean(disliked) embeddings.\"\"\"\n    embeddings = {title[\"id\"]: title[\"embedding\"] for title in titles}\n    width = len(titles[0][\"embedding\"]) if titles else 0\n    liked, disliked = [], []\n    for title, event in viewer_history(viewer, train).items():\n        if title not in embeddings:\n            continue\n        if is_liked(event[\"rating\"]):\n            liked.append(embeddings[title])\n        elif is_disliked(event[\"rating\"]):\n            disliked.append(embeddings[title])\n    profile = [a - b for a, b in zip(_mean(liked, width), _mean(disliked, width))]\n    ranked = sorted(candidates(viewer, train, titles), key=lambda title: (\n        -round(cosine(profile, title[\"embedding\"]), 9), title[\"id\"]))\n    return [title[\"id\"] for title in ranked[:k]]\n","apps/taste-engine/src/taste_engine/eval/benchmark.py":"\"\"\"ML-01 temporal-split benchmark: Baseline A vs Baseline B (see eval/SPEC.md).\n\nReproduce the committed report with one command from ``apps/taste-engine``:\n``PYTHONPATH=src python -m taste_engine.eval.benchmark``\n\"\"\"\n\nimport json\nimport math\nfrom pathlib import Path\n\nfrom . import baselines, metrics, split\n\nARMS = {\"baseline-a\": baselines.popularity_genre_rank, \"baseline-b\": baselines.similarity_rank}\nTIE_TOLERANCE = 1e-12\nALPHA = 0.05\nAPP = Path(__file__).resolve().parents[3]\nFIXTURE = APP / \"eval\" / \"fixtures\" / \"household.json\"\nREPORT = APP / \"eval\" / \"reports\" / \"ml-01-baselines.json\"\n\n\ndef sign_test(wins, losses):\n    \"\"\"Exact two-sided sign test p-value; ties are excluded before calling.\"\"\"\n    trials = wins + losses\n    if trials == 0:\n        return 1.0\n    tail = sum(math.comb(trials, i) for i in range(min(wins, losses) + 1))\n    return min(1.0, 2 * tail / 2 ** trials)\n\n\ndef _mean(values):\n    return sum(values) / len(values) if values else 0.0\n\n\ndef run_benchmark(events, titles, cutoff):\n    train, test = split.temporal_split(events, cutoff)\n    with_history = {event[\"viewer\"] for event in train}\n    evaluated = [viewer for viewer in sorted(test) if viewer in with_history]\n    per_viewer, report = {}, {}\n    for arm, rank in ARMS.items():\n        ndcg, recall, tops = [], [], []\n        for viewer in evaluated:\n            ranked = rank(viewer, train, titles, 20)\n            ndcg.append(metrics.ndcg_at_k(ranked, test[viewer], 10))\n            recall.append(metrics.recall_at_k(ranked, test[viewer], 20))\n            tops.append(ranked[:10])\n        per_viewer[arm] = ndcg\n        report[arm] = {\"ndcg@10\": _mean(ndcg), \"recall@20\": _mean(recall),\n                       \"coverage@10\": metrics.coverage(tops, len(titles))}\n    wins_a = wins_b = ties = 0\n    for a, b in zip(per_viewer[\"baseline-a\"], per_viewer[\"baseline-b\"]):\n        if a - b > TIE_TOLERANCE:\n            wins_a += 1\n        elif b - a > TIE_TOLERANCE:\n            wins_b += 1\n        else:\n            ties += 1\n    p_value = sign_test(wins_a, wins_b)\n    winner = \"inconclusive\"\n    if p_value < ALPHA:\n        winner = \"baseline-a\" if wins_a > wins_b else \"baseline-b\"\n    return {\n        \"cutoff\": cutoff,\n        \"samples\": {\"viewers_evaluated\": len(evaluated),\n                    \"cold_start_viewers\": len(test) - len(evaluated),\n                    \"relevant_test_titles\": sum(len(test[viewer]) for viewer in evaluated)},\n        \"baselines\": report,\n        \"comparison\": {\"metric\": \"ndcg@10\", \"wins_a\": wins_a, \"wins_b\": wins_b, \"ties\": ties,\n                       \"p_value\": p_value, \"winner\": winner},\n    }\n\n\ndef main():\n    data = json.loads(FIXTURE.read_text())\n    report = run_benchmark(data[\"events\"], data[\"titles\"], data[\"cutoff\"])\n    REPORT.write_text(json.dumps(report, indent=2, sort_keys=True) + \"\\n\")\n    print(json.dumps(report[\"comparison\"], sort_keys=True))\n\n\nif __name__ == \"__main__\":\n    main()\n","apps/taste-engine/src/taste_engine/eval/metrics.py":"\"\"\"Ranking metrics for the ML-01 offline benchmark (see eval/SPEC.md).\"\"\"\n\nimport math\n\n\ndef ndcg_at_k(ranked, relevant, k=10):\n    \"\"\"Binary-gain NDCG@k; the ideal DCG places min(|relevant|, k) hits first.\"\"\"\n    relevant = set(relevant)\n    if not relevant:\n        return 0.0\n    dcg = sum(1.0 / math.log2(position + 2)\n              for position, title in enumerate(ranked[:k]) if title in relevant)\n    ideal = sum(1.0 / math.log2(position + 2) for position in range(min(len(relevant), k)))\n    return dcg / ideal\n\n\ndef recall_at_k(ranked, relevant, k=20):\n    \"\"\"Share of all relevant titles retrieved in the top k (denominator is |relevant|).\"\"\"\n    relevant = set(relevant)\n    if not relevant:\n        return 0.0\n    return len(relevant.intersection(ranked[:k])) / len(relevant)\n\n\ndef coverage(top_lists, catalog_size):\n    \"\"\"Share of the catalog that appears in at least one top list.\"\"\"\n    if catalog_size <= 0:\n        return 0.0\n    shown = set()\n    for top in top_lists:\n        shown.update(top)\n    return len(shown) / catalog_size\n","apps/taste-engine/src/taste_engine/eval/split.py":"\"\"\"Temporal train/test split for the ML-01 offline benchmark (see eval/SPEC.md).\"\"\"\n\nLIKE_THRESHOLD = 3.5\nDISLIKE_THRESHOLD = 2.5\n\n\ndef is_liked(rating):\n    \"\"\"Unrated watches are implicit positives.\"\"\"\n    return rating is None or rating >= LIKE_THRESHOLD\n\n\ndef is_disliked(rating):\n    return rating is not None and rating <= DISLIKE_THRESHOLD\n\n\ndef latest_by_title(events):\n    \"\"\"Return {title: event} keeping each title's latest event (later input wins ties).\"\"\"\n    latest = {}\n    for event in events:\n        current = latest.get(event[\"title\"])\n        if current is None or event[\"ts\"] >= current[\"ts\"]:\n            latest[event[\"title\"]] = event\n    return latest\n\n\ndef temporal_split(events, cutoff):\n    \"\"\"Split events at ``cutoff`` without leaking future evidence into training.\n\n    Returns ``(train, test)``: ``train`` holds every event with ``ts < cutoff``;\n    ``test`` maps each viewer to the sorted ids of titles that are relevant in\n    the test period. Re-watches of a title the viewer already has in training\n    are dropped, and a title's test relevance comes from its latest test event.\n    \"\"\"\n    train = [event for event in events if event[\"ts\"] < cutoff]\n    seen = {}\n    for event in train:\n        seen.setdefault(event[\"viewer\"], set()).add(event[\"title\"])\n    later = {}\n    for event in events:\n        if event[\"ts\"] < cutoff or event[\"title\"] in seen.get(event[\"viewer\"], ()):\n            continue\n        later.setdefault(event[\"viewer\"], []).append(event)\n    test = {}\n    for viewer, viewer_events in later.items():\n        relevant = sorted(title for title, event in latest_by_title(viewer_events).items()\n                          if is_liked(event[\"rating\"]))\n        if relevant:\n            test[viewer] = relevant\n    return train, dict(sorted(test.items()))\n"}
