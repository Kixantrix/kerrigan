{"apps/control-plane/src/adoption/index.ts":"import { randomUUID } from \"node:crypto\";\n\nimport type { DiscoveredProject, HostAdapter } from \"../../../../packages/host-adapters/src/index.ts\";\n\nimport { NotFoundError } from \"../api/deploy.ts\";\nimport type { KirklandRepositories } from \"../db/repository.ts\";\nimport type { NewComponent, Service } from \"../db/schema.ts\";\nimport { desiredHash, type AdapterResolver } from \"../reconciler/index.ts\";\nimport { reconstructFromObserved, type ReadoptionWarning } from \"../readoption/index.ts\";\n\n/**\n * COMPOSE ADOPTION (T91 \u2014 the onboarding on-ramp for existing self-hosters).\n *\n * Re-adoption (T46) brings a Kirkland-*managed* stack back under a fresh control\n * plane. Adoption goes one step further: it brings a hand-run `docker-compose`\n * deployment that Kirkland NEVER created \u2014 no `dev.kirkland.managed` label \u2014 under\n * management, WITHOUT redeploying it. It:\n *   1. DISCOVERS the unmanaged compose projects on a host (via the adapter's\n *      {@link HostAdapter.discoverUnmanaged}), then\n *   2. REHYDRATES observed desired-state rows to MATCH what is running (images,\n *      volumes, published ports), and\n *   3. records a `succeeded` deployment whose `desiredHash` equals the rehydrated\n *      service's \u2014 so the reconciler sees desired == observed and does NOT\n *      redeploy (no downtime, no data loss).\n *\n * Honesty is the whole point: because there is no signed manifest, fidelity is\n * OBSERVED-ONLY and declared as such. What cannot be derived from a running stack\n * (the `connects-to` graph, volume\u2192component mounts, endpoint domains/TLS, secret\n * counts) is FLAGGED via warnings, never guessed. Authoring a signed manifest and\n * updating later restores full fidelity.\n *\n * The reconciler resolves a service's running stack by its `id`\n * (\u2192 `docker compose -p <id>`), so adoption sets `service.id` to the discovered\n * COMPOSE PROJECT NAME. Reconcile then observes the live stack as `running`, finds\n * a `succeeded` deployment whose hash matches, detects no drift, and does nothing.\n */\n\n/** How the desired state was reconstructed. Adoption is always observed-only. */\nexport type AdoptionMode = \"imported\";\n\nexport interface ImportInput {\n  /** The unmanaged compose project to adopt (a name from {@link AdoptionService.discoverImportable}). */\n  project: string;\n  /** Non-secret config to record on the adopted service. Defaults to `{}`. */\n  config?: Record<string, string>;\n}\n\nexport interface AdoptionResult {\n  service: Service;\n  deploymentId: string;\n  mode: AdoptionMode;\n  /** The discovered project the desired state was rehydrated from. */\n  project: DiscoveredProject;\n  /** Counts of rehydrated rows, for a legible summary. */\n  rehydrated: { components: number; volumes: number; endpoints: number };\n  /** Provenance + observability gaps that were flagged rather than guessed. */\n  warnings: ReadoptionWarning[];\n}\n\n/** Raised when a project cannot be adopted (already managed / bad target). */\nexport class AdoptionError extends Error {\n  readonly code: string;\n\n  constructor(message: string, code: string) {\n    super(message);\n    this.name = \"AdoptionError\";\n    this.code = code;\n  }\n}\n\nexport interface AdoptionDeps {\n  repos: KirklandRepositories;\n  resolveAdapter: AdapterResolver;\n}\n\n/**\n * Adopt an existing non-Kirkland compose deployment into the desired-state DB and\n * make it reconcile-clean. A control-plane operation (see routes / app).\n */\nexport class AdoptionService {\n  private readonly d: AdoptionDeps;\n\n  constructor(deps: AdoptionDeps) {\n    this.d = deps;\n  }\n\n  /** List hand-run (non-Kirkland) compose deployments eligible for adoption on a host. */\n  async discoverImportable(hostId: string): Promise<DiscoveredProject[]> {\n    const { adapter, host } = await this.resolve(hostId);\n    if (!adapter.discoverUnmanaged) {\n      throw new NotFoundError(`adapter ${adapter.kind} does not support compose adoption`);\n    }\n    return adapter.discoverUnmanaged(host.id);\n  }\n\n  /**\n   * Adopt one discovered unmanaged project: rehydrate observed desired state and\n   * record a `succeeded` deployment so the reconciler treats it as converged (NO\n   * redeploy). Fidelity is observed-only and declared via warnings.\n   */\n  async importProject(hostId: string, input: ImportInput): Promise<AdoptionResult> {\n    const { adapter, host } = await this.resolve(hostId);\n    if (!adapter.discoverUnmanaged) {\n      throw new NotFoundError(`adapter ${adapter.kind} does not support compose adoption`);\n    }\n    const projects = await adapter.discoverUnmanaged(host.id);\n    const project = projects.find((p) => p.project === input.project);\n    if (!project) {\n      // Either it does not exist, or it IS Kirkland-managed (use re-adoption).\n      throw new NotFoundError(\n        `no unmanaged compose project \"${input.project}\" discovered on host ${hostId}; ` +\n          \"if it is a Kirkland-managed stack, use re-adoption (/discover + /readopt) instead\",\n      );\n    }\n\n    // Adopting a project already tracked in desired state would double-manage it.\n    const existing = await this.d.repos.services.get(project.project);\n    if (existing) {\n      throw new AdoptionError(\n        `service \"${project.project}\" is already under Kirkland management`,\n        \"ALREADY_MANAGED\",\n      );\n    }\n\n    const warnings: ReadoptionWarning[] = [];\n    // Provenance FIRST: this stack was never Kirkland's. State it plainly so the\n    // adopter knows the desired state is a best-effort reconstruction.\n    warnings.push({\n      code: \"adopted-non-kirkland\",\n      message:\n        \"adopted from an existing non-Kirkland compose deployment; desired state is reconstructed \" +\n        \"from observation only. Author a signed manifest and update to gain full fidelity \" +\n        \"(connections, volume mounts, backup intent, secrets).\",\n    });\n    if (project.status !== \"running\") {\n      warnings.push({\n        code: \"project-not-running\",\n        message: `observed status is \"${project.status}\"; reconcile will converge it after adoption`,\n      });\n    }\n\n    // The reconciler keys a service's stack by its id (docker compose -p <id>);\n    // the discovered COMPOSE PROJECT NAME is that key. There is no catalog\n    // manifest, so the project name is also the manifest ref.\n    const serviceId = project.project;\n    const rows = reconstructFromObserved(project, serviceId);\n    warnings.push(...rows.warnings);\n\n    const service = await this.d.repos.services.insert({\n      id: serviceId,\n      manifestRef: serviceId,\n      version: \"imported\",\n      hostId: host.id,\n      config: JSON.stringify(input.config ?? {}),\n      status: project.status,\n      secretsCount: rows.secretsCount,\n    });\n    // Set the desired hash up front so reconcile compares equal without a write.\n    const hash = desiredHash(service);\n    await this.d.repos.services.update(service.id, { desiredHash: hash });\n    const persisted = { ...service, desiredHash: hash };\n\n    for (const component of rows.components) await this.d.repos.components.insert(component);\n    for (const volume of rows.volumes) await this.d.repos.volumes.insert(volume);\n    for (const endpoint of rows.endpoints) await this.d.repos.endpoints.insert(endpoint);\n\n    // The KEY to a no-op reconcile: a succeeded deployment whose desiredHash\n    // equals the service's, so detectDrift() returns null against a running stack.\n    const deployment = await this.d.repos.deployments.insert({\n      id: randomUUID(),\n      serviceId: service.id,\n      desiredHash: hash,\n      imageDigests: JSON.stringify(observedDigests(rows.components)),\n      state: \"succeeded\",\n    });\n\n    await this.d.repos.audit.append({\n      actor: \"system\",\n      action: \"service.import\",\n      plan: JSON.stringify({\n        target: service.id,\n        summary: `adopted non-Kirkland compose project ${project.project} on host ${host.id}: ${rows.components.length} component(s), no redeploy`,\n      }),\n      result: project.status,\n    });\n\n    return {\n      service: persisted,\n      deploymentId: deployment.id,\n      mode: \"imported\",\n      project,\n      rehydrated: {\n        components: rows.components.length,\n        volumes: rows.volumes.length,\n        endpoints: rows.endpoints.length,\n      },\n      warnings,\n    };\n  }\n\n  private async resolve(hostId: string): Promise<{ adapter: HostAdapter; host: { id: string } }> {\n    const host = await this.d.repos.hosts.get(hostId);\n    if (!host) throw new NotFoundError(`host ${hostId} not found`);\n    const adapter = this.d.resolveAdapter(host);\n    if (!adapter) throw new NotFoundError(`no adapter for host ${host.id} (${host.adapter})`);\n    return { adapter, host };\n  }\n}\n\n/** Map componentId \u2192 observed image digest (best-effort) for the deployment record. */\nfunction observedDigests(components: NewComponent[]): Record<string, string> {\n  const out: Record<string, string> = {};\n  for (const c of components) if (c.id && c.digest) out[c.id] = c.digest;\n  return out;\n}\n","packages/host-adapters/src/discovery.ts":"import type { ServiceStatus } from \"./index.ts\";\n\n/**\n * The label the compiler (`@kirkland/compiler` MANAGED_LABEL) stamps on every\n * Kirkland-managed network and backed-up volume. Mirrored here so this slice\n * has no compiler dependency.\n */\nconst MANAGED_LABEL = \"dev.kirkland.managed\";\n\n/**\n * Discovery (T46 \u2014 control-plane-loss recovery / SPOF removal).\n *\n * When the control plane is lost and reinstalled, the desired-state DB is gone\n * but the user's services keep running on the host. Discovery is how a FRESH\n * control plane finds an existing Kirkland-managed Compose deployment so it can\n * rehydrate desired state and reconcile WITHOUT redeploying (AT-9.3).\n *\n * Kirkland-managed compose resources carry the `dev.kirkland.managed: \"true\"`\n * label on their network (`kirkland-internal`) and on backed-up volumes (see\n * `@kirkland/compiler` MANAGED_LABEL and the manifest fixtures). Docker Compose\n * additionally stamps every resource it creates with `com.docker.compose.project`\n * / `com.docker.compose.service` / `com.docker.compose.volume`. Discovery keys\n * off BOTH: the managed label proves the project is ours, and the compose labels\n * name the project/services/volumes \u2014 enough to reconstruct desired state.\n *\n * This module is PURE parsing + shaping so it is fully unit-testable without a\n * Docker daemon; the {@link DockerComposeAdapter} wires the real `docker`\n * invocations to these parsers.\n */\n\n/** Docker compose project label \u2014 names the compose project a resource belongs to. */\nexport const COMPOSE_PROJECT_LABEL = \"com.docker.compose.project\";\n/** Docker compose service label \u2014 names the compose service a container implements. */\nexport const COMPOSE_SERVICE_LABEL = \"com.docker.compose.service\";\n/** Docker compose volume label \u2014 the short (unprefixed) volume name. */\nexport const COMPOSE_VOLUME_LABEL = \"com.docker.compose.volume\";\n/** Backup-intent label carried by managed volumes (mirrors the manifest). */\nexport const BACKUP_LABEL = \"dev.kirkland.backup\";\n\n/** A published port observed on a running managed container. */\nexport interface DiscoveredPort {\n  /** Host-side published port (null when the mapping could not be parsed). */\n  published: number | null;\n  /** Container-side target port. */\n  target: number | null;\n  /** Transport protocol (`tcp`/`udp`). */\n  protocol: string;\n  /** Host interface the port binds to, when present (e.g. `127.0.0.1`). */\n  hostIp?: string;\n}\n\n/** One observed compose service (container) of a managed project. */\nexport interface DiscoveredService {\n  /** Compose service name (`com.docker.compose.service`). */\n  service: string;\n  /** Container name reported by `docker ps`. */\n  containerName: string;\n  /** Image ref as running (may be digest-pinned). */\n  image: string;\n  /** Observed status mapped to the closed {@link ServiceStatus} set. */\n  status: ServiceStatus;\n  /** Raw docker state string (e.g. `running`, `exited`) for diagnostics. */\n  rawState: string;\n  /** Published ports, parsed from the `docker ps` ports column. */\n  ports: DiscoveredPort[];\n}\n\n/** One observed managed volume of a project. */\nexport interface DiscoveredVolume {\n  /** Full docker volume name (typically `<project>_<volume>`). */\n  name: string;\n  /** Short compose volume name (`com.docker.compose.volume`), when labelled. */\n  volume: string | null;\n  /** Whether the volume carries the `dev.kirkland.backup` intent label. */\n  backup: boolean;\n}\n\n/** A Kirkland-managed compose project discovered on a host. */\nexport interface DiscoveredProject {\n  /** Compose project name \u2014 equals `composeProjectName(manifest)` / `manifest.name`. */\n  project: string;\n  /** Observed services (containers) of the project. */\n  services: DiscoveredService[];\n  /** Observed managed volumes of the project. */\n  volumes: DiscoveredVolume[];\n  /** Aggregated status across the project's services. */\n  status: ServiceStatus;\n}\n\n/** Re-export the managed label so callers discover by the same constant the compiler stamps. */\nexport { MANAGED_LABEL };\n\n/** Parse a docker label string (`k=v,k2=v2`) into a map. Tolerates empty input. */\nexport function parseLabelString(labels: string | undefined): Record<string, string> {\n  const out: Record<string, string> = {};\n  if (!labels) return out;\n  for (const pair of labels.split(\",\")) {\n    const eq = pair.indexOf(\"=\");\n    if (eq <= 0) continue;\n    const key = pair.slice(0, eq).trim();\n    const value = pair.slice(eq + 1).trim();\n    if (key) out[key] = value;\n  }\n  return out;\n}\n\n/**\n * Extract the distinct compose project names from labelled `docker network ls`\n * or `docker volume ls --format {{json .}}` rows: a resource is ours when it\n * carries `dev.kirkland.managed=true`, and its `com.docker.compose.project`\n * label names the project. Rows without the managed label (belt-and-braces past\n * the `--filter`) or without a project label are ignored.\n */\nexport function parseManagedProjectNames(stdout: string): string[] {\n  const seen = new Set<string>();\n  for (const row of parseJsonRows<{ Labels?: string }>(stdout)) {\n    const labels = parseLabelString(row.Labels);\n    if (labels[MANAGED_LABEL] !== \"true\") continue;\n    const project = labels[COMPOSE_PROJECT_LABEL];\n    if (project) seen.add(project);\n  }\n  return [...seen].sort((a, b) => a.localeCompare(b));\n}\n\ninterface PsRow {\n  Names?: string;\n  Image?: string;\n  State?: string;\n  Status?: string;\n  Ports?: string;\n  Labels?: string;\n}\n\n/** Parse `docker ... --format {{json .}}` output: a JSON array OR newline-delimited objects. */\nfunction parseJsonRows<T>(stdout: string): T[] {\n  const trimmed = stdout.trim();\n  if (!trimmed) return [];\n  try {\n    const parsed = JSON.parse(trimmed) as T | T[];\n    return Array.isArray(parsed) ? parsed : [parsed];\n  } catch {\n    // fall through to NDJSON\n  }\n  const rows: T[] = [];\n  for (const line of trimmed.split(/\\r?\\n/).filter(Boolean)) {\n    try {\n      rows.push(JSON.parse(line) as T);\n    } catch {\n      // tolerate non-JSON noise\n    }\n  }\n  return rows;\n}\n\n/**\n * Parse a `docker ps` ports column into structured mappings. Examples:\n *   `127.0.0.1:8089->8080/tcp, :::8089->8080/tcp`\n *   `8080/tcp` (exposed but not published)\n * Only entries with a `->` publish mapping carry a host port; bare exposures\n * report `published: null`.\n */\nexport function parsePortsString(ports: string | undefined): DiscoveredPort[] {\n  if (!ports) return [];\n  const out: DiscoveredPort[] = [];\n  for (const raw of ports.split(\",\")) {\n    const entry = raw.trim();\n    if (!entry) continue;\n    const arrow = entry.indexOf(\"->\");\n    if (arrow === -1) {\n      // Exposed-only, e.g. \"8080/tcp\".\n      const [portPart, proto = \"tcp\"] = entry.split(\"/\");\n      const target = Number(portPart);\n      out.push({ published: null, target: Number.isFinite(target) ? target : null, protocol: proto });\n      continue;\n    }\n    const left = entry.slice(0, arrow); // host side, e.g. \"127.0.0.1:8089\"\n    const right = entry.slice(arrow + 2); // container side, e.g. \"8080/tcp\"\n    const [targetPart, proto = \"tcp\"] = right.split(\"/\");\n    const target = Number(targetPart);\n    const colon = left.lastIndexOf(\":\");\n    const hostIp = colon > 0 ? left.slice(0, colon) : undefined;\n    const publishedPart = colon >= 0 ? left.slice(colon + 1) : left;\n    const published = Number(publishedPart);\n    out.push({\n      published: Number.isFinite(published) ? published : null,\n      target: Number.isFinite(target) ? target : null,\n      protocol: proto,\n      ...(hostIp ? { hostIp } : {}),\n    });\n  }\n  return out;\n}\n\n/** Map a raw docker container state to the closed {@link ServiceStatus} set. */\nexport function containerStatus(state: string | undefined): ServiceStatus {\n  const s = (state ?? \"\").toLowerCase();\n  if (s.includes(\"running\")) return \"running\";\n  if (s.includes(\"exited\") || s.includes(\"dead\") || s.includes(\"created\")) return \"stopped\";\n  if (s.includes(\"restart\") || s.includes(\"paused\")) return \"degraded\";\n  return \"unknown\";\n}\n\n/** Aggregate per-service statuses into a single project status (matches the adapter's rule). */\nexport function aggregateStatus(states: ServiceStatus[]): ServiceStatus {\n  if (states.length === 0) return \"unknown\";\n  if (states.every((s) => s === \"running\")) return \"running\";\n  if (states.some((s) => s === \"degraded\")) return \"degraded\";\n  if (states.every((s) => s === \"stopped\")) return \"stopped\";\n  return \"degraded\";\n}\n\n/** Parse `docker ps --format {{json .}}` rows into {@link DiscoveredService}s (compose-service order). */\nexport function parseDiscoveredServices(stdout: string): DiscoveredService[] {\n  const services: DiscoveredService[] = [];\n  for (const row of parseJsonRows<PsRow>(stdout)) {\n    const labels = parseLabelString(row.Labels);\n    const service = labels[COMPOSE_SERVICE_LABEL];\n    if (!service) continue; // not a compose-managed container\n    services.push({\n      service,\n      containerName: row.Names ?? \"\",\n      image: row.Image ?? \"\",\n      status: containerStatus(row.State ?? row.Status),\n      rawState: row.State ?? \"\",\n      ports: parsePortsString(row.Ports),\n    });\n  }\n  services.sort((a, b) => a.service.localeCompare(b.service));\n  return services;\n}\n\ninterface VolumeRow {\n  Name?: string;\n  Labels?: string;\n}\n\n/** Parse `docker volume ls --format {{json .}}` rows into {@link DiscoveredVolume}s. */\nexport function parseDiscoveredVolumes(stdout: string): DiscoveredVolume[] {\n  const volumes: DiscoveredVolume[] = [];\n  for (const row of parseJsonRows<VolumeRow>(stdout)) {\n    if (!row.Name) continue;\n    const labels = parseLabelString(row.Labels);\n    volumes.push({\n      name: row.Name,\n      volume: labels[COMPOSE_VOLUME_LABEL] ?? null,\n      backup: labels[BACKUP_LABEL] === \"true\",\n    });\n  }\n  volumes.sort((a, b) => a.name.localeCompare(b.name));\n  return volumes;\n}\n\n/** One compose project as reported by `docker compose ls --format json`. */\nexport interface ComposeLsProject {\n  /** Compose project name. */\n  name: string;\n  /** Raw status string (e.g. `running(3)`, `exited(1)`). */\n  status: string;\n  /** Absolute paths of the project's compose config files, when reported. */\n  configFiles: string[];\n}\n\ninterface ComposeLsRow {\n  Name?: string;\n  Status?: string;\n  ConfigFiles?: string;\n}\n\n/**\n * Parse `docker compose ls --all --format json` rows into {@link ComposeLsProject}s.\n *\n * Where {@link parseManagedProjectNames} finds only Kirkland-managed projects\n * (via the `dev.kirkland.managed` label), this enumerates EVERY compose project\n * on the host \u2014 the basis for T91 adoption of hand-run `docker-compose`\n * deployments. `ConfigFiles` is a comma-separated path list in docker's output;\n * it is split into an array. Rows without a `Name` are ignored.\n */\nexport function parseComposeLsProjects(stdout: string): ComposeLsProject[] {\n  const out: ComposeLsProject[] = [];\n  for (const row of parseJsonRows<ComposeLsRow>(stdout)) {\n    if (!row.Name) continue;\n    out.push({\n      name: row.Name,\n      status: row.Status ?? \"\",\n      configFiles: (row.ConfigFiles ?? \"\")\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter(Boolean),\n    });\n  }\n  out.sort((a, b) => a.name.localeCompare(b.name));\n  return out;\n}\n\n/**\n * The compose project names on a host that are NOT Kirkland-managed \u2014 i.e.\n * hand-run deployments eligible for T91 adoption. `all` is the full project set\n * (from {@link parseComposeLsProjects}); `managed` is the Kirkland-managed set\n * (from {@link parseManagedProjectNames}). Deduplicated and sorted.\n */\nexport function unmanagedProjectNames(all: readonly string[], managed: readonly string[]): string[] {\n  const managedSet = new Set(managed);\n  return [...new Set(all)].filter((name) => !managedSet.has(name)).sort((a, b) => a.localeCompare(b));\n}\n\n/** Assemble a {@link DiscoveredProject} from parsed services + volumes. */\nexport function buildDiscoveredProject(\n  project: string,\n  services: DiscoveredService[],\n  volumes: DiscoveredVolume[],\n): DiscoveredProject {\n  return {\n    project,\n    services,\n    volumes,\n    status: aggregateStatus(services.map((s) => s.status)),\n  };\n}\n","packages/host-adapters/src/docker-compose-adapter.ts":"import {\n  buildDiscoveredProject,\n  parseComposeLsProjects,\n  parseDiscoveredServices,\n  parseDiscoveredVolumes,\n  parseManagedProjectNames,\n  unmanagedProjectNames,\n  COMPOSE_PROJECT_LABEL,\n  MANAGED_LABEL,\n  type DiscoveredProject,\n} from \"./discovery.ts\";\nimport type {\n  ChangePlan,\n  DeployResult,\n  HostAdapter,\n  HostCapabilities,\n  HostId,\n  Manifest,\n  ObservedState,\n  ServiceRef,\n  ServiceStatus,\n} from \"./index.ts\";\nimport type { ComposeTransport, ExecResult } from \"./transport.ts\";\nimport { aggregate, parsePs, projectName, toStatus } from \"./docker-compose-helpers.ts\";\n\n/** Single source of truth for the compose project a manifest deploys under. */\nexport { composeProjectName } from \"./docker-compose-helpers.ts\";\n\n/**\n * `DockerComposeAdapter` (T21): the MVP {@link HostAdapter}. It compiles a\n * manifest+config into compose/.env, stages the artifacts through a\n * {@link ComposeTransport}, and drives `docker compose`. Local and SSH share one\n * code path (R6 \u00a72.5); only the transport differs.\n *\n * (Slice note: manifest compilation, ingress, backup, export/import and secret\n * rotation are omitted; `deploy()` stages the manifest's rendered compose\n * document as-is.)\n */\nexport class DockerComposeAdapter implements HostAdapter {\n  readonly kind = \"docker-compose\";\n  private readonly transport: ComposeTransport;\n\n  constructor(transport: ComposeTransport) {\n    this.transport = transport;\n  }\n\n  async capabilities(_host: HostId): Promise<HostCapabilities> {\n    const res = await this.transport.docker([\"info\", \"--format\", \"{{.OSType}}/{{.Architecture}}\"]);\n    const arch = res.code === 0 ? res.stdout.trim().split(\"/\")[1] || \"unknown\" : \"unknown\";\n    return { engines: [\"docker\", \"compose\"], arch };\n  }\n\n  async plan(host: HostId, manifest: Manifest, _config: Record<string, string>): Promise<ChangePlan> {\n    const project = projectName(manifest);\n    const observed = await this.observedServices(project);\n    const firstDeploy = observed.size === 0;\n    const verb = firstDeploy ? \"deploy\" : \"update\";\n    const undo = firstDeploy\n      ? `docker --context ${this.transport.context} compose -p ${project} down`\n      : `docker --context ${this.transport.context} compose -p ${project} up --detach ` +\n        `(re-converge the previously-running definition; non-destructive \u2014 keeps volumes/data)`;\n    return {\n      summary: `${verb} ${project} -> ${host}: ${observed.size} observed service(s)`,\n      diff: [...observed.keys()].map((s) => `~ ${s}`),\n      estimatedCostDeltaMinor: null,\n      undo,\n    };\n  }\n\n  async deploy(host: HostId, manifest: Manifest, _config: Record<string, string>): Promise<DeployResult> {\n    const project = projectName(manifest);\n    await this.transport.stage(project, { compose: manifest.compose ?? \"\" });\n    await this.compose(project, [\"pull\", \"--quiet\"]);\n    const up = await this.compose(project, [\"up\", \"--detach\", \"--remove-orphans\", \"--wait\"]);\n    if (up.code !== 0) throw new Error(`compose up failed (${up.code}):\\n${up.stderr}`);\n    const state = await this.status(host, { id: project, manifestName: manifest.name });\n    return { service: { id: project, manifestName: manifest.name }, state };\n  }\n\n  async update(host: HostId, manifest: Manifest, config: Record<string, string>): Promise<DeployResult> {\n    // Compose up is declarative: it reconciles changed services in place.\n    return this.deploy(host, manifest, config);\n  }\n\n  async remove(_host: HostId, service: ServiceRef): Promise<void> {\n    const res = await this.compose(service.id, [\"down\", \"--remove-orphans\"]);\n    if (res.code !== 0) throw new Error(`compose down failed (${res.code}):\\n${res.stderr}`);\n  }\n\n  async rollback(_host: HostId, service: ServiceRef): Promise<DeployResult> {\n    // No prior-deployment store at the adapter layer; re-converge current state.\n    const up = await this.compose(service.id, [\"up\", \"--detach\", \"--remove-orphans\", \"--wait\"]);\n    if (up.code !== 0) throw new Error(`rollback up failed (${up.code}):\\n${up.stderr}`);\n    return { service, state: await this.statusByProject(service.id) };\n  }\n\n  status(_host: HostId, service: ServiceRef): Promise<ObservedState> {\n    return this.statusByProject(service.id);\n  }\n\n  /**\n   * DISCOVER Kirkland-managed compose deployments on this host (T46 \u2014 SPOF\n   * removal). A fresh control plane whose desired-state DB was lost calls this to\n   * find the projects still running here, so it can REHYDRATE desired state and\n   * reconcile without redeploying (AT-9.3). Read-only: it only queries docker\n   * (`network ls`, `volume ls`, `ps`) \u2014 it never stops, starts, or mutates any\n   * container, volume, or network.\n   *\n   * A project is ours when its network/volume carries `dev.kirkland.managed=true`\n   * (stamped by the compiler, {@link MANAGED_LABEL}); Compose's own\n   * `com.docker.compose.project`/`.service`/`.volume` labels then name the\n   * project, its services, and its volumes. Concrete-only (not on the\n   * `HostAdapter` interface's required surface) \u2014 declared there as optional so\n   * generic callers can feature-detect it.\n   */\n  async discover(_host: HostId): Promise<DiscoveredProject[]> {\n    const projects = await this.managedProjectNames();\n    const discovered: DiscoveredProject[] = [];\n    for (const project of projects) {\n      const [services, volumes] = await Promise.all([\n        this.discoverServices(project),\n        this.discoverVolumes(project),\n      ]);\n      discovered.push(buildDiscoveredProject(project, services, volumes));\n    }\n    discovered.sort((a, b) => a.project.localeCompare(b.project));\n    return discovered;\n  }\n\n  /**\n   * DISCOVER UNMANAGED compose deployments on this host (T91 \u2014 compose adoption).\n   *\n   * The onboarding on-ramp for existing self-hosters: enumerate every compose\n   * project on the host (`docker compose ls --all`) and return those NOT stamped\n   * with the Kirkland managed label \u2014 i.e. hand-run `docker-compose` deployments\n   * Kirkland did not create. Each is shaped into the same {@link DiscoveredProject}\n   * the re-adoption path consumes, so the control-plane AdoptionService can\n   * rehydrate observed desired state with honestly-declared (observed-only)\n   * fidelity. Projects `compose ls` reports but with no live containers are\n   * skipped \u2014 there is nothing to adopt. Concrete-only (not on the HostAdapter\n   * base type); generic callers feature-detect it.\n   */\n  async discoverUnmanaged(_host: HostId): Promise<DiscoveredProject[]> {\n    const [lsRes, managed] = await Promise.all([\n      this.transport.docker([\"compose\", \"ls\", \"--all\", \"--format\", \"json\"]),\n      this.managedProjectNames(),\n    ]);\n    const all = lsRes.code === 0 ? parseComposeLsProjects(lsRes.stdout).map((p) => p.name) : [];\n    const names = unmanagedProjectNames(all, managed);\n    const discovered: DiscoveredProject[] = [];\n    for (const project of names) {\n      const [services, volumes] = await Promise.all([\n        this.discoverServices(project),\n        this.discoverVolumes(project),\n      ]);\n      if (services.length === 0) continue;\n      discovered.push(buildDiscoveredProject(project, services, volumes));\n    }\n    discovered.sort((a, b) => a.project.localeCompare(b.project));\n    return discovered;\n  }\n\n  /** Union of managed compose project names, found via labelled networks + volumes. */\n  private async managedProjectNames(): Promise<string[]> {\n    const filter = `label=${MANAGED_LABEL}=true`;\n    const [nets, vols] = await Promise.all([\n      this.transport.docker([\"network\", \"ls\", \"--filter\", filter, \"--format\", \"{{json .}}\"]),\n      this.transport.docker([\"volume\", \"ls\", \"--filter\", filter, \"--format\", \"{{json .}}\"]),\n    ]);\n    const names = new Set<string>();\n    if (nets.code === 0) for (const p of parseManagedProjectNames(nets.stdout)) names.add(p);\n    if (vols.code === 0) for (const p of parseManagedProjectNames(vols.stdout)) names.add(p);\n    return [...names];\n  }\n\n  /** Observed containers of a managed project (via `docker ps`, all states). */\n  private async discoverServices(project: string): Promise<DiscoveredProject[\"services\"]> {\n    const res = await this.transport.docker([\n      \"ps\",\n      \"--all\",\n      \"--filter\",\n      `label=${COMPOSE_PROJECT_LABEL}=${project}`,\n      \"--format\",\n      \"{{json .}}\",\n    ]);\n    return res.code === 0 ? parseDiscoveredServices(res.stdout) : [];\n  }\n\n  /** Observed volumes of a managed project (via `docker volume ls`). */\n  private async discoverVolumes(project: string): Promise<DiscoveredProject[\"volumes\"]> {\n    const res = await this.transport.docker([\n      \"volume\",\n      \"ls\",\n      \"--filter\",\n      `label=${COMPOSE_PROJECT_LABEL}=${project}`,\n      \"--format\",\n      \"{{json .}}\",\n    ]);\n    return res.code === 0 ? parseDiscoveredVolumes(res.stdout) : [];\n  }\n\n  async logs(_host: HostId, service: ServiceRef): Promise<string> {\n    const res = await this.compose(service.id, [\"logs\", \"--no-color\", \"--tail\", \"200\"]);\n    return res.stdout;\n  }\n\n  private compose(project: string, args: string[]): Promise<ExecResult> {\n    const dir = this.transport.projectDir(project);\n    return this.transport.docker([\"compose\", \"--project-directory\", dir, \"-p\", project, ...args]);\n  }\n\n  private async observedServices(project: string): Promise<Map<string, ServiceStatus>> {\n    const res = await this.compose(project, [\"ps\", \"--all\", \"--format\", \"json\"]);\n    const map = new Map<string, ServiceStatus>();\n    if (res.code !== 0) return map;\n    for (const row of parsePs(res.stdout)) {\n      if (row.Service) map.set(row.Service, toStatus(row.State));\n    }\n    return map;\n  }\n\n  private async statusByProject(project: string): Promise<ObservedState> {\n    const components = Object.fromEntries(await this.observedServices(project));\n    return { status: aggregate(Object.values(components)), components };\n  }\n}\n","packages/host-adapters/src/index.ts":"/**\n * The `HostAdapter` is the hexagonal seam between Kirkland's provider-neutral\n * control plane and a concrete execution target (local Docker, SSH Linux VM,\n * Azure VM, future Go agent). See ADR-0001/0003 and architecture.md \u00a73.\n *\n * Every verb that mutates state MUST be expressible as a `plan()` dry-run first\n * (ADR-0012).\n *\n * (Slice note: backup/export/rotate verbs and their modules are omitted here;\n * `Manifest` is the minimal subset of `@kirkland/manifest-schema` this slice\n * needs.)\n */\n\n/** Minimal subset of the signed app manifest (`@kirkland/manifest-schema`). */\nexport interface Manifest {\n  /** App name; also the compose project it deploys under. */\n  name: string;\n  version: string;\n  /** Rendered compose document (the full stack compiles this from the manifest). */\n  compose?: string;\n}\n\nexport type HostId = string;\n\nexport interface HostCapabilities {\n  /** e.g. \"docker\", \"compose\"; used to gate which manifests can deploy here. */\n  engines: string[];\n  arch: string;\n}\n\nexport interface ServiceRef {\n  /** Stable id of a deployed service instance. */\n  id: string;\n  manifestName: string;\n}\n\n/** A single proposed change, surfaced in a preview before any apply (ADR-0012). */\nexport interface ChangePlan {\n  summary: string;\n  /** Human-readable diff of desired vs observed. */\n  diff: string[];\n  /** Best-effort estimated monthly cost delta in minor units; null if unknown. */\n  estimatedCostDeltaMinor: number | null;\n  /** How to undo this change if applied. */\n  undo: string;\n}\n\nexport type ServiceStatus = \"running\" | \"stopped\" | \"degraded\" | \"unknown\";\n\nexport interface ObservedState {\n  status: ServiceStatus;\n  components: Record<string, ServiceStatus>;\n}\n\nexport interface DeployResult {\n  service: ServiceRef;\n  state: ObservedState;\n}\n\nexport interface HostAdapter {\n  readonly kind: string;\n\n  /** What this host can run; control plane uses it to validate placement. */\n  capabilities(host: HostId): Promise<HostCapabilities>;\n\n  /** Dry-run: compute the change without applying it. Mandatory (ADR-0012). */\n  plan(host: HostId, manifest: Manifest, config: Record<string, string>): Promise<ChangePlan>;\n\n  deploy(host: HostId, manifest: Manifest, config: Record<string, string>): Promise<DeployResult>;\n  update(host: HostId, manifest: Manifest, config: Record<string, string>): Promise<DeployResult>;\n  remove(host: HostId, service: ServiceRef): Promise<void>;\n  rollback(host: HostId, service: ServiceRef): Promise<DeployResult>;\n  status(host: HostId, service: ServiceRef): Promise<ObservedState>;\n  logs(host: HostId, service: ServiceRef): Promise<string>;\n\n  /**\n   * Optional (T46): DISCOVER Kirkland-managed deployments already running on the\n   * host. A fresh control plane that lost its desired-state DB uses this to\n   * rehydrate desired state and reconcile without redeploying (AT-9.3). Optional\n   * so existing adapters/implementers stay valid; the compose adapter provides it.\n   */\n  discover?(host: HostId): Promise<import(\"./discovery.ts\").DiscoveredProject[]>;\n\n  /**\n   * Optional (T91): DISCOVER UNMANAGED compose deployments already running on the\n   * host \u2014 hand-run `docker-compose` stacks Kirkland did not create (no\n   * `dev.kirkland.managed` label). The control plane uses this to ADOPT an\n   * existing self-hosted deployment under management with honestly-declared\n   * (observed-only) fidelity, without redeploying. Optional so existing\n   * adapters/implementers stay valid; the compose adapter provides it.\n   */\n  discoverUnmanaged?(host: HostId): Promise<import(\"./discovery.ts\").DiscoveredProject[]>;\n}\n\n/** Names of the mutating verbs that MUST be routed through `plan()` first. */\nexport const MUTATING_VERBS = [\"deploy\", \"update\", \"remove\", \"rollback\"] as const;\nexport type MutatingVerb = (typeof MUTATING_VERBS)[number];\n\nexport { DockerComposeAdapter, composeProjectName } from \"./docker-compose-adapter.ts\";\nexport {\n  parseLabelString,\n  parseManagedProjectNames,\n  parseComposeLsProjects,\n  unmanagedProjectNames,\n  parseDiscoveredServices,\n  parseDiscoveredVolumes,\n  parsePortsString,\n  containerStatus,\n  aggregateStatus,\n  buildDiscoveredProject,\n  COMPOSE_PROJECT_LABEL,\n  COMPOSE_SERVICE_LABEL,\n  COMPOSE_VOLUME_LABEL,\n  BACKUP_LABEL,\n  MANAGED_LABEL,\n  type DiscoveredProject,\n  type DiscoveredService,\n  type DiscoveredVolume,\n  type DiscoveredPort,\n  type ComposeLsProject,\n} from \"./discovery.ts\";\nexport type { ComposeTransport, ExecResult, ProjectFiles } from \"./transport.ts\";\n"}
