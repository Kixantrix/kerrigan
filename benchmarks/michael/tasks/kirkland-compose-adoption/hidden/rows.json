[
 {
  "original_id": "parseComposeLsProjects reads a JSON array: skips nameless rows, splits/trims ConfigFiles, sorts by name",
  "group": "parse",
  "probe": {
   "scenario": "parseLsArray"
  },
  "clauses": [
   [
    "path_match",
    [
     "projects"
    ],
    [
     {
      "name": "alpha-wiki",
      "status": "exited(2)",
      "configFiles": [
       "/srv/wiki/docker-compose.yml"
      ]
     },
     {
      "name": "mid-dns",
      "status": "",
      "configFiles": []
     },
     {
      "name": "zeta-media",
      "status": "running(3)",
      "configFiles": [
       "/srv/zeta/compose.yaml",
       "/srv/zeta/compose.override.yaml"
      ]
     }
    ]
   ]
  ]
 },
