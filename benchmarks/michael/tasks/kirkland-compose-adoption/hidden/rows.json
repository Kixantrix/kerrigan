 {
  "original_id": "importProject records an observed-only service keyed by the compose project with a consistent desired hash",
  "group": "import",
  "probe": {
   "scenario": "importRunning"
  },
  "clauses": [
   [
    "path_equal",
    [
     "mode"
    ],
    "imported"
   ],
   [
    "path_equal",
    [
     "service"
    ],
    {
     "id": "photos",
     "manifestRef": "photos",
     "version": "imported",
     "hostId": "h-edge",
     "config": "{\"TZ\":\"UTC\"}",
     "status": "running",
     "secretsCount": 0
    }
   ],
   [
    "path_equal",
    [
     "stored"
    ],
    {
     "id": "photos",
     "manifestRef": "photos",
     "version": "imported",
     "config": "{\"TZ\":\"UTC\"}",
     "status": "running"
    }
   ],
   [
    "path_true",
    [
     "hashConsistent"
    ]
   ],
   [
    "path_equal",
    [
     "projectName"
    ],
    "photos"
   ]
  ]
 },
